+            className="tl-input tl-decline__text"
+            data-testid="detail-redo-note-input"
+            rows={3}
+            maxLength={LIMITS.textLength}
+            autoFocus
+            value={open.text}
+            onChange={(event) => setEditing({ item: item.id, text: event.target.value })}
