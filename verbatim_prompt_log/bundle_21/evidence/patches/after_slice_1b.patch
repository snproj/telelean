@@ -0,0 +1,77 @@
+/**
+ * Spec v4 slice 1b (docs/slice1-plan.md 2.5): the arrow messages' hand-written validators (addArrows, removeArrows,
+ * setFromNothing, claimPending, moveCards): what they accept, what they refuse, and that nothing extra survives.
+ */
+import { describe, expect, it } from 'vitest';
+import { LIMITS, parseWebviewToHost, webviewMessage } from '../src/index.js';
+
+const parse = (type: string, payload: unknown) => parseWebviewToHost({ v: 1, type, payload });
+
+describe('arrow messages (webview -> host)', () => {
+  it('accepts each message, with and without the optional fields, and returns it unchanged', () => {
+    const messages = [
+      webviewMessage('addArrows', { target: 'g', sources: ['a'] }),
+      webviewMessage('addArrows', { target: 'g', sources: ['a', 'b'], confirmed: true, requestId: 'r1' }),
+      webviewMessage('removeArrows', { arrows: [{ source: 'a', target: 'g' }] }),
+      webviewMessage('removeArrows', { arrows: [{ source: 'a', target: 'g' }, { source: 'b', target: 'g' }, { source: 'a', target: 'h' }], confirmed: false, requestId: 'r2' }),
+      webviewMessage('setFromNothing', { id: 'g', on: true }),
+      webviewMessage('setFromNothing', { id: 'a', on: false, confirmed: true, requestId: 'r3' }),
+      webviewMessage('claimPending', { id: 'g' }),
+      webviewMessage('claimPending', { id: 'g', requestId: 'r4' }),
+      webviewMessage('moveCards', { positions: { g: { x: 10.5, y: -3 } } }),
+      webviewMessage('moveCards', { positions: { g: { x: LIMITS.coordinate, y: -LIMITS.coordinate }, h: { x: 0, y: 0 } }, requestId: 'r5' }),
+    ];
+    for (const message of messages) expect(parseWebviewToHost(JSON.parse(JSON.stringify(message)))).toEqual({ ok: true, value: message });
+  });
+
+  it('refuses malformed payloads', () => {
+    const bad: Array<[string, unknown]> = [
+      ['addArrows', { target: 'g', sources: [] }],
+      ['addArrows', { target: 'g', sources: ['g'] }],
+      ['addArrows', { target: 'g', sources: ['a', 'a'] }],
+      ['addArrows', { target: '', sources: ['a'] }],
+      ['addArrows', { target: 'g', sources: 'a' }],
+      ['addArrows', { target: 'g', sources: [7] }],
+      ['addArrows', { target: 'g', sources: ['x'.repeat(LIMITS.idLength + 1)] }],
+      ['addArrows', { target: 'g', sources: Array.from({ length: LIMITS.listLength + 1 }, (_, i) => `n${i}`) }],
+      ['addArrows', { target: 'g', sources: ['a'], confirmed: 'yes' }],
+      ['addArrows', { target: 'g', sources: ['a'], requestId: 'not valid!' }],
+      ['removeArrows', { arrows: [] }],
+      ['removeArrows', { arrows: [{ source: 'a', target: 'a' }] }],
+      ['removeArrows', { arrows: [{ source: 'a', target: 'g' }, { source: 'a', target: 'g' }] }],
+      ['removeArrows', { arrows: [{ source: 'a' }] }],
+      ['removeArrows', { arrows: [['a', 'g']] }],
+      ['removeArrows', { arrows: Array.from({ length: LIMITS.listLength + 1 }, (_, i) => ({ source: `s${i}`, target: 'g' })) }],
+      ['setFromNothing', { id: 'g' }],
+      ['setFromNothing', { id: 'g', on: 'true' }],
+      ['setFromNothing', { id: '', on: true }],
+      ['claimPending', { id: 3 }],
+      ['claimPending', {}],
+      ['moveCards', { positions: {} }],
+      ['moveCards', { positions: [] }],
+      ['moveCards', { positions: { g: { x: 1 } } }],
+      ['moveCards', { positions: { g: { x: '1', y: 2 } } }],
+      ['moveCards', { positions: { g: { x: Number.POSITIVE_INFINITY, y: 2 } } }],
+      ['moveCards', { positions: { g: { x: LIMITS.coordinate + 1, y: 2 } } }],
+      ['moveCards', { positions: { g: [1, 2] } }],
+      ['moveCards', { positions: JSON.parse('{"__proto__": {"x": 1, "y": 2}}') as unknown }],
+      ['moveCards', { positions: { ['x'.repeat(LIMITS.idLength + 1)]: { x: 1, y: 2 } } }],
+    ];
+    for (const [type, payload] of bad) {
+      const result = parse(type, payload);
+      expect(result.ok, `${type} ${JSON.stringify(payload)}`).toBe(false);
+    }
+    // NaN does not survive JSON, but a structured clone keeps it.
+    expect(parse('moveCards', { positions: { g: { x: Number.NaN, y: 2 } } }).ok).toBe(false);
+  });
+
+  it('drops unknown properties (in the payload, in each arrow and in each position)', () => {
+    expect(parse('addArrows', { target: 'g', sources: ['a'], extra: 1 })).toEqual({ ok: true, value: webviewMessage('addArrows', { target: 'g', sources: ['a'] }) });
+    expect(parse('removeArrows', { arrows: [{ source: 'a', target: 'g', kind: 'premise' }] })).toEqual({
+      ok: true,
+      value: webviewMessage('removeArrows', { arrows: [{ source: 'a', target: 'g' }] }),
+    });
+    expect(parse('moveCards', { positions: { g: { x: 1, y: 2, z: 3 } } })).toEqual({ ok: true, value: webviewMessage('moveCards', { positions: { g: { x: 1, y: 2 } } }) });
+    expect(parse('claimPending', { id: 'g', on: true })).toEqual({ ok: true, value: webviewMessage('claimPending', { id: 'g' }) });
+  });
+});
diff --git a/packages/runner/test/workspace/arrows.test.ts b/packages/runner/test/workspace/arrows.test.ts
new file mode 100644
index 0000000..214fdc8
--- /dev/null
+++ b/packages/runner/test/workspace/arrows.test.ts
@@ -0,0 +1,112 @@
+/**
+ * Spec v4 slice 1b with the real core: arrows as board edits on a scratch copy of mental_model/ in a scratch git
+ * repository (Lean off). Each action is planned in core and applied, recorded and undone by the workspace like every
+ * other board edit: one Undo step each, restoring the files exactly, and one History entry under its own action kind
+ * (move-cards is layout only, like reorder: undoable, but not snapshotted on its own). A refusal changes nothing.
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+
+import { createModelWorkspace, fsEditApplier, fsTextSource, type ModelWorkspace } from '../../src/workspace/index.js';
+import { cleanup, copyMentalModel, makeTempDir, read, snapshotTree, userGit } from './helpers.js';
+
+const MAIN = 'Model/Spyro/Main.lean';
+const LAYOUT = '.telelean/subjects/Spyro/layout.json';
+const GOAL = 'cynder-not-good';
+
+describe('arrows as board edits with the real core (slice 1b)', () => {
+  let tmp: string;
+  let root: string;
+  let ws: ModelWorkspace;
+  let original: Record<string, string>;
+  beforeAll(async () => {
+    tmp = makeTempDir('arrows');
+    root = copyMentalModel(tmp);
+    userGit(root, 'init', '-q');
+    ws = createModelWorkspace({ root, text: fsTextSource(root), applier: fsEditApplier(root), semantic: { enabled: false }, now: () => new Date('2026-11-19T10:00:00Z') });
+    await ws.load();
+    original = snapshotTree(root);
+  });
+  afterAll(() => {
+    ws?.dispose();
+    cleanup(tmp);
+  });
+
+  const node = (id: string) => ws.graph('Spyro').nodes.find((n) => n.id === id);
+  const undoExactly = async () => {
+    const before = snapshotTree(root);
+    const undo = await ws.undo('Spyro');
+    expect(undo.ok, JSON.stringify(undo)).toBe(true);
+    return before;
+  };
+
+  it('remove-arrows, then add-arrows: each one step, undone exactly', async () => {
+    const removed = await ws.perform({ kind: 'remove-arrows', arrows: [{ source: 'pg-no-dark-past', target: GOAL }] });
+    expect(removed, JSON.stringify(removed)).toMatchObject({ ok: true, undoable: true });
+    expect(removed.ok && removed.label).toMatch(/^Remove arrow: PG games cannot have characters with .*→ Cynder would not be a good addition/);
+    expect(read(root, MAIN)).toContain('premises: cynder-dark-past, new-spyro-pg\n');
+    expect(node(GOAL)?.premises).toEqual(['cynder-dark-past', 'new-spyro-pg']);
+    expect((await ws.workspaceState('Spyro')).undo).toBe(removed.ok ? removed.label : '');
+
+    const added = await ws.perform({ kind: 'add-arrows', target: GOAL, sources: ['pg-no-dark-past'] });
+    expect(added, JSON.stringify(added)).toMatchObject({ ok: true });
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+
+    await undoExactly();
+    expect(read(root, MAIN)).toContain('premises: cynder-dark-past, new-spyro-pg\n');
+    await undoExactly();
+    expect(snapshotTree(root)[MAIN]).toBe(original[MAIN]);
+  });
+
+  it('set-from-nothing on an axiom makes it a proposition (type and layout in one step); undo restores both', async () => {
+    const outcome = await ws.perform({ kind: 'set-from-nothing', id: 'new-spyro-pg', on: true });
+    expect(outcome, JSON.stringify(outcome)).toMatchObject({ ok: true, label: 'Follows from nothing: The new Spyro game is PG' });
+    expect(read(root, MAIN)).toContain('id: new-spyro-pg\ntype: PROPOSITION\nnatural_name: The new Spyro game is PG\nrationale: known from gaming news\nsource: reported\nfollows_from: nothing\n');
+    expect(node('new-spyro-pg')).toMatchObject({ type: 'PROPOSITION', fromNothing: true });
+    expect(JSON.parse(read(root, LAYOUT)).columns.PROPOSITION).toContain('new-spyro-pg');
+    await undoExactly();
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+    expect(read(root, LAYOUT)).toBe(original[LAYOUT]);
+    expect(node('new-spyro-pg')?.type).toBe('AXIOM');
+  });
+
+  it('claim-pending adds the axiom .holds ("Mark pending"); undo removes it', async () => {
+    const outcome = await ws.perform({ kind: 'claim-pending', id: GOAL });
+    expect(outcome, JSON.stringify(outcome)).toMatchObject({ ok: true, label: 'Mark pending: Cynder would not be a good addition to the new Spyro game' });
+    expect(read(root, MAIN)).toContain('abbrev cynder_not_good : Prop := ¬ GoodAddition cynder newSpyro\naxiom cynder_not_good.holds : cynder_not_good\n');
+    await undoExactly();
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+  });
+
+  it('move-cards writes only the layout (one Undo step, no snapshot of its own)', async () => {
+    const outcome = await ws.perform({ kind: 'move-cards', positions: { [GOAL]: { x: 120, y: -40 } } });
+    expect(outcome, JSON.stringify(outcome)).toMatchObject({ ok: true, label: 'Move: Cynder would not be a good addition to the new Spyro game', undoable: true });
+    expect(JSON.parse(read(root, LAYOUT)).positions).toEqual({ [GOAL]: { x: 120, y: -40 } });
+    expect(ws.graph('Spyro').positions).toEqual({ [GOAL]: { x: 120, y: -40 } });
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+    await undoExactly();
+    expect(read(root, LAYOUT)).toBe(original[LAYOUT]);
+    expect(ws.graph('Spyro')).not.toHaveProperty('positions');
+  });
+
+  it('a refusal (a cycle) changes nothing and records nothing', async () => {
+    const before = snapshotTree(root);
+    const undoBefore = (await ws.workspaceState('Spyro')).undo;
+    const outcome = await ws.perform({ kind: 'add-arrows', target: 'pg-no-dark-past', sources: [GOAL] });
+    expect(outcome).toEqual({
+      ok: false,
+      code: 'invalid',
+      error: 'This arrow would make a cycle: Cynder would not be a good addition to … → PG games cannot have characters with da… → Cynder would not be a good addition to ….',
+    });
+    expect(snapshotTree(root)).toEqual(before);
+    expect((await ws.workspaceState('Spyro')).undo).toBe(undoBefore);
+  });
+
+  it('records each action in the history under its own kind', async () => {
+    const listing = await ws.listHistory('Spyro');
+    const actions = listing.entries.map((e) => e.action);
+    for (const kind of ['remove-arrows', 'add-arrows', 'set-from-nothing', 'claim-pending'] as const) expect(actions, kind).toContain(kind);
+    expect(actions).not.toContain('move-cards');
+    expect(actions).not.toContain('manual');
+    expect(listing.entries.find((e) => e.action === 'claim-pending')?.label).toBe('Mark pending: Cynder would not be a good addition to the new Spyro game');
+  });
+});
diff --git a/packages/webview/test/unit/store-arrows.test.ts b/packages/webview/test/unit/store-arrows.test.ts
new file mode 100644
index 0000000..05ad97b
--- /dev/null
+++ b/packages/webview/test/unit/store-arrows.test.ts
@@ -0,0 +1,338 @@
+/**
+ * Spec v4 slice 1b: the board store's arrow actions (addArrows, removeArrows, setFromNothing, claimPending,
+ * moveCards), each one message (one Undo step on the host), applied optimistically and rolled back on a refusal; the
+ * arrows dialog that states an impact first (an axiom becoming a proposition, AR-6; a used arrow, A16) or after the
+ * host's needs-confirmation; the arrow selection (selectArrow, selectIncomingArrows, Esc, Delete); "Move to axioms".
+ */
+import { buildGraph, hostMessage, spyroGraph, spyroProvedGraph, type ActionOutcome, type TlGraph, type WebviewToHostMessage } from '@telelean/core';
+import { describe, expect, it } from 'vitest';
+import { ARROW_TEXTS, createBoardStore, type StoreOptions } from '../../src/state/store';
+import { mapNode } from '../shared/graphs';
+import { normativeProposal } from '../shared/runs';
+
+const GOAL = 'cynder-not-good';
+const DARK = 'cynder-dark-past';
+const PG = 'new-spyro-pg';
+const RULE = 'pg-no-dark-past';
+
+/** spyroGraph with the goal's arrows replaced (edges rebuilt from the premises). */
+function withPremises(premises: string[], base: TlGraph = spyroGraph(), patch: Record<string, unknown> = {}): TlGraph {
+  const nodes = base.nodes.map((n) => (n.id === GOAL ? { ...n, premises, ...patch } : n));
+  return { ...buildGraph({ subject: base.subject, version: base.version, nodes, vocabulary: base.vocabulary, diagnostics: base.diagnostics }), semantic: base.semantic };
+}
+
+function setup(graph: TlGraph = spyroGraph(), options: StoreOptions = {}) {
+  const sent: WebviewToHostMessage[] = [];
+  const store = createBoardStore((m) => sent.push(m), { today: () => '2026-11-19', setTimer: () => undefined, ...options });
+  store.getState().applyGraph(graph);
+  const state = () => store.getState();
+  const result = (requestId: string, outcome: ActionOutcome) => state().receive(hostMessage('actionResult', { requestId, outcome }));
+  const last = () => sent.at(-1);
+  const ofType = (type: string) => sent.filter((m) => m.type === type);
+  const requestIdOf = (m: WebviewToHostMessage | undefined) => (m?.payload as { requestId?: string } | undefined)?.requestId ?? '';
+  return { store, sent, state, result, last, ofType, requestIdOf };
+}
+
+const refused = (code: Extract<ActionOutcome, { ok: false }>['code'], error: string, dependents?: string[]): ActionOutcome => ({ ok: false, code, error, ...(dependents ? { dependents } : {}) });
+const premiseEdges = (graph: { edges: readonly { type: string; source: string; target: string }[] }, target: string) =>
+  graph.edges.filter((e) => e.type === 'premise' && e.target === target).map((e) => e.source);
+
+describe('addArrows (AR-1)', () => {
+  it('into a proposition: optimistic arrows, one addArrows message; a refusal (a cycle) rolls back with its message', () => {
+    const { state, last, result, requestIdOf } = setup(withPremises([DARK]));
+    expect(state().addArrows(GOAL, [PG, DARK, PG])).toBe(true);
+    expect(last()).toEqual({ v: 1, type: 'addArrows', payload: { target: GOAL, sources: [PG, DARK], requestId: 'r1' } });
+    expect(state().nodes[GOAL]?.premises).toEqual([DARK, PG]);
