diff --git a/packages/core/src/review/reconcile.ts b/packages/core/src/review/reconcile.ts
new file mode 100644
index 0000000..d1d949d
--- /dev/null
+++ b/packages/core/src/review/reconcile.ts
@@ -0,0 +1,440 @@
+/**
+ * Slice 2a2 (docs/slice2-plan.md section 3.5): a stage judgement applied to the records, when a queue ends and in every
+ * `judge-apply` write (§2.6). The rules, in order:
+ *  - a new key: a new record, in review, rev 1, its id from the run id and the key (AF7), `origin` and `partOf` from
+ *    its draft, never changed later;
+ *  - F5 (only when a queue ends, `queueSteps`, AF1): a Shaky or to-be-redone item with a draft, in an inference whose
+ *    Submit step ended in that queue, is back in review, `redo` and its decline dropped, "updated" only when its content
+ *    key changed, "no alternative found" when that step's finish said so;
+ *  - AF1: a record declined by Reject or a plain decline, or to be redone with its content taken out, keeps its status,
+ *    key and rev when its draft is B's version (`asInBase`); any other draft is a new proposal: back in review, "updated"
+ *    when its key changed (DO-1's reworded repeat; a withdrawn item's later proposal);
+ *  - the same content key: unchanged, but RV-11: an accepted Result whose verdict or Rests on changed is treated as a
+ *    changed key ("with its result hidden again");
+ *  - a changed content key: the old version into `versions`, rev + 1, in review, "updated"; an accepted one leaves
+ *    accepted with its accepted dependents (RV-5), each "updated", with no confirmation, reported as an event;
+ *  - a record with no draft: expected when declined (Reject, plain) or to be redone with its content out; `withdrawn`
+ *    when Shaky or to be redone and its inference's Submit step ended in the queue (D2-17); else the problem
+ *    "“‹item›” disappeared, and no decision removed it" (Apply is disabled);
+ *  - D2-17: when a later step for T ends with a new Result version, T's premise drafts of earlier steps that are not
+ *    accepted are withdrawn, and their drafts leave `premises`;
+ *  - the judge's reverts (§3.6): items owning declarations that no longer build ("no longer builds") and Results whose
+ *    inference fails B.1, B.2 or its footprint (a Shaky Result, or one to be redone without revert, stays: D2-48) become
+ *    to be redone, reverted, with every dependent their content takes down (D2-28);
+ *  - premise re-checks (§3.8): their facts are replaced; one that no longer closes the gap is to be redone, marked so;
+ *  - RV-3 (A1): a new or updated item in review that depends on a Shaky or to-be-redone item is to be redone at once,
+ *    not reverted, as if that decision had just been made (its dependents in review follow);
+ *  - RV-7 (D2-23): the classes in force (`classes` while the results are shown, else `classesBeforeReveal`); an accepted
+ *    item whose badges grew returns to review, with its accepted dependents;
+ *  - RV-5, defensively: an accepted item with a dependency outside its SCC that is not accepted returns to review;
+ *  - the reveal (§4.7): a meaning item that became undecided, or a Result returned to review or given a new version,
+ *    ends Show results' force; while the results are forced and a meaning item is undecided, every Result is marked
+ *    seen early.
+ *
+ * Events name listed items only (never a Result or a Result's part while the results are hidden afterwards); the
+ * runner numbers and times them. `problems` holds reconcile's own (the judgement's are the runner's to add). `reverts`:
+ * the items whose content the write takes out (the judge's reverts and their cascades, and every written Add premise
+ * whose status no longer keeps it in ws/).
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import { reviewItemId } from './hash.js';
+import { premiseKey, proofKey } from './keys.js';
+import {
+  cloneRecord,
+  fallbackLabel,
+  inferenceOf,
+  inWorkingCopy,
+  isDeclinedOut,
+  isReverted,
+  isShaky,
+  isUndecided,
+  itemStateOf,
+  resultTargetOf,
+} from './records.js';
+import { isMeaningItem, isResultOrPart, resultsState } from './reveal.js';
+import { componentOf } from './scc.js';
+import { REVIEW_TEXTS } from './texts.js';
+import type { ItemClass, ItemDraft, ItemMarker, ItemRecord, ItemState, SessionRecords, StateJudgement } from './types.js';
+
+const UNKNOWN_CLASS: ItemClass = { belief: true, changesProved: true, reasons: [], complete: false };
+const union = (a: readonly string[], b: readonly string[]) => [...new Set([...a, ...b])];
+const sameSet = (a: readonly string[], b: readonly string[]) => [...new Set(a)].sort().join('\u0000') === [...new Set(b)].sort().join('\u0000');
+
+function addMarker(r: ItemRecord, marker: ItemMarker): void {
+  if (!r.markers.includes(marker)) r.markers = [...r.markers, marker];
+}
+
+function newRecord(runId: string, d: ItemDraft): ItemRecord {
+  return {
+    id: reviewItemId(runId, d.key),
+    key: d.key,
+    kind: d.kind,
+    ...(d.declKind !== undefined ? { declKind: d.declKind } : {}),
+    rev: 1,
+    origin: { ...d.origin },
+    ...(d.partOfResult !== undefined ? { partOf: d.partOfResult } : {}),
+    status: 'in-review',
+    markers: [],
+    fingerprint: d.contentKey,
+    content: d.content,
+    versions: [],
+    rejectedFingerprints: [],
+  };
+}
+
+/**
+ * §3.5 (2a2): a stage judgement applied to the records, when a queue ends and in every `judge-apply` write. `runId`
+ * gives new records their ids (§2.2, AF7: `reviewItemId`). `queueSteps`: the steps of the queue this judgement ends,
+ * absent at a judge that a decision started; F5's rule reads only these (§3.5, AF1).
+ */
+export function reconcile(i: { runId: string; records: SessionRecords; judgement: StateJudgement; queueSteps?: readonly string[]; at: string }): {
+  records: SessionRecords;
+  /** Never about a hidden item; the runner numbers and times them (AF7, AF9). */
+  events: Array<{ text: string; items: string[] }>;
+  problems: string[];
+  /**
+   * Items the judge makes to be redone and takes out (§3.6), and written premises it returned to review, which are
+   * taken out too (§3.8): the write's ws/ part.
+   */
+  reverts: string[];
+} {
+  const { judgement } = i;
+  const stage = i.records.stage;
+  const items = i.records.items.map(cloneRecord);
+  const byKey = new Map(items.map((r) => [r.key, r]));
+  const byId = new Map(items.map((r) => [r.id, r]));
+  let premises = i.records.premises.map((p) => ({ ...p, facts: { ...p.facts } }));
+  let forced = i.records.forced;
+  const start = new Map<string, ItemState>(items.map((r) => [r.id, itemStateOf(r)]));
+  const drafts = new Map(judgement.drafts.map((d) => [d.key, d]));
+  const problems: string[] = [];
+
+  /** Ids by what happened to them, for the events and the force. */
+  const created = new Set<string>();
+  /** A new version (rev + 1): a changed key, F5 with a changed key, a new proposal, RV-11. */
+  const updated = new Set<string>();
+  /** Their content key changed. */
+  const newContent = new Set<string>();
+  const changedAccepted: string[] = [];
+  const withDependents: string[] = [];
+  const withdrawn: string[] = [];
+  const noLongerBuilds: string[] = [];
+  const noLongerPasses: string[] = [];
+  const redoneWith: string[] = [];
+  const gapNotClosed: string[] = [];
+  const redoneAtOnce: string[] = [];
+  const badgesGrew: string[] = [];
+  const dependencyNotAccepted: string[] = [];
+
+  // ---- the queue that ended: its Submit steps, by target (F5, D2-17)
+  const queue = new Set(i.queueSteps ?? []);
+  const reworkedTargets = new Map<string, { noAlternative: boolean }>();
+  if (i.queueSteps !== undefined) {
+    for (const step of i.records.steps) {
+      if (!queue.has(step.id) || step.kind !== 'submit' || (step.state !== 'passed' && step.state !== 'gave-up')) continue;
+      const known = reworkedTargets.get(step.target);
+      reworkedTargets.set(step.target, { noAlternative: (known?.noAlternative ?? false) || step.noAlternative === true });
+    }
+  }
+  const reworked = (r: ItemRecord) => {
+    const target = inferenceOf(r);
+    return target === undefined ? undefined : reworkedTargets.get(target);
+  };
+
+  const newVersion = (r: ItemRecord, d: ItemDraft) => {
+    r.versions = [
+      ...r.versions,
+      { rev: r.rev, stage, fingerprint: r.fingerprint, content: r.content, ...(r.rejectedFingerprints.includes(r.fingerprint) ? { rejected: true } : {}) },
+    ];
+    r.rev += 1;
+    if (d.contentKey !== r.fingerprint) newContent.add(r.id);
+    r.fingerprint = d.contentKey;
+    r.content = d.content;
+    updated.add(r.id);
+  };
+  const toReview = (r: ItemRecord) => {
+    r.status = 'in-review';
+    delete r.accepted;
+    delete r.decline;
+    delete r.redo;
+  };
+
+  // ---- RV-5 edges by id, their dependents and SCCs (the judgement's, by key)
+  const depsOf = (id: string): string[] => {
+    const r = byId.get(id);
+    if (r === undefined) return [];
+    return (judgement.deps[r.key] ?? []).map((k) => byKey.get(k)?.id).filter((x): x is string => x !== undefined && x !== id);
+  };
+  const dependentsOf = (id: string): string[] => {
+    const seen = new Set([id]);
+    const out: string[] = [];
+    const queueIds = [id];
+    for (let k = 0; k < queueIds.length; k++) {
+      const at = queueIds[k] as string;
+      for (const r of items) {
+        if (seen.has(r.id) || !depsOf(r.id).includes(at)) continue;
+        seen.add(r.id);
+        out.push(r.id);
+        queueIds.push(r.id);
+      }
+    }
+    return out;
+  };
+  /** Accepted dependents return to review with it (RV-5); `marker`: "updated" for a changed key's. */
+  const acceptedDependentsBack = (from: string, marker?: ItemMarker) => {
+    for (const id of dependentsOf(from)) {
+      const x = byId.get(id) as ItemRecord;
+      if (x.status !== 'accepted') continue;
+      toReview(x);
+      if (marker !== undefined) addMarker(x, marker);
+      withDependents.push(id);
+    }
+  };
+  const changedKey = (r: ItemRecord, d: ItemDraft) => {
+    const wasAccepted = r.status === 'accepted';
+    newVersion(r, d);
+    toReview(r);
+    addMarker(r, 'updated');
+    if (wasAccepted) {
+      changedAccepted.push(r.id);
+      acceptedDependentsBack(r.id, 'updated');
+    }
+  };
+
+  // ---- 1. the records with a draft, and the new keys
+  for (const d of judgement.drafts) {
+    const r = byKey.get(d.key);
+    if (r === undefined) {
+      const fresh = newRecord(i.runId, d);
+      items.push(fresh);
+      byKey.set(fresh.key, fresh);
+      byId.set(fresh.id, fresh);
+      created.add(fresh.id);
+      continue;
+    }
+    const rework = reworked(r);
+    if (rework !== undefined && (isShaky(r) || r.status === 'to-be-redone')) {
+      // F5: its Submit step ended in the queue that just ended.
+      const changed = d.contentKey !== r.fingerprint;
+      if (changed) newVersion(r, d);
+      toReview(r);
+      if (changed) addMarker(r, 'updated');
+      if (rework.noAlternative) addMarker(r, 'no-alternative-found');
+      continue;
+    }
+    if (isDeclinedOut(r) || isReverted(r) || r.status === 'withdrawn') {
+      // AF1: B's version is no new proposal; any other draft is one. An Add premise's draft stays in `premises` while
+      // its item exists, outside ws/ (§3.5): the same draft is no new proposal either.
+      if (d.asInBase === true && r.status !== 'withdrawn') continue;
+      if (r.kind === 'add-premise' && r.status !== 'withdrawn' && d.contentKey === r.fingerprint) continue;
+      if (d.contentKey !== r.fingerprint) {
+        newVersion(r, d);
+        addMarker(r, 'updated');
+      }
+      toReview(r);
+      continue;
+    }
+    if (d.contentKey !== r.fingerprint) {
+      changedKey(r, d);
+      continue;
+    }
+    // RV-11: an accepted Result whose verdict or Rests on changed.
+    const target = resultTargetOf(r);
+    const judged = target !== undefined && Object.hasOwn(judgement.inferences, target) ? judgement.inferences[target] : undefined;
+    const accepted = r.accepted?.result;
+    if (r.kind === 'result' && r.status === 'accepted' && accepted !== undefined && judged !== undefined) {
+      if (judged.verdict !== accepted.verdict || !sameSet(judged.restsOn, accepted.restsOn)) changedKey(r, d);
+    }
+  }
+
+  // ---- 2. the records with no draft
+  for (const r of items) {
+    if (created.has(r.id) || drafts.has(r.key)) continue;
+    if (reworked(r) !== undefined && (isShaky(r) || r.status === 'to-be-redone')) {
+      toReview(r);
+      r.status = 'withdrawn';
+      withdrawn.push(r.id);
+      continue;
+    }
+    if (isDeclinedOut(r) || isReverted(r) || r.status === 'withdrawn') continue;
+    problems.push(REVIEW_TEXTS.disappeared(fallbackLabel(r)));
+  }
+
+  // ---- 3. D2-17: a new Result version withdraws its target's earlier premise drafts that are not accepted
+  if (i.queueSteps !== undefined) {
+    for (const result of items) {
+      if (result.kind !== 'result' || !newContent.has(result.id)) continue;
+      const target = resultTargetOf(result);
+      const step = drafts.get(result.key)?.origin.step;
+      if (target === undefined || step === undefined) continue;
+      for (const p of items) {
+        if (p.kind !== 'add-premise' || p.partOf !== target || p.status === 'accepted' || p.status === 'withdrawn') continue;
+        if (p.content.premise === undefined || p.content.premise.step === step) continue;
+        toReview(p);
+        p.status = 'withdrawn';
+        withdrawn.push(p.id);
+        premises = premises.filter((x) => premiseKey(x.target, x.leanName) !== p.key);
+      }
+    }
+  }
+
+  // ---- 4. the judge's reverts (§3.6), with the content they take down (D2-28)
+  const takeOut = (r: ItemRecord, list: string[], marker?: ItemMarker) => {
+    r.status = 'to-be-redone';
+    delete r.accepted;
+    if (r.decline?.option !== 'shaky') delete r.decline;
+    r.redo = { because: r.redo?.because ?? [], reverted: true };
+    if (marker !== undefined) addMarker(r, marker);
+    list.push(r.id);
+    for (const id of dependentsOf(r.id)) {
+      const x = byId.get(id) as ItemRecord;
+      const goes = x.status === 'in-review' || x.status === 'accepted' || x.status === 'to-be-redone' || (x.status === 'declined' && x.decline?.option === 'shaky');
+      if (!goes || isReverted(x)) continue;
+      x.status = 'to-be-redone';
+      delete x.accepted;
+      if (x.decline?.option !== 'shaky') delete x.decline;
+      x.redo = { because: union(x.redo?.because ?? [], [r.id]), reverted: true };
+      redoneWith.push(id);
+    }
+  };
+  for (const problem of judgement.problems) {
+    if (problem.code !== 'no-longer-builds') continue;
+    for (const key of problem.keys ?? []) {
+      const r = byKey.get(key);
+      if (r !== undefined && inWorkingCopy(r.kind, r, r.card)) takeOut(r, noLongerBuilds, 'no-longer-builds');
+    }
+  }
+  for (const [target, judged] of Object.entries(judgement.inferences)) {
+    if (judged.passes) continue;
+    const r = byKey.get(proofKey(target));
+    // A Shaky Result, or one to be redone with its content kept, stays: its Submit step reworks it (D2-48).
+    if (r === undefined || (r.status !== 'in-review' && r.status !== 'accepted') || !inWorkingCopy(r.kind, r)) continue;
+    takeOut(r, noLongerPasses);
+  }
+
+  // ---- 5. premise re-checks (§3.8)
+  for (const [key, check] of Object.entries(judgement.premiseChecks ?? {})) {
+    premises = premises.map((p) => (premiseKey(p.target, p.leanName) === key ? { ...p, facts: { ...check.facts } } : p));
+    const r = byKey.get(key);
+    if (check.closesGap || r === undefined) continue;
+    if (r.status !== 'in-review' && r.status !== 'accepted' && !(r.status === 'to-be-redone' && !isReverted(r))) continue;
+    r.status = 'to-be-redone';
+    delete r.accepted;
+    delete r.decline;
+    r.redo = { because: [], reverted: true };
+    addMarker(r, 'no-longer-closes-gap');
+    gapNotClosed.push(r.id);
+  }
+
+  // ---- 6. RV-3 (A1): new or updated items in review that depend on Shaky or to-be-redone ones
+  const blockers = (id: string) =>
+    depsOf(id).filter((d) => {
+      const x = byId.get(d);
+      return x !== undefined && (x.status === 'to-be-redone' || isShaky(x));
+    });
+  const fresh = items.filter((r) => (created.has(r.id) || updated.has(r.id)) && r.status === 'in-review');
+  const marked = new Set<string>();
+  const mark = (r: ItemRecord, because: string[]) => {
+    if (marked.has(r.id)) return;
+    marked.add(r.id);
+    r.status = 'to-be-redone';
+    r.redo = { because, reverted: false };
+    redoneAtOnce.push(r.id);
+    for (const id of dependentsOf(r.id)) {
+      const x = byId.get(id) as ItemRecord;
+      if (x.status === 'in-review' && !marked.has(id)) mark(x, [r.id]);
+    }
+  };
+  for (const r of fresh) {
+    const because = blockers(r.id);
+    if (because.length > 0) mark(r, because);
+  }
+
+  // ---- the reveal's force (§4.7): ends when a meaning item became undecided, or a Result is back or new
+  const endsForce = () =>
+    items.some((r) => {
+      const was = start.get(r.id);
+      if (r.kind === 'result') return newContent.has(r.id) || (was !== undefined && was.status !== 'in-review' && r.status === 'in-review');
+      if (!isMeaningItem(r, judgement.classesBeforeReveal) || !isUndecided(r)) return false;
+      return was === undefined || !isUndecided(was);
+    });
+  if (forced !== undefined && endsForce()) forced = undefined;
+
+  // ---- 7. RV-7 (D2-23): the classes in force
+  const shownNow = resultsState({ items, classesBeforeReveal: judgement.classesBeforeReveal, forced: forced ?? null }).shown;
+  const inForce = shownNow ? judgement.classes : judgement.classesBeforeReveal;
+  for (const r of items) {
+    if (r.status !== 'accepted' || r.accepted === undefined) continue;
+    const cls = (Object.hasOwn(inForce, r.key) ? inForce[r.key] : undefined) ?? UNKNOWN_CLASS;
+    if (!((cls.belief && !r.accepted.belief) || (cls.changesProved && !r.accepted.changesProved))) continue;
+    toReview(r);
+    badgesGrew.push(r.id);
+    acceptedDependentsBack(r.id);
+  }
+
+  // ---- 8. RV-5, defensively: an accepted item with a dependency outside its SCC that is not accepted
+  const component = componentOf(
+    items.map((r) => r.id),
+    depsOf,
+  );
+  for (let again = true; again; ) {
+    again = false;
+    for (const r of items) {
+      if (r.status !== 'accepted') continue;
+      const own = component.get(r.id);
+      const open = depsOf(r.id).some((d) => component.get(d) !== own && byId.get(d)?.status !== 'accepted');
+      if (!open) continue;
+      toReview(r);
+      dependencyNotAccepted.push(r.id);
+      again = true;
+    }
+  }
+
+  // ---- the force again (D2-23 and RV-5 may have made a meaning item undecided), and seen early
+  if (forced !== undefined && endsForce()) forced = undefined;
+  const final = resultsState({ items, classesBeforeReveal: judgement.classesBeforeReveal, forced: forced ?? null });
+  if (forced !== undefined && final.waitingFor.length > 0) for (const r of items) if (r.kind === 'result') addMarker(r, 'seen-early');
+
+  // ---- the write's ws/ part: content the judge takes out, and written premises no status keeps in ws/
+  const reverts: string[] = [];
+  for (const r of items) {
+    if (r.status === 'withdrawn' && r.kind !== 'add-premise') continue;
+    const was = start.get(r.id);
+    const before = was === undefined ? r.kind !== 'add-premise' : inWorkingCopy(r.kind, was, r.card);
+    if (before && !inWorkingCopy(r.kind, r, r.card, was)) reverts.push(r.id);
+  }
+
+  // ---- events: listed items only, as the results are after this judgement
+  const listed = (id: string) => {
+    const r = byId.get(id);
+    return r !== undefined && (final.shown || !isResultOrPart(r));
+  };
+  const events: Array<{ text: string; items: string[] }> = [];
+  const event = (text: string, ids: readonly string[]) => {
+    const shown = [...new Set(ids)].filter(listed);
+    if (shown.length > 0) events.push({ text, items: shown });
+  };
+  event(REVIEW_TEXTS.eventChanged, changedAccepted);
+  event(REVIEW_TEXTS.eventWithdrawn, withdrawn);
+  event(REVIEW_TEXTS.eventNoLongerBuilds, noLongerBuilds);
+  event(REVIEW_TEXTS.eventNoLongerPasses, noLongerPasses);
+  event(
+    REVIEW_TEXTS.eventRedoneWith,
+    redoneWith.filter((id) => !noLongerBuilds.includes(id) && !noLongerPasses.includes(id)),
+  );
+  event(REVIEW_TEXTS.eventNoLongerClosesGap, gapNotClosed);
+  event(REVIEW_TEXTS.eventRedoneAtOnce, redoneAtOnce);
+  event(REVIEW_TEXTS.eventBadgesGrew, badgesGrew);
+  event(
+    REVIEW_TEXTS.eventChangedWith,
+    withDependents.filter((id) => byId.get(id)?.status === 'in-review'),
+  );
+  event(REVIEW_TEXTS.eventDependencyNotAccepted, dependencyNotAccepted);
+
+  const records: SessionRecords = { ...i.records, items, premises };
+  if (forced !== undefined) records.forced = forced;
+  else delete records.forced;
+  void i.at;
+  return { records, events, problems, reverts };
+}
diff --git a/packages/core/src/review/records.ts b/packages/core/src/review/records.ts
new file mode 100644
index 0000000..e76212f
--- /dev/null
+++ b/packages/core/src/review/records.ts
@@ -0,0 +1,143 @@
+/**
+ * Slice 2a2 (docs/slice2-plan.md sections 3.1, 3.5, 4.6 and 4.7): what the status rules read of an item record, shared
+ * by the reveal rule (`reveal.ts`), the reducer and reconcile. Not exported from `review/index.ts` (its exports are
+ * §2.9's); later core sub-slices import it from here.
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import { canonicalJson } from './hash.js';
+import { parseItemKey } from './keys.js';
+import { DECL_KIND_LABELS, ITEM_KIND_LABELS } from './texts.js';
+import type { ItemKind, ItemRecord, ItemState } from './types.js';
+
+type StatusPart = Pick<ItemRecord, 'status' | 'decline' | 'redo'>;
+
+export const isArrowKind = (kind: ItemKind): boolean => kind === 'add-arrow' || kind === 'remove-arrow';
+
+/** A cascade or the judge took the item's content out of ws/ (`redo.reverted`), whatever its status now. */
+export const isReverted = (r: { redo?: ItemRecord['redo'] }): boolean => r.redo?.reverted === true;
+
+/** §4.7 (AF4): undecided: in review, or to be redone with its content still in ws/. */
+export function isUndecided(r: StatusPart): boolean {
+  return r.status === 'in-review' || (r.status === 'to-be-redone' && !isReverted(r));
+}
+
+/** Declined by Reject, a plain decline or Transform: the content is out of ws/ (§3.1). */
+export const isDeclinedOut = (r: StatusPart): boolean => r.status === 'declined' && r.decline?.option !== 'shaky';
+
+/** Shaky: declined Shaky, or to be redone keeping its Shaky decline (a Reject cascade or Submit's take-out, §3.7). */
+export const isShaky = (r: StatusPart): boolean => r.decline?.option === 'shaky' && (r.status === 'declined' || r.status === 'to-be-redone');
+
+/**
+ * §3.1: whether the item's content is in ws/ under its status: in review, accepted, declined Shaky, or to be redone,
+ * unless a cascade or the judge took it out (`redo.reverted`). An Add premise is in ws/ only once written (§3.8): here,
+ * "in" means it stays written when it is: accepted, declined Shaky or to be redone without revert, or in review only
+ * while it was written in review and never left it (a converted v1 ghost, whose record holds its `card`, §3.11). `from`:
+ * the state it came from, for a transition: a written premise that comes back to review from any other status is
+ * taken out (§3.8), although its record still holds its `card` until that take-out.
+ */
+export function inWorkingCopy(kind: ItemKind, r: StatusPart, card?: string, from?: StatusPart): boolean {
+  if (isReverted(r)) return false;
+  if (kind === 'add-premise') {
+    if (r.status === 'in-review') return card !== undefined && (from === undefined || from.status === 'in-review');
+    return r.status === 'accepted' || r.status === 'to-be-redone' || (r.status === 'declined' && r.decline?.option === 'shaky');
+  }
+  if (r.status === 'declined') return r.decline?.option === 'shaky';
+  return r.status !== 'withdrawn';
+}
+
+/** A record's state as one action may change it (§2.2 `ItemState`), copied. */
+export function itemStateOf(r: ItemRecord): ItemState {
+  return {
+    status: r.status,
+    ...(r.decline !== undefined ? { decline: { ...r.decline } } : {}),
+    ...(r.accepted !== undefined
+      ? { accepted: { ...r.accepted, ...(r.accepted.result ? { result: { ...r.accepted.result, restsOn: [...r.accepted.result.restsOn] } } : {}) } }
+      : {}),
+    ...(r.redo !== undefined ? { redo: { because: [...r.redo.because], reverted: r.redo.reverted } } : {}),
+    markers: [...r.markers],
+    rejectedFingerprints: [...r.rejectedFingerprints],
+    rejectedRevs: r.versions.filter((v) => v.rejected === true).map((v) => v.rev),
+  };
+}
+
+/** Puts a state on a record (in place), the versions' rejected flags included. */
+export function applyItemState(r: ItemRecord, s: ItemState): void {
+  r.status = s.status;
+  if (s.decline !== undefined) r.decline = { ...s.decline };
+  else delete r.decline;
+  if (s.accepted !== undefined) r.accepted = { ...s.accepted };
+  else delete r.accepted;
+  if (s.redo !== undefined) r.redo = { because: [...s.redo.because], reverted: s.redo.reverted };
+  else delete r.redo;
+  r.markers = [...s.markers];
+  r.rejectedFingerprints = [...s.rejectedFingerprints];
+  const rejected = new Set(s.rejectedRevs);
+  r.versions = r.versions.map((v) => ({
+    rev: v.rev,
+    stage: v.stage,
+    fingerprint: v.fingerprint,
+    content: v.content,
+    ...(rejected.has(v.rev) ? { rejected: true } : {}),
+  }));
+}
+
+/**
+ * The decision a state records, for comparing an item now with what an action left (Undo, D2-73): everything but the
+ * markers and what telelean's writes add afterwards (the decision commit, a premise write's written key).
+ */
+export function decisionKey(s: ItemState): string {
+  const accepted = s.accepted === undefined ? undefined : { ...s.accepted, fingerprint: undefined };
+  const decline = s.decline === undefined ? undefined : { ...s.decline, commit: undefined };
+  return canonicalJson({
+    status: s.status,
+    decline,
+    accepted,
+    redo: s.redo,
+    rejectedFingerprints: [...s.rejectedFingerprints].sort(),
+    rejectedRevs: [...s.rejectedRevs].sort((a, b) => a - b),
+  });
+}
+
+/** Records are plain JSON: a deep copy. */
+export function cloneRecord(r: ItemRecord): ItemRecord {
+  return JSON.parse(JSON.stringify(r)) as ItemRecord;
+}
+
+/** The target of a Result (`proof:<T>`), or undefined. */
+export function resultTargetOf(r: Pick<ItemRecord, 'key'>): string | undefined {
+  const parsed = parseItemKey(r.key);
+  return parsed?.kind === 'proof' ? parsed.node : undefined;
+}
+
+/** The inference an item belongs to (§3.7: a Result's target, else the target of the step that proposed it). */
+export function inferenceOf(r: Pick<ItemRecord, 'key' | 'kind' | 'origin'>): string | undefined {
+  if (r.kind === 'result') return resultTargetOf(r);
+  return r.origin.target === '' ? undefined : r.origin.target;
+}
+
+/**
+ * An item's label when the caller gives none (`ReviewState.labels`): its kind's label and the names of its key, e.g.
+ * `Formalize “pg-no-dark-past”`, `Add arrow “s” → “t”`, `Definition Spyro.Evil`.
+ */
+export function fallbackLabel(r: Pick<ItemRecord, 'key' | 'kind' | 'declKind' | 'content'>): string {
+  const kind = r.kind === 'declaration' && r.declKind !== undefined ? DECL_KIND_LABELS[r.declKind] : ITEM_KIND_LABELS[r.kind];
+  const parsed = parseItemKey(r.key);
+  let what = r.key;
+  if (parsed?.kind === 'card' || parsed?.kind === 'proof') what = `“${parsed.node}”`;
+  else if (parsed?.kind === 'premise') what = `“${r.content.premise?.naturalName ?? parsed.leanName}”`;
+  else if (parsed?.kind === 'arrow' || parsed?.kind === 'unarrow') what = `“${parsed.arrow.source}” → “${parsed.arrow.target}”`;
+  else if (parsed?.kind === 'vocab' || parsed?.kind === 'decl') what = parsed.name;
+  return `${kind} ${what}`;
+}
+
+/** RV-5 edges by item id, from a judgement's edges by key (the reducer's `ReviewState.deps`). */
+export function depsById(items: readonly Pick<ItemRecord, 'id' | 'key'>[], deps: Readonly<Record<string, readonly string[]>>): Record<string, string[]> {
+  const idOf = new Map(items.map((r) => [r.key, r.id]));
+  const out: Record<string, string[]> = {};
+  for (const r of items) {
+    const ids = (deps[r.key] ?? []).map((k) => idOf.get(k)).filter((id): id is string => id !== undefined && id !== r.id);
+    out[r.id] = [...new Set(ids)].sort();
+  }
+  return out;
+}
diff --git a/packages/core/src/review/reducer.ts b/packages/core/src/review/reducer.ts
new file mode 100644
index 0000000..8af8d27
--- /dev/null
+++ b/packages/core/src/review/reducer.ts
@@ -0,0 +1,1021 @@
+/**
+ * Slice 2a2 (docs/slice2-plan.md section 4.6): statuses, cascades, groups (RV-8) and the session stack (UN-4–UN-6).
+ *
+ * `reduceReview(state, action, at)` applies one review action to copies of the records and returns every effect: the
+ * records, the questions and declined arrows it changed, Show results' force, the stack, the texts, and the ws/ changes
+ * the runner carries out through the write queue (`ItemWrite`). The runner calls it only in a stage: while a step runs,
+ * every action is refused before it (D2-62).
+ *
+ * The rules (the table of §4.6, §3.6, D2-28, D2-48, D2-59, D2-60, D2-64, D2-73):
+ *  - Accept: from in review only; every dependency outside the item's SCC accepted (a dependency on a hidden Result's
+ *    part makes it wait for the results); an RV-7 item only by its own Accept (`own`, never inferred from a count); a
+ *    Result or a Result's part only while the results are shown; never under the "did not pass" heading. An Add premise
+ *    takes its hold-as choice (never a default); one written in review (a converted v1 ghost) only as an axiom.
+ *  - Reject and the plain decline (arrow items: DO-0): the content goes, with every dependent, transitively, that is in
+ *    review, to be redone, declined Shaky or accepted: to be redone, reverted. Its key joins `rejectedFingerprints` (a
+ *    premise's draft key too), an arrow's ends `rejectedArrows`; DO-0 also takes the arrow's source out of every question
+ *    that selected it (`questionArrows`) and makes that Result to be redone. (DO-0's "a card Claude added at either end
+ *    is declined with its items" waits for slice 3: no slice-2 step adds a card.) Shaky: nothing leaves ws/; dependents
+ *    in review or accepted become to be redone, not reverted. Transform is refused until slice 4.
+ *  - Back to review: an accepted item, with its accepted dependents; a Shaky one; un-reject (the content comes back, and
+ *    the dependents its decline took out come back to be redone without revert; a premise's merges nothing); an item to
+ *    be redone only while its content is in ws/. An item whose content a cascade took out before it was declined keeps
+ *    `redo` (reverted), and comes back to be redone, not in review.
+ *  - Taking an Accept away asks first (`needs-confirmation`): while the results are shown, when accepted dependents lose
+ *    theirs; while they are hidden, always, reading only listed statuses (D2-64).
+ *  - An action that shows the results applies D2-23 with `classes`; one that makes a meaning item undecided ends Show
+ *    results' force (recorded, so Undo puts it back).
+ *  - Undo restores the effects its action recorded once the item revs and decisions are still what it left (else
+ *    `conflict`) and the restored statuses pass the rules (RV-5, RV-7's own Accept, D2-8, "did not pass"); taking an
+ *    Accept away gets RV-5's list as by hand. Redo sends the recorded request again through the rules, never a recorded
+ *    state, and is refused when they now leave any of it. Every new action, a seal included, clears Redo; a seal stops
+ *    Undo.
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import type { ArrowEnds } from '../actions.js';
+import type { CanvasPosition } from '../layout.js';
+import { premiseDraftKey } from './items.js';
+import { parseItemKey } from './keys.js';
+import {
+  applyItemState,
+  cloneRecord,
+  decisionKey,
+  fallbackLabel,
+  inWorkingCopy,
+  isArrowKind,
+  isDeclinedOut,
+  isReverted,
+  isUndecided,
+  itemStateOf,
+  resultTargetOf,
+} from './records.js';
+import { isMeaningItem, isResultOrPart, resultsState } from './reveal.js';
+import { componentOf } from './scc.js';
+import { REVIEW_TEXTS } from './texts.js';
+import type {
+  CascadeEntry,
+  DeclineOption,
+  GroupItem,
+  GroupLeftReason,
+  ItemClass,
+  ItemDecision,
+  ItemRecord,
+  ItemState,
+  ItemWrite,
+  ReviewAction,
+  ReviewOutcome,
+  ReviewState,
+  SealBy,
+  SessionAction,
+  SessionForce,
+  SessionInference,
+} from './types.js';
+
+type Ok = Extract<ReviewOutcome, { ok: true }>;
+type DecideAction = Extract<SessionAction, { kind: 'decide' }>;
+
+const refused = (error: string, item?: string): ReviewOutcome => ({ ok: false, code: 'refused', error, ...(item !== undefined ? { item } : {}) });
+const conflict = (error: string, item?: string): ReviewOutcome => ({ ok: false, code: 'conflict', error, ...(item !== undefined ? { item } : {}) });
+
+/** A class the judgement did not give: every badge (fail closed, D2-25). */
+const UNKNOWN_CLASS: ItemClass = { belief: true, changesProved: true, reasons: [], complete: false };
+const sameArrow = (a: ArrowEnds, b: ArrowEnds) => a.source === b.source && a.target === b.target;
+const union = (a: readonly string[], b: readonly string[]) => [...new Set([...a, ...b])];
+
+/** The working state of one action: copies of the records and of the session parts an action may change. */
+class Work {
+  readonly items: ItemRecord[];
+  readonly byId: Map<string, ItemRecord>;
+  inferences: SessionInference[];
+  rejectedArrows: ArrowEnds[];
+  forced: SessionForce | null;
+  /** The first state (and rev) of every item the action touched. */
+  readonly start = new Map<string, { rev: number; state: ItemState }>();
+  /** Why a dependent's status changed (CascadeEntry.why), by item id. */
+  readonly why = new Map<string, string>();
+  readonly questions: DecideAction['questions'] = [];
+  readonly arrowsAdded: ArrowEnds[] = [];
+  readonly arrowsRemoved: ArrowEnds[] = [];
+  /** Items D2-23 returned to review (their badges grew). */
+  readonly grew: string[] = [];
+  private readonly dependentsOf = new Map<string, string[]>();
+  private readonly component: Map<string, number>;
+
+  constructor(readonly state: ReviewState) {
+    this.items = state.items.map(cloneRecord);
+    this.byId = new Map(this.items.map((r) => [r.id, r]));
+    this.inferences = state.inferences.map((inf) => ({ ...inf, question: { sources: [...inf.question.sources], fromNothing: inf.question.fromNothing }, steps: [...inf.steps] }));
+    this.rejectedArrows = state.rejectedArrows.map((a) => ({ ...a }));
+    this.forced = state.forced;
+    for (const r of this.items) {
+      for (const d of this.deps(r.id)) {
+        const list = this.dependentsOf.get(d) ?? [];
+        list.push(r.id);
+        this.dependentsOf.set(d, list);
+      }
+    }
+    this.component = componentOf(
+      this.items.map((r) => r.id),
+      (id) => this.deps(id),
+    );
+  }
+
+  deps(id: string): readonly string[] {
+    return Object.hasOwn(this.state.deps, id) ? (this.state.deps[id] ?? []) : [];
+  }
+
+  /** The dependencies outside the item's SCC (D2-26). */
+  outside(id: string): string[] {
+    const own = this.component.get(id);
+    return this.deps(id).filter((d) => this.component.get(d) !== own || own === undefined);
+  }
+
+  /** Every item that depends on `id`, transitively (`id` itself left out). */
+  dependents(id: string): string[] {
+    const seen = new Set([id]);
+    const out: string[] = [];
+    const queue = [id];
+    for (let k = 0; k < queue.length; k++) {
+      for (const d of this.dependentsOf.get(queue[k] as string) ?? []) {
+        if (seen.has(d)) continue;
+        seen.add(d);
+        out.push(d);
+        queue.push(d);
+      }
+    }
+    return out;
+  }
+
+  /** The record, its first state remembered before the action changes it. */
+  touch(id: string): ItemRecord {
+    const r = this.byId.get(id) as ItemRecord;
+    if (!this.start.has(id)) this.start.set(id, { rev: r.rev, state: itemStateOf(r) });
+    return r;
+  }
+
+  reveal() {
+    return resultsState({ items: this.items, classesBeforeReveal: this.state.classesBeforeReveal, forced: this.forced });
+  }
+
+  classOf(r: ItemRecord, shown: boolean): ItemClass {
+    const map = shown ? this.state.classes : this.state.classesBeforeReveal;
+    return (Object.hasOwn(map, r.key) ? map[r.key] : undefined) ?? UNKNOWN_CLASS;
+  }
+
+  label(id: string): string {
+    const given = this.state.labels !== undefined && Object.hasOwn(this.state.labels, id) ? this.state.labels[id] : undefined;
+    if (given !== undefined) return given;
+    const r = this.byId.get(id);
+    return r === undefined ? id : fallbackLabel(r);
+  }
+
+  /** The ids whose state the action changed (markers included), in the records' order. */
+  changed(): string[] {
+    return this.items
+      .filter((r) => {
+        const first = this.start.get(r.id);
+        if (first === undefined) return false;
+        const now = itemStateOf(r);
+        return decisionKey(now) !== decisionKey(first.state) || now.markers.join('\u0000') !== first.state.markers.join('\u0000');
+      })
+      .map((r) => r.id);
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Groups (RV-8)
+
+/** RV-8 (§4.6; 2a2): the greatest set a group Accept takes, and what it leaves, with why. */
+export function planGroupAccept(items: readonly GroupItem[], selected: readonly string[]): { take: string[]; left: Array<{ item: string; reason: GroupLeftReason }> } {
+  const byId = new Map(items.map((g) => [g.id, g]));
+  const component = componentOf(
+    items.map((g) => g.id),
+    (id) => byId.get(id)?.dependsOn ?? [],
+  );
+  const chosen = [...new Set(selected)];
+  const left: Array<{ item: string; reason: GroupLeftReason }> = [];
+  const take = new Set<string>();
+  for (const id of chosen) {
+    const g = byId.get(id);
+    if (g === undefined) left.push({ item: id, reason: 'not-in-review' });
+    else if (g.hidden) left.push({ item: id, reason: 'hidden-result' });
+    else if (g.status !== 'in-review') left.push({ item: id, reason: 'not-in-review' });
+    else if (g.ownAccept) left.push({ item: id, reason: 'own-accept' });
+    else if (g.blocked) left.push({ item: id, reason: 'blocked' });
+    else take.add(id);
+  }
+  // The greatest fixpoint: drop a candidate with a dependency outside its SCC that is neither accepted nor taken.
+  for (let changed = true; changed; ) {
+    changed = false;
+    for (const id of [...take]) {
+      const g = byId.get(id) as GroupItem;
+      const own = component.get(id);
+      const blocked = g.dependsOn.some((d) => component.get(d) !== own && byId.get(d)?.status !== 'accepted' && !take.has(d));
+      if (!blocked) continue;
+      take.delete(id);
+      changed = true;
+    }
+  }
+  for (const id of chosen) if (byId.has(id) && !take.has(id) && !left.some((l) => l.item === id)) left.push({ item: id, reason: 'depends' });
+  return { take: chosen.filter((id) => take.has(id)), left };
+}
+
+/** RV-8 (§4.6; 2a2): one option for every selected item, `plain` for arrow items; hidden Results are left. */
+export function planGroupDecline(
+  items: readonly GroupItem[],
+  selected: readonly string[],
+  option: DeclineOption,
+): { decisions: Array<{ item: string; option: DeclineOption }>; left: Array<{ item: string; reason: GroupLeftReason }> } {
+  const byId = new Map(items.map((g) => [g.id, g]));
+  const decisions: Array<{ item: string; option: DeclineOption }> = [];
+  const left: Array<{ item: string; reason: GroupLeftReason }> = [];
+  for (const id of [...new Set(selected)]) {
+    const g = byId.get(id);
+    if (g === undefined) left.push({ item: id, reason: 'not-in-review' });
+    else if (g.hidden) left.push({ item: id, reason: 'hidden-result' });
+    else if (g.status === 'declined' || g.status === 'withdrawn' || g.status === null) left.push({ item: id, reason: 'not-in-review' });
+    else if (g.arrow) decisions.push({ item: id, option: 'plain' });
+    else if (option === 'plain') left.push({ item: id, reason: 'blocked' });
+    else decisions.push({ item: id, option });
+  }
+  return { decisions, left };
+}
+
+// ---------------------------------------------------------------------------------------------
+// The rules, on one Work
+
+/** The item is hidden: a Result or a Result's part while the results are hidden. */
+const hiddenIn = (shown: boolean) => (r: ItemRecord) => !shown && isResultOrPart(r);
+
+/**
+ * Whether an Accept of `r` may go now (§4.5, §4.6): `missing` the listed dependencies outside its SCC that are not
+ * accepted; `waits` when it depends on a hidden item. Its RV-7 class and status are the caller's.
+ */
+function dependencyGate(w: Work, r: ItemRecord, shown: boolean): { missing: string[]; waits: boolean } {
+  const hidden = hiddenIn(shown);
+  const missing: string[] = [];
+  let waits = false;
+  for (const d of w.outside(r.id)) {
+    const dep = w.byId.get(d);
+    if (dep === undefined) continue;
+    if (hidden(dep)) waits = true;
+    else if (dep.status !== 'accepted') missing.push(d);
+  }
+  return { missing, waits };
+}
+
+/** A GroupItem of a record (the host's side of RV-8). */
+function groupItemOf(w: Work, r: ItemRecord, shown: boolean): GroupItem {
+  const cls = w.classOf(r, shown);
+  const gate = dependencyGate(w, r, shown);
+  return {
+    id: r.id,
+    status: r.status,
+    dependsOn: [...w.deps(r.id)],
+    ownAccept: cls.belief || cls.changesProved,
+    hidden: hiddenIn(shown)(r),
+    blocked: w.state.didNotPass || gate.waits,
+    arrow: isArrowKind(r.kind),
+  };
+}
+
+/** The refusal text of a reason a group left an item, or a Redo the rules now refuse (AF13). */
+function leftText(w: Work, id: string, reason: GroupLeftReason, shown: boolean): string {
+  const r = w.byId.get(id);
+  const label = w.label(id);
+  if (r === undefined) return REVIEW_TEXTS.conflict(label);
+  switch (reason) {
+    case 'hidden-result':
+      return REVIEW_TEXTS.showResultsFirst;
+    case 'not-in-review':
+      return REVIEW_TEXTS.leftNotInReview(label);
+    case 'own-accept': {
+      const cls = w.classOf(r, shown);
+      return cls.belief ? REVIEW_TEXTS.leftOwnAccept(label) : REVIEW_TEXTS.leftOwnAcceptProved(label);
+    }
+    case 'blocked':
+      return w.state.didNotPass ? REVIEW_TEXTS.acceptDidNotPass : REVIEW_TEXTS.acceptWaitsForResults(label);
+    case 'depends':
+      return REVIEW_TEXTS.acceptNeedsDependencies(
+        label,
+        dependencyGate(w, r, shown).missing.map((d) => w.label(d)),
+      );
+  }
+}
+
+/** Reject, plain decline, a judge's revert: the dependents, transitively, that the content takes down (D2-28). */
+function cascadeOut(w: Work, from: string): void {
+  for (const id of w.dependents(from)) {
+    const x = w.byId.get(id) as ItemRecord;
+    const goes = x.status === 'in-review' || x.status === 'accepted' || x.status === 'to-be-redone' || (x.status === 'declined' && x.decline?.option === 'shaky');
+    if (!goes) continue;
+    w.touch(id);
+    x.status = 'to-be-redone';
+    delete x.accepted;
+    // A Shaky dependent keeps its decline and note: it is still quoted under SHAKY at Submit review (§3.7).
+    if (x.decline?.option !== 'shaky') delete x.decline;
+    x.redo = { because: union(x.redo?.because ?? [], [from]), reverted: true };
+    if (!w.why.has(id)) w.why.set(id, REVIEW_TEXTS.cascadeWhy(w.label(from)));
+  }
+}
+
+/** Shaky (D2-48): dependents in review or accepted become to be redone, their content kept. */
+function cascadeShaky(w: Work, from: string): void {
+  for (const id of w.dependents(from)) {
+    const x = w.byId.get(id) as ItemRecord;
+    if (x.status !== 'in-review' && x.status !== 'accepted') continue;
+    w.touch(id);
+    x.status = 'to-be-redone';
+    delete x.accepted;
+    x.redo = { because: [from], reverted: false };
+    if (!w.why.has(id)) w.why.set(id, REVIEW_TEXTS.cascadeWhy(w.label(from)));
+  }
+}
+
+/** Back to review (RV-5): the accepted dependents return to review with it. */
+function cascadeBack(w: Work, from: string, why?: string): void {
+  for (const id of w.dependents(from)) {
+    const x = w.byId.get(id) as ItemRecord;
+    if (x.status !== 'accepted') continue;
+    w.touch(id);
+    x.status = 'in-review';
+    delete x.accepted;
+    if (!w.why.has(id)) w.why.set(id, why ?? REVIEW_TEXTS.cascadeWhy(w.label(from)));
+  }
+}
+
+/** The items a decide action carried out: those of its request that it changed (a group's left items are not). */
+function decidedBy(action: DecideAction): string[] {
+  const changed = new Set(action.changes.map((c) => c.item));
+  return action.request.decisions.map((d) => d.item).filter((id) => changed.has(id));
+}
+
+/** An Add premise's sentence (its card's, once written): its draft's, else its key's Lean name. */
+function premiseSentence(r: ItemRecord): string {
+  if (r.content.premise !== undefined) return r.content.premise.naturalName;
+  const parsed = parseItemKey(r.key);
+  return parsed?.kind === 'premise' ? parsed.leanName : r.key;
+}
+
+/** The keys a decline rejects (DO-1): the content key, and a premise's draft key (§4.3). */
+function rejectedKeysOf(r: ItemRecord): string[] {
+  return union([r.fingerprint], r.kind === 'add-premise' && r.content.premise !== undefined ? [premiseDraftKey(r.content.premise)] : []);
+}
+
+function arrowOf(r: ItemRecord): ArrowEnds | undefined {
+  if (r.content.arrow !== undefined) return r.content.arrow;
+  const parsed = parseItemKey(r.key);
+  return parsed?.kind === 'arrow' || parsed?.kind === 'unarrow' ? parsed.arrow : undefined;
+}
+
+/** A decline (§4.6's table, §3.6, DO-0, DO-1, DO-3). Returns the refusal, if any. */
+function decline(w: Work, d: ItemDecision, shown: boolean, at: string): ReviewOutcome | undefined {
+  const r = w.byId.get(d.item) as ItemRecord;
+  const label = w.label(r.id);
+  if (hiddenIn(shown)(r)) return refused(REVIEW_TEXTS.showResultsFirst, r.id);
+  const arrow = isArrowKind(r.kind);
+  const option: DeclineOption | undefined = arrow ? 'plain' : d.option;
+  if (option === 'transform') return refused(REVIEW_TEXTS.transformLater, r.id);
+  if (option === undefined || option === 'plain') {
+    if (!arrow) return refused(REVIEW_TEXTS.plainOnlyArrows(label), r.id);
+  }
+  if (r.status === 'declined') return refused(REVIEW_TEXTS.declinedAlready(label), r.id);
+  if (r.status === 'withdrawn') return refused(REVIEW_TEXTS.withdrawnStays(label), r.id);
+  const chosen = option as DeclineOption;
+  w.touch(r.id);
+  const reverted = isReverted(r);
+  r.status = 'declined';
+  const note = chosen === 'shaky' && d.note !== undefined && d.note.trim() !== '' ? d.note : undefined;
+  r.decline = { option: chosen, ...(note !== undefined ? { note } : {}), at };
+  delete r.accepted;
+  // Content a cascade took out stays out: the record keeps `redo`, so un-reject returns it to be redone (D2-60).
+  if (!reverted) delete r.redo;
+  if (chosen === 'shaky') {
+    cascadeShaky(w, r.id);
+    return undefined;
+  }
+  r.rejectedFingerprints = union(r.rejectedFingerprints, rejectedKeysOf(r));
+  cascadeOut(w, r.id);
+  if (!arrow) return undefined;
+  // DO-0: the arrow is never proposed again, and leaves every question that selected it (D2-59).
+  const ends = arrowOf(r);
+  if (ends === undefined) return undefined;
+  if (!w.rejectedArrows.some((a) => sameArrow(a, ends))) {
+    w.rejectedArrows.push({ ...ends });
+    w.arrowsAdded.push({ ...ends });
+  }
+  for (const [resultId, arrows] of Object.entries(w.state.questionArrows)) {
+    if (!arrows.includes(r.id)) continue;
+    const result = w.byId.get(resultId);
+    const target = result === undefined ? undefined : resultTargetOf(result);
+    const inference = target === undefined ? undefined : w.inferences.find((inf) => inf.target === target);
+    if (result === undefined || inference === undefined || !inference.question.sources.includes(ends.source)) continue;
+    const before = { sources: [...inference.question.sources], fromNothing: inference.question.fromNothing };
+    inference.question = { sources: inference.question.sources.filter((s) => s !== ends.source), fromNothing: inference.question.fromNothing };
+    w.questions.push({ target: inference.target, before, after: { sources: [...inference.question.sources], fromNothing: inference.question.fromNothing } });
+    // Reverted only if its proof uses the arrow (then the cascade above took it out already). Its content stays, so
+    // what depends on it follows as after a Shaky decline (D2-48).
+    if (result.status === 'in-review' || result.status === 'accepted' || (result.status === 'declined' && result.decline?.option === 'shaky')) {
+      w.touch(result.id);
+      result.status = 'to-be-redone';
+      delete result.accepted;
+      if (result.decline?.option !== 'shaky') delete result.decline;
+      result.redo = { because: [r.id], reverted: false };
+      w.why.set(result.id, REVIEW_TEXTS.leftQuestion(ends.source, inference.target));
+      cascadeShaky(w, result.id);
+    }
+  }
+  return undefined;
+}
+
+/** Back to review (§4.6's table): an Accept taken back, a Shaky decline, un-reject, an item to be redone. */
+function backToReview(w: Work, d: ItemDecision, shown: boolean): ReviewOutcome | undefined {
+  const r = w.byId.get(d.item) as ItemRecord;
+  const label = w.label(r.id);
+  if (hiddenIn(shown)(r)) return refused(REVIEW_TEXTS.showResultsFirst, r.id);
+  switch (r.status) {
+    case 'in-review':
+      return undefined;
+    case 'withdrawn':
+      return refused(REVIEW_TEXTS.withdrawnStays(label), r.id);
+    case 'to-be-redone':
+      if (isReverted(r)) return refused(REVIEW_TEXTS.contentTakenOut, r.id);
+      w.touch(r.id);
+      r.status = 'in-review';
+      delete r.redo;
+      delete r.decline;
+      return undefined;
+    case 'accepted':
+      w.touch(r.id);
+      r.status = 'in-review';
+      delete r.accepted;
+      cascadeBack(w, r.id);
+      return undefined;
+    case 'declined': {
+      w.touch(r.id);
+      const unreject = isDeclinedOut(r);
+      delete r.decline;
+      // Content a cascade took out before the decline stays out: back to be redone, not in review (D2-60).
+      r.status = isReverted(r) ? 'to-be-redone' : 'in-review';
+      if (!unreject) return undefined;
+      const keys = new Set(rejectedKeysOf(r));
+      r.rejectedFingerprints = r.rejectedFingerprints.filter((k) => !keys.has(k));
+      const ends = isArrowKind(r.kind) ? arrowOf(r) : undefined;
+      if (ends !== undefined && w.rejectedArrows.some((a) => sameArrow(a, ends))) {
+        w.rejectedArrows = w.rejectedArrows.filter((a) => !sameArrow(a, ends));
+        w.arrowsRemoved.push({ ...ends });
+      }
+      // The dependents its decline took out come back, to be redone without revert (D2-60); a premise merges nothing (AF2).
+      if (r.status !== 'in-review' || r.kind === 'add-premise') return undefined;
+      for (const x of w.items) {
+        if (x.status !== 'to-be-redone' || !isReverted(x) || !(x.redo?.because ?? []).includes(r.id)) continue;
+        const rest = (x.redo?.because ?? []).filter((id) => id !== r.id);
+        const stillOut = rest.some((id) => {
+          const taker = w.byId.get(id);
+          return taker !== undefined && (isDeclinedOut(taker) || isReverted(taker));
+        });
+        w.touch(x.id);
+        x.redo = stillOut ? { because: rest, reverted: true } : { because: x.redo?.because ?? [r.id], reverted: false };
+        if (!w.why.has(x.id)) w.why.set(x.id, REVIEW_TEXTS.cascadeWhy(label));
+      }
+      return undefined;
+    }
+  }
+}
+
+/** Accepts `r` (its status, rules and hold-as were checked). */
+function accept(w: Work, r: ItemRecord, d: ItemDecision, how: 'own' | 'group', shown: boolean, at: string): void {
+  w.touch(r.id);
+  const cls = w.classOf(r, shown);
+  r.status = 'accepted';
+  delete r.decline;
+  delete r.redo;
+  const result = r.kind === 'result' && w.state.results !== undefined && Object.hasOwn(w.state.results, r.id) ? w.state.results[r.id] : undefined;
+  r.accepted = {
+    how,
+    fingerprint: r.fingerprint,
+    belief: cls.belief,
+    changesProved: cls.changesProved,
+    at,
+    ...(result !== undefined ? { result: { verdict: result.verdict, restsOn: [...result.restsOn] } } : {}),
+    ...(r.kind === 'add-premise' && d.holdAs !== undefined
+      ? { holdAs: d.holdAs, ...(d.rationale !== undefined && d.rationale.trim() !== '' ? { rationale: d.rationale } : {}) }
+      : {}),
+  };
+}
+
+/** An own Accept's checks (§4.6's first row, §3.8). */
+function ownAcceptRefusal(w: Work, r: ItemRecord, d: ItemDecision, shown: boolean): ReviewOutcome | undefined {
+  const label = w.label(r.id);
+  if (hiddenIn(shown)(r)) return refused(REVIEW_TEXTS.showResultsFirst, r.id);
+  if (r.status !== 'in-review') return refused(REVIEW_TEXTS.leftNotInReview(label), r.id);
+  if (w.state.didNotPass) return refused(REVIEW_TEXTS.acceptDidNotPass, r.id);
+  const gate = dependencyGate(w, r, shown);
+  if (gate.missing.length > 0)
+    return refused(
+      REVIEW_TEXTS.acceptNeedsDependencies(
+        label,
+        gate.missing.map((id) => w.label(id)),
+      ),
+      r.id,
+    );
+  if (gate.waits) return refused(REVIEW_TEXTS.acceptWaitsForResults(label), r.id);
+  if (r.kind === 'add-premise') {
+    const sentence = premiseSentence(r);
+    if (d.holdAs === undefined) return refused(REVIEW_TEXTS.holdAsMissing(sentence), r.id);
+    if (r.card !== undefined && d.holdAs === 'pending') return refused(REVIEW_TEXTS.writtenAsAxiom(sentence), r.id);
+  }
+  return undefined;
+}
+
+/** D2-23: when an action shows the results, `classes` is in force: accepted items whose badges grew return to review. */
+function badgesGrew(w: Work): void {
+  for (const r of w.items) {
+    if (r.status !== 'accepted' || r.accepted === undefined) continue;
+    const cls = w.classOf(r, true);
+    if (!((cls.belief && !r.accepted.belief) || (cls.changesProved && !r.accepted.changesProved))) continue;
+    w.touch(r.id);
+    r.status = 'in-review';
+    delete r.accepted;
+    w.grew.push(r.id);
+    w.why.set(r.id, REVIEW_TEXTS.cascadeWhyOwnAccept);
+    cascadeBack(w, r.id);
+  }
+}
+
+/** The ws/ changes of the items an action touched (§2.9 `ItemWrite`), or null when it touched none. */
+function writeOf(w: Work, ids: readonly string[], action: number): ItemWrite | null {
+  const write: ItemWrite = { action, revert: [], reapply: [], premises: { write: [], takeOut: [] } };
+  for (const id of ids) {
+    const r = w.byId.get(id) as ItemRecord;
+    const first = w.start.get(id)?.state;
+    if (first === undefined) continue;
+    const before = inWorkingCopy(r.kind, first, r.card);
+    const after = inWorkingCopy(r.kind, r, r.card, first);
+    if (r.kind === 'add-premise') {
+      if (first.status !== 'accepted' && r.status === 'accepted' && r.card === undefined) write.premises.write.push(id);
+      if (before && !after) write.premises.takeOut.push(id);
+      continue;
+    }
+    if (before && !after) write.revert.push(id);
+    if (!before && after) write.reapply.push(id);
+  }
+  const empty = write.revert.length + write.reapply.length + write.premises.write.length + write.premises.takeOut.length === 0;
+  return empty ? null : write;
+}
+
+/** A meaning item became undecided (§4.7): it ends Show results' force. */
+function anyBecameUndecided(w: Work, ids: readonly string[]): boolean {
+  return ids.some((id) => {
+    const r = w.byId.get(id) as ItemRecord;
+    const first = w.start.get(id)?.state;
+    return first !== undefined && isMeaningItem(r, w.state.classesBeforeReveal) && !isUndecided(first) && isUndecided(r);
+  });
+}
+
+/** Accept items lose: those that were accepted when the action started and are not now. */
+function lostAccepts(w: Work): string[] {
+  return [...w.start]
+    .filter(([id, first]) => first.state.status === 'accepted' && w.byId.get(id)?.status !== 'accepted')
+    .map(([id]) => id);
+}
+
+/** CascadeEntries of listed items whose status changed besides the decided ones. */
+function cascadeEntries(w: Work, ids: readonly string[], decided: ReadonlySet<string>, shown: boolean): CascadeEntry[] {
+  const hidden = hiddenIn(shown);
+  const out: CascadeEntry[] = [];
+  for (const id of ids) {
+    if (decided.has(id)) continue;
+    const r = w.byId.get(id) as ItemRecord;
+    if (hidden(r) || w.start.get(id)?.state.status === r.status) continue;
+    out.push({ item: id, to: r.status, why: w.why.get(id) ?? REVIEW_TEXTS.cascadeWhy(w.label(id)) });
+  }
+  return out;
+}
+
+/** The confirmation an action that takes Accepts away asks first (§3.6, D2-64), or undefined. */
+function confirmation(w: Work, decided: ReadonlySet<string>, shown: boolean): ReviewOutcome | undefined {
+  const hidden = hiddenIn(shown);
+  const lost = lostAccepts(w).filter((id) => !hidden(w.byId.get(id) as ItemRecord));
+  const others = lost.filter((id) => !decided.has(id));
+  const ask = shown ? others.length > 0 : lost.length > 0;
+  if (!ask) return undefined;
+  return {
+    ok: false,
+    code: 'needs-confirmation',
+    cascade: cascadeEntries(w, others, decided, shown),
+    ...(shown ? {} : { hiddenResults: true as const }),
+  };
+}
+
+/** The events of an action's own effects (never about a hidden item): its unconfirmed cascade and D2-23. */
+function actionEvents(w: Work, ids: readonly string[], decided: ReadonlySet<string>, shown: boolean): Ok['events'] {
+  const hidden = hiddenIn(shown);
+  const listed = (id: string) => !hidden(w.byId.get(id) as ItemRecord);
+  const grew = new Set(w.grew);
+  const redone = ids.filter((id) => {
+    if (decided.has(id) || grew.has(id) || !listed(id)) return false;
+    const first = w.start.get(id)?.state;
+    return first !== undefined && first.status !== 'accepted' && first.status !== 'to-be-redone' && w.byId.get(id)?.status === 'to-be-redone';
+  });
+  const events: Ok['events'] = [];
+  if (redone.length > 0) events.push({ text: REVIEW_TEXTS.eventRedoneWith, items: redone });
+  const returned = w.grew.filter(listed);
+  if (returned.length > 0) events.push({ text: REVIEW_TEXTS.eventBadgesGrew, items: returned });
+  return events;
+}
+
+/** The stack label of a decide action. */
+function decideLabel(w: Work, decisions: readonly ItemDecision[], taken: readonly string[]): string {
+  const kinds = new Set(decisions.filter((d) => taken.includes(d.item)).map((d) => d.to));
+  const n = taken.length;
+  const first = taken[0] ?? '';
+  if (kinds.size === 1 && kinds.has('accepted')) {
+    if (n !== 1) return REVIEW_TEXTS.undoAcceptN(n);
+    const r = w.byId.get(first) as ItemRecord;
+    const holdAs = r.accepted?.holdAs;
+    if (r.kind === 'add-premise' && holdAs !== undefined) return REVIEW_TEXTS.undoAcceptPremise(premiseSentence(r), holdAs);
+    return REVIEW_TEXTS.undoAccept(w.label(first));
+  }
+  if (kinds.size === 1 && kinds.has('declined')) {
+    const options = new Set(taken.map((id) => w.byId.get(id)?.decline?.option ?? 'reject'));
+    const option = options.size === 1 ? ([...options][0] as DeclineOption) : 'reject';
+    return n === 1 ? REVIEW_TEXTS.undoDecline(w.label(first), option) : REVIEW_TEXTS.undoDeclineN(n, option);
+  }
+  if (kinds.size === 1 && kinds.has('in-review')) return n === 1 ? REVIEW_TEXTS.undoBackToReview(w.label(first)) : REVIEW_TEXTS.undoBackToReviewN(n);
+  return REVIEW_TEXTS.undoDecideN(n);
+}
+
+function copyDecision(d: ItemDecision): ItemDecision {
+  return {
+    item: d.item,
+    rev: d.rev,
+    to: d.to,
+    ...(d.option !== undefined ? { option: d.option } : {}),
+    ...(d.note !== undefined ? { note: d.note } : {}),
+    ...(d.holdAs !== undefined ? { holdAs: d.holdAs } : {}),
+    ...(d.rationale !== undefined ? { rationale: d.rationale } : {}),
+  };
+}
+
+/** An ok outcome that changes nothing (a group Accept that took nothing, a no-op). */
+function unchanged(state: ReviewState, left: Ok['left'] = []): ReviewOutcome {
+  return {
+    ok: true,
+    items: state.items.map(cloneRecord),
+    inferences: state.inferences.map((inf) => ({ ...inf, question: { ...inf.question, sources: [...inf.question.sources] }, steps: [...inf.steps] })),
+    rejectedArrows: state.rejectedArrows.map((a) => ({ ...a })),
+    forced: state.forced,
+    stack: state.stack,
+    nextAction: state.nextAction,
+    label: '',
+    taken: [],
+    left,
+    cascade: [],
+    events: [],
+    write: null,
+  };
+}
+
+// ---------------------------------------------------------------------------------------------
+// The actions
+
+interface DecideRequest {
+  decisions: readonly ItemDecision[];
+  own: boolean;
+  confirmed: boolean;
+}
+
+/** decide (§4.6): accept, decline, back to review, un-reject; `redo`: Redo's re-run, which keeps the rest of `undone`. */
+function decide(state: ReviewState, request: DecideRequest, at: string, redo: { undone: readonly SessionAction[] } | undefined): ReviewOutcome {
+  const w = new Work(state);
+  const shown = w.reveal().shown;
+  // The decisions, once each, against the version the user saw.
+  const decisions: ItemDecision[] = [];
+  for (const d of request.decisions) {
+    if (decisions.some((x) => x.item === d.item)) continue;
+    const r = w.byId.get(d.item);
+    if (r === undefined) return conflict(REVIEW_TEXTS.conflict(d.item), d.item);
+    if (d.rev !== r.rev) {
+      if (d.to === 'in-review' && r.versions.some((v) => v.rev === d.rev && v.rejected === true)) return refused(REVIEW_TEXTS.unrejectNewer, r.id);
+      return conflict(REVIEW_TEXTS.conflict(w.label(r.id)), r.id);
+    }
+    decisions.push(d);
+  }
+  const own = request.own && decisions.length === 1;
+  const decided = new Set<string>();
+  // Declines and backs to review first, in the order sent; then the Accepts, on what they left.
+  for (const d of decisions) {
+    if (d.to === 'accepted') continue;
+    const refusal = d.to === 'declined' ? decline(w, d, shown, at) : backToReview(w, d, shown);
+    if (refusal !== undefined) return refusal;
+    decided.add(d.item);
+  }
+  const accepts = decisions.filter((d) => d.to === 'accepted');
+  let left: Ok['left'] = [];
+  if (own && accepts.length === 1) {
+    const d = accepts[0] as ItemDecision;
+    const r = w.byId.get(d.item) as ItemRecord;
+    const refusal = ownAcceptRefusal(w, r, d, shown);
+    if (refusal !== undefined) return refusal;
+    accept(w, r, d, 'own', shown, at);
+    decided.add(r.id);
+  } else if (accepts.length > 0) {
+    const items = w.items.map((r) => groupItemOf(w, r, shown));
+    const plan = planGroupAccept(
+      items,
+      accepts.map((d) => d.item),
+    );
+    for (const id of plan.take) {
+      const d = accepts.find((x) => x.item === id) as ItemDecision;
+      accept(w, w.byId.get(id) as ItemRecord, d, 'group', shown, at);
+      decided.add(id);
+    }
+    left = plan.left;
+  }
+  if (redo !== undefined && left.length > 0) {
+    const first = left[0] as { item: string; reason: GroupLeftReason };
+    return refused(leftText(w, first.item, first.reason, shown), first.item);
+  }
+
+  if (!request.confirmed) {
+    const ask = confirmation(w, decided, shown);
+    if (ask !== undefined) return ask;
+  }
+  // Show results' force ends when a meaning item becomes undecided (§4.7); an action that shows them applies D2-23.
+  const forced = w.forced;
+  let endedForce: SessionForce | undefined;
+  if (forced !== null && anyBecameUndecided(w, w.changed())) {
+    endedForce = forced;
+    w.forced = null;
+  }
+  if (!shown && w.reveal().shown) badgesGrew(w);
+
+  const ids = w.changed();
+  if (ids.length === 0 && w.questions.length === 0 && w.arrowsAdded.length === 0 && w.arrowsRemoved.length === 0) return unchanged(state, left);
+  const taken = [...decided].filter((id) => ids.includes(id));
+  const id = state.nextAction;
+  const label = decideLabel(w, decisions, taken.length > 0 ? taken : [...decided]);
+  const action: SessionAction = {
+    id,
+    kind: 'decide',
+    label,
+    request: { decisions: request.decisions.map(copyDecision), own: request.own },
+    changes: ids.map((item) => {
+      const first = w.start.get(item) as { rev: number; state: ItemState };
+      return { item, rev: first.rev, before: first.state, after: itemStateOf(w.byId.get(item) as ItemRecord) };
+    }),
+    takenOut: [],
+    rejectedArrows: { added: w.arrowsAdded, removed: w.arrowsRemoved },
+    questions: w.questions,
+    ...(endedForce !== undefined ? { endedForce } : {}),
+    commits: [],
+    at,
+  };
+  const shownAfter = w.reveal().shown;
+  return {
+    ok: true,
+    items: w.items,
+    inferences: w.inferences,
+    rejectedArrows: w.rejectedArrows,
+    forced: w.forced,
+    stack: { done: [...state.stack.done, action], undone: redo !== undefined ? [...redo.undone] : [] },
+    nextAction: id + 1,
+    label,
+    taken,
+    left,
+    cascade: cascadeEntries(w, ids, decided, shownAfter),
+    events: actionEvents(w, ids, decided, shownAfter),
+    write: writeOf(w, ids, id),
+  };
+}
+
+/** Show results (RV-6, §4.7): every Result of the stage at once, noted as seen early; D2-23 with `classes`. */
+function reveal(state: ReviewState, via: SessionForce['via'], at: string, redo: { undone: readonly SessionAction[] } | undefined): ReviewOutcome {
+  const w = new Work(state);
+  const before = w.reveal();
+  if (before.shown && redo === undefined) return unchanged(state);
+  const force: SessionForce = { via, at };
+  w.forced = force;
+  if (before.waitingFor.length > 0) {
+    for (const r of w.items) {
+      if (r.kind !== 'result' || r.markers.includes('seen-early')) continue;
+      w.touch(r.id);
+      r.markers = [...r.markers, 'seen-early'];
+    }
+  }
+  if (!before.shown) badgesGrew(w);
+  const ids = w.changed();
+  const id = state.nextAction;
+  const action: SessionAction = { id, kind: 'reveal', label: REVIEW_TEXTS.showResults, force };
+  return {
+    ok: true,
+    items: w.items,
+    inferences: w.inferences,
+    rejectedArrows: w.rejectedArrows,
+    forced: w.forced,
+    stack: { done: [...state.stack.done, action], undone: redo !== undefined ? [...redo.undone] : [] },
+    nextAction: id + 1,
+    label: action.label,
+    taken: [],
+    left: [],
+    cascade: cascadeEntries(w, ids, new Set(), true),
+    events: actionEvents(w, ids, new Set(), true),
+    write: writeOf(w, ids, id),
+  };
+}
+
+/** A move on the Proposed view (D2-33): one stack step; the runner keeps the positions. */
+function move(
+  state: ReviewState,
+  before: Readonly<Record<string, CanvasPosition | null>>,
+  after: Readonly<Record<string, CanvasPosition>>,
+  at: string,
+  redo: { undone: readonly SessionAction[] } | undefined,
+): ReviewOutcome {
+  const cards = Object.keys(after).sort();
+  const name = (card: string) => (state.labels !== undefined && Object.hasOwn(state.labels, card) ? (state.labels[card] ?? card) : card);
+  const label = cards.length === 1 ? REVIEW_TEXTS.undoMove(name(cards[0] as string)) : REVIEW_TEXTS.undoMoveN(cards.length);
+  const id = state.nextAction;
+  const action: SessionAction = {
+    id,
+    kind: 'move',
+    label,
+    before: Object.fromEntries(Object.entries(before).map(([k, v]) => [k, v === null ? null : { ...v }])),
+    after: Object.fromEntries(Object.entries(after).map(([k, v]) => [k, { ...v }])),
+    at,
+  };
+  const out = unchanged(state) as Ok;
+  return { ...out, stack: { done: [...state.stack.done, action], undone: redo !== undefined ? [...redo.undone] : [] }, nextAction: id + 1, label };
+}
+
+/** A seal (UN-5): every queue of Claude steps starts with one; Undo stops at it, and it clears Redo. */
+function seal(state: ReviewState, by: SealBy, at: string): ReviewOutcome {
+  const id = state.nextAction;
+  const out = unchanged(state) as Ok;
+  return { ...out, stack: { done: [...state.stack.done, { id, kind: 'seal', by, at }], undone: [] }, nextAction: id + 1 };
+}
+
+/** The markers an Undo leaves: what the action added taken away, what it removed put back; others' markers stay. */
+function undoneMarkers(now: readonly string[], before: readonly string[], after: readonly string[]): ItemState['markers'] {
+  const added = after.filter((m) => !before.includes(m));
+  const removed = before.filter((m) => !after.includes(m));
+  return [...new Set([...now.filter((m) => !added.includes(m)), ...removed])] as ItemState['markers'];
+}
+
+/** Undo (UN-4, D2-73): the inverse of the top action, through the rules. */
+function undo(state: ReviewState, step: number, confirmed: boolean): ReviewOutcome {
+  const done = state.stack.done;
+  const top = done[done.length - 1];
+  if (top === undefined || top.id !== step) return conflict(REVIEW_TEXTS.conflict(top !== undefined && top.kind !== 'seal' ? top.label : 'Undo'));
+  if (top.kind === 'seal') return refused(REVIEW_TEXTS.sealed);
+  const stack = { done: done.slice(0, -1), undone: [...state.stack.undone, top] };
+  if (top.kind === 'move') return { ...(unchanged(state) as Ok), stack, label: top.label };
+  if (top.kind === 'reveal') {
+    // Undo removes the force; the seen-early markers stay (UN-4). D2-23's returns were telelean's, and stay.
+    const same = state.forced !== null && state.forced.at === top.force.at && state.forced.via === top.force.via;
+    return { ...(unchanged(state) as Ok), forced: same ? null : state.forced, stack, label: top.label };
+  }
+  const w = new Work(state);
+  const shown = w.reveal().shown;
+  for (const c of top.changes) {
+    const r = w.byId.get(c.item);
+    if (r === undefined) return conflict(REVIEW_TEXTS.conflict(c.item), c.item);
+    if (r.rev !== c.rev || decisionKey(itemStateOf(r)) !== decisionKey(c.after)) return conflict(REVIEW_TEXTS.conflict(w.label(r.id)), r.id);
+  }
+  // D2-8: the items the action decided (a group's left items are no decision) may not be hidden now.
+  for (const id of decidedBy(top)) {
+    const r = w.byId.get(id);
+    if (r !== undefined && hiddenIn(shown)(r)) return refused(REVIEW_TEXTS.showResultsFirst, r.id);
+  }
+  // Restore what the action recorded.
+  for (const c of top.changes) {
+    const r = w.touch(c.item);
+    applyItemState(r, { ...c.before, markers: undoneMarkers(r.markers, c.before.markers, c.after.markers) });
+  }
+  for (const q of top.questions) {
+    const inference = w.inferences.find((inf) => inf.target === q.target);
+    if (inference !== undefined) inference.question = { sources: [...q.before.sources], fromNothing: q.before.fromNothing };
+  }
+  w.rejectedArrows = w.rejectedArrows.filter((a) => !top.rejectedArrows.added.some((x) => sameArrow(a, x)));
+  for (const a of top.rejectedArrows.removed) if (!w.rejectedArrows.some((x) => sameArrow(a, x))) w.rejectedArrows.push({ ...a });
+  if (top.endedForce !== undefined && w.forced === null) w.forced = top.endedForce;
+  // RV-5's list, as by hand: accepted items that depend on an Accept the Undo takes away lose theirs too.
+  const restored = new Set(top.changes.map((c) => c.item));
+  for (const c of top.changes) {
+    if (c.after.status === 'accepted' && c.before.status !== 'accepted') cascadeBack(w, c.item);
+  }
+  // The restored Accepts must pass the rules now (AF13): a judge may have changed what they rest on since. A hidden
+  // item's refusal names no hidden item: it names the action (D2-64).
+  const shownAfter = w.reveal().shown;
+  const hiddenAfter = hiddenIn(shownAfter);
+  for (const c of top.changes) {
+    if (c.before.status !== 'accepted' || c.after.status === 'accepted') continue;
+    const r = w.byId.get(c.item) as ItemRecord;
+    if (w.state.didNotPass) return refused(REVIEW_TEXTS.acceptDidNotPass, hiddenAfter(r) ? undefined : r.id);
+    const gate = dependencyGate(w, r, shownAfter);
+    const cls = w.classOf(r, shownAfter);
+    const ownNeeded = c.before.accepted?.how === 'group' && (cls.belief || cls.changesProved);
+    if (hiddenAfter(r)) {
+      if (gate.missing.length > 0 || ownNeeded) return conflict(REVIEW_TEXTS.conflict(top.label));
+      continue;
+    }
+    if (gate.missing.length > 0) {
+      return refused(
+        REVIEW_TEXTS.acceptNeedsDependencies(
+          w.label(r.id),
+          gate.missing.map((id) => w.label(id)),
+        ),
+        r.id,
+      );
+    }
+    if (gate.waits) return refused(REVIEW_TEXTS.acceptWaitsForResults(w.label(r.id)), r.id);
+    if (ownNeeded) return refused(cls.belief ? REVIEW_TEXTS.leftOwnAccept(w.label(r.id)) : REVIEW_TEXTS.leftOwnAcceptProved(w.label(r.id)), r.id);
+  }
+  const decided = new Set(decidedBy(top).filter((id) => restored.has(id)));
+  if (!confirmed) {
+    const ask = confirmation(w, decided, shown);
+    if (ask !== undefined) return ask;
+  }
+  if (w.forced !== null && anyBecameUndecided(w, w.changed())) w.forced = null;
+  if (!shown && w.reveal().shown) badgesGrew(w);
+  const ids = w.changed();
+  const after = w.reveal().shown;
+  return {
+    ok: true,
+    items: w.items,
+    inferences: w.inferences,
+    rejectedArrows: w.rejectedArrows,
+    forced: w.forced,
+    stack,
+    nextAction: state.nextAction,
+    label: top.label,
+    taken: [...decided],
+    left: [],
+    cascade: cascadeEntries(w, ids, decided, after),
+    events: actionEvents(w, ids, decided, after),
+    write: writeOf(w, ids, top.id),
+  };
+}
+
+/** Redo (UN-4, AF13): the undone action's request again, through the rules, on the current state. */
+function redoAction(state: ReviewState, step: number, confirmed: boolean, at: string): ReviewOutcome {
+  const undone = state.stack.undone;
+  const top = undone[undone.length - 1];
+  if (top === undefined || top.id !== step) return conflict(REVIEW_TEXTS.conflict(top !== undefined && top.kind !== 'seal' ? top.label : 'Redo'));
+  const rest = { undone: undone.slice(0, -1) };
+  const base: ReviewState = { ...state, stack: { done: state.stack.done, undone: rest.undone } };
+  switch (top.kind) {
+    case 'decide': {
+      // The decisions the action carried out, sent again: what a group left then is not asked for now (AF13).
+      const decided = new Set(decidedBy(top));
+      return decide(base, { decisions: top.request.decisions.filter((d) => decided.has(d.item)), own: top.request.own, confirmed }, at, rest);
+    }
+    case 'reveal':
+      return reveal(base, top.force.via, at, rest);
+    case 'move':
+      return move(base, top.before, top.after, at, rest);
+    case 'seal':
+      return conflict(REVIEW_TEXTS.conflict('Redo'));
+  }
+}
+
+/** §4.6 (2a2): one review action on the records, with every effect it has (the types are in §2.9). */
+export function reduceReview(state: ReviewState, action: ReviewAction, at: string): ReviewOutcome {
+  switch (action.kind) {
+    case 'decide':
+      return decide(state, action, at, undefined);
+    case 'reveal':
+      return reveal(state, action.via, at, undefined);
+    case 'move':
+      return move(state, action.before, action.after, at, undefined);
+    case 'undo':
+      return undo(state, action.step, action.confirmed);
+    case 'redo':
+      return redoAction(state, action.step, action.confirmed, at);
+    case 'seal':
+      return seal(state, action.by, at);
+  }
+}
+
+/**
+ * An item's Accept gate for the view (2c2) and the host's early answers: why its Accept is refused now, or ok. `own`:
+ * the item's own Accept (the detail's), else a group's. The same rules `reduceReview` applies.
+ */
+export function acceptGate(state: ReviewState, id: string, own: boolean): { ok: true } | { ok: false; reason: GroupLeftReason; text: string; missing: string[] } {
+  const w = new Work(state);
+  const shown = w.reveal().shown;
+  const r = w.byId.get(id);
+  if (r === undefined) return { ok: false, reason: 'not-in-review', text: REVIEW_TEXTS.conflict(id), missing: [] };
+  const g = groupItemOf(w, r, shown);
+  const gate = dependencyGate(w, r, shown);
+  let reason: GroupLeftReason | undefined;
+  if (g.hidden) reason = 'hidden-result';
+  else if (r.status !== 'in-review') reason = 'not-in-review';
+  else if (!own && g.ownAccept) reason = 'own-accept';
+  else if (state.didNotPass || gate.waits) reason = 'blocked';
+  else if (gate.missing.length > 0) reason = 'depends';
+  if (reason === undefined) return { ok: true };
+  return { ok: false, reason, text: leftText(w, id, reason, shown), missing: reason === 'depends' ? gate.missing : [] };
+}
diff --git a/packages/core/src/review/reveal.ts b/packages/core/src/review/reveal.ts
