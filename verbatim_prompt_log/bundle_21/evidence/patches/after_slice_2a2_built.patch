+++ b/packages/webview/src/board/runAction.ts
@@ -0,0 +1,114 @@
+/**
+ * What an action of the right-click menu (CM-7) or of the Context Menu section (CM-1–CM-5, slice 1e) does: one runner
+ * for both, so the two never drift apart. `thing` is what the action is about: the thing under the pointer for the
+ * menu; for the section, the one selected card (its actions), or null (Formalize and Delete act on the selection).
+ */
+import type { TlNode } from '@telelean/core';
+import type { BoardActions, BoardStore } from '../state/store';
+import type { CanvasView } from './canvas/CanvasView';
+import { tidyLayout } from './CanvasToolbar';
+import type { ContextAction } from './contextActions';
+import type { MenuThing } from './menu';
+
+export interface ActionDeps {
+  actions: BoardActions;
+  store: BoardStore;
+  /** The cards on screen (the Current board's, or the proposal's in the Proposed view). */
+  nodes: Readonly<Record<string, TlNode>>;
+  /** The canvas, for Fit all and Tidy layout (the right-click menu only). */
+  canvas?: CanvasView;
+}
+
+export function runBoardAction(action: ContextAction, thing: MenuThing | null, deps: ActionDeps): void {
+  const { actions, store, nodes, canvas } = deps;
+  const cardId =
+    thing === null ? null : thing.kind === 'card' || thing.kind === 'mark' ? thing.id : thing.kind === 'arrow' || thing.kind === 'undeclared' ? thing.target : null;
+  const node = cardId ? nodes[cardId] : undefined;
+  switch (action) {
+    case 'formalize':
+      // Slice 1e: the selection is the question (the right click selected the arrow or mark first, CM-7).
+      actions.formalize();
+      return;
+    case 'remove-selection':
+      // The section's Delete: the selected arrows and marks, one Undo step (AR-1).
+      actions.deleteSelectedArrows();
+      return;
+    case 'draw-from-selection':
+      if (cardId) actions.drawArrowsFromSelection(cardId);
+      return;
+    case 'draw-this-arrow':
+      // Slice 1c2: a proof's use nobody drew becomes a drawn arrow (AR-1; into an axiom, AR-6's dialog first).
+      if (thing?.kind === 'undeclared') actions.addArrows(thing.target, [thing.source]);
+      return;
+    case 'from-nothing':
+      if (cardId) actions.setFromNothing(cardId, true);
+      return;
+    case 'remove-from-nothing':
+      if (cardId) actions.setFromNothing(cardId, false);
+      return;
+    case 'select-incoming':
+      if (cardId) actions.selectIncomingArrows(cardId);
+      return;
+    case 'mark-pending':
+      if (cardId) actions.claimPending(cardId);
+      return;
+    case 'legacy-make-proposition':
+      if (node) actions.addArrows(node.id, node.premises);
+      return;
+    case 'legacy-drop-arrows':
+      if (node) actions.removeArrows(node.premises.map((source) => ({ source, target: node.id })));
+      return;
+    case 'move-to-axioms':
+      if (cardId) actions.moveToAxioms(cardId);
+      return;
+    case 'show':
+      if (cardId) actions.revealNode(cardId);
+      return;
+    case 'details':
+      if (cardId) actions.toggleExpanded(cardId);
+      return;
+    case 'open':
+      if (node?.loc) actions.openInEditor(node.loc.file, node.loc.range);
+      return;
+    case 'edit':
+      if (cardId) actions.startEdit(cardId, 'naturalName');
+      return;
+    case 'why':
+      if (cardId) actions.startEdit(cardId, 'rationale');
+      return;
+    case 'delete':
+      if (cardId) actions.openDelete(cardId);
+      return;
+    case 'remove-arrows': {
+      if (thing?.kind !== 'arrow') return;
+      // The selected arrows and marks (CM-7 selected this one first unless it was already part of the selection):
+      // one Delete, as the entry's label says (menu.ts removeSelectionLabel).
+      const s = store.getState();
+      if (s.selectedArrows.some((a) => a.source === thing.source && a.target === thing.target)) actions.deleteSelectedArrows();
+      else actions.removeArrows([{ source: thing.source, target: thing.target }]);
+      return;
+    }
+    case 'show-source':
+      if (thing?.kind === 'arrow' || thing?.kind === 'undeclared') actions.revealNode(thing.source);
+      return;
+    case 'show-target':
+      if (thing?.kind === 'arrow' || thing?.kind === 'undeclared') actions.revealNode(thing.target);
+      return;
+    case 'remove-mark': {
+      if (thing?.kind !== 'mark') return;
+      // Part of the selection: the whole selection goes (arrows too), as the label says.
+      if (store.getState().selectedMarks.includes(thing.id)) actions.deleteSelectedArrows();
+      else actions.setFromNothing(thing.id, false);
+      return;
+    }
+    case 'new-here':
+      if (thing?.kind === 'canvas') actions.newPropositionAt(thing.at);
+      return;
+    case 'fit':
+      canvas?.fitAll();
+      return;
+    case 'tidy':
+      if (canvas) tidyLayout(canvas, store);
+      return;
+  }
+}
diff --git a/packages/webview/src/board/useFormalize.ts b/packages/webview/src/board/useFormalize.ts
new file mode 100644
index 0000000..9fb0509
--- /dev/null
+++ b/packages/webview/src/board/useFormalize.ts
@@ -0,0 +1,22 @@
+/**
+ * Slice 1e: Formalize for dependencies on the current selection (board/contextActions.ts `formalizeState`) for a
+ * component: the Context Menu section and the right-click menu. `useBoard` needs stable values, so the state is built
+ * here from the store's slices (each stable) and memoised.
+ */
+import { useMemo } from 'react';
+import { useBoard } from '../state/context';
+import { formalizeRunBlockOf } from '../state/store';
+import { formalizeState, type FormalizeState } from './contextActions';
+
+export function useFormalize(): FormalizeState {
+  const nodes = useBoard((s) => s.nodes);
+  const edges = useBoard((s) => s.edges);
+  const selectedArrows = useBoard((s) => s.selectedArrows);
+  const selectedMarks = useBoard((s) => s.selectedMarks);
+  const provisional = useBoard((s) => s.provisional);
+  const runBlock = useBoard(formalizeRunBlockOf);
+  return useMemo(
+    () => formalizeState({ nodes, edges, selectedArrows, selectedMarks, provisional, runBlock }),
+    [nodes, edges, selectedArrows, selectedMarks, provisional, runBlock],
+  );
+}
diff --git a/packages/webview/src/board/vocabularyBand.ts b/packages/webview/src/board/vocabularyBand.ts
new file mode 100644
index 0000000..6685155
--- /dev/null
+++ b/packages/webview/src/board/vocabularyBand.ts
@@ -0,0 +1,56 @@
+/**
+ * Spec v4 BD-1 (slice 1c): the band above the board splits the computed vocabulary (D-3) into two columns. The
+ * Definitions column holds today's "Definitions" section (`def`, `abbrev`, `structure`, `inductive`, `class`,
+ * `instance`); the Vocabulary column holds the others (Types, Predicates & relations, Functions, Constants,
+ * Presuppositions, Lemmas, Unmarked axioms, Other). Collapsed, the band is one line that keeps the counts and flags,
+ * e.g. "Vocabulary 9 · 1 hidden assumption · Definitions 4 · 1 needs your endorsement".
+ */
+import type { NodeChangeKind, VocabItem, VocabKind } from '@telelean/core';
+import { VOCAB_SECTIONS } from '../labels';
+
+export const DEFINITIONS_SECTIONS = VOCAB_SECTIONS.filter((section) => section.kind === 'definition');
+export const VOCABULARY_SECTIONS = VOCAB_SECTIONS.filter((section) => section.kind !== 'definition');
+
+const DEFINITION_KINDS: ReadonlySet<VocabKind> = new Set(DEFINITIONS_SECTIONS.map((section) => section.kind));
+
+/** The items of each column, in vocabulary order. */
+export function splitVocabulary(items: readonly VocabItem[]): { vocabulary: VocabItem[]; definitions: VocabItem[] } {
+  return {
+    vocabulary: items.filter((item) => !DEFINITION_KINDS.has(item.kind)),
+    definitions: items.filter((item) => DEFINITION_KINDS.has(item.kind)),
+  };
+}
+
+export interface BandSummary {
+  vocabulary: number;
+  definitions: number;
+  /** Prop-valued axioms with no card (TL104). */
+  hidden: number;
+  /** Definitions on a statement path, which need the user's endorsement (D-4, S-8). */
+  endorse: number;
+  /** Items the proposal adds, per column (the Proposed view's "+N new"). */
+  added: { vocabulary: number; definitions: number };
+}
+
+export function bandSummary(items: readonly VocabItem[], diff: Readonly<Record<string, NodeChangeKind>> = {}): BandSummary {
+  const { vocabulary, definitions } = splitVocabulary(items);
+  const added = (list: readonly VocabItem[]) => list.filter((item) => diff[item.name] === 'added').length;
+  return {
+    vocabulary: vocabulary.length,
+    definitions: definitions.length,
+    hidden: vocabulary.filter((item) => item.kind === 'unmarked-axiom').length,
+    endorse: definitions.filter((item) => item.flags.includes('definitional-choice')).length,
+    added: { vocabulary: added(vocabulary), definitions: added(definitions) },
+  };
+}
+
+/** The collapsed band's line, as words (also its accessible description). */
+export function bandSummaryText(summary: BandSummary): string {
+  const parts = [`Vocabulary ${summary.vocabulary}`];
+  if (summary.hidden > 0) parts.push(`${summary.hidden} hidden assumption${summary.hidden === 1 ? '' : 's'}`);
+  if (summary.added.vocabulary > 0) parts.push(`${summary.added.vocabulary} new`);
+  parts.push(`Definitions ${summary.definitions}`);
+  if (summary.endorse > 0) parts.push(`${summary.endorse} need${summary.endorse === 1 ? 's' : ''} your endorsement`);
+  if (summary.added.definitions > 0) parts.push(`${summary.added.definitions} new`);
+  return parts.join(' · ');
+}
diff --git a/packages/webview/src/header/ContextSection.tsx b/packages/webview/src/header/ContextSection.tsx
new file mode 100644
index 0000000..c9acda6
--- /dev/null
+++ b/packages/webview/src/header/ContextSection.tsx
@@ -0,0 +1,172 @@
+/**
+ * The Context Menu section (spec v4.1 CM-1–CM-5; slice 1e), which replaces the tray at the bottom: one row of fixed
+ * height right below the toolbar, labelled "Context Menu", so selecting never reflows the toolbar. With nothing
+ * selected it reads "Select some items to see possible actions here." (on a board without cards, how to add the first
+ * one). Otherwise the selection in one line ("2 arrows into “X”", "3 cards"; every item on hover, with what the
+ * selected statements presuppose, D-3b), the labelled
+ * **Formalize for dependencies** button (CM-3; disabled with the reason on hover), and the other actions that fit the
+ * selection as icons with their labels on hover. On a narrow window the actions that do not fit go into a "…" menu.
+ * The model is board/contextActions.ts; the actions run through board/runAction.ts, shared with the right-click menu.
+ */
+import { useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { contextActions, CONTEXT_ICONS, fittingActions, FORMALIZE_LABEL, FORMALIZE_TEXTS, selectionCards, summaryTitle as titleWithPresuppositions, type ContextAction, type ContextEntry } from '../board/contextActions';
+import type { MenuThing } from '../board/menu';
+import { runBoardAction } from '../board/runAction';
+import { useFormalize } from '../board/useFormalize';
+import { Popover } from '../common/Popover';
+import { presuppositionLabel, presuppositionsOf } from '../model/cardData';
+import { useBoard, useBoardActions, useBoardStore } from '../state/context';
+import { boardView, editLock, proposedOverlay } from '../state/store';
+
+/** The icon buttons' width and the "…" button's (px), for the narrow window's overflow (CM-3). */
+const ICON_WIDTH = 26;
+const MORE_WIDTH = 26;
+
+/** What the section shows on a board without cards (the tray's first-step hint before 1e). */
+function FirstStep() {
+  return (
+    <span className="tl-context__empty tl-context__empty--start" data-testid="first-step">
+      <span className="codicon codicon-arrow-down" aria-hidden="true" /> No cards yet: type something you believe in the box below and press Enter. It becomes
+      your first axiom.
+    </span>
+  );
+}
+
+export function ContextSection() {
+  const nodes = useBoard((s) => boardView(s).nodes);
+  const selected = useBoard((s) => s.selected);
+  const selectedArrows = useBoard((s) => s.selectedArrows);
+  const selectedMarks = useBoard((s) => s.selectedMarks);
+  const expanded = useBoard((s) => s.expanded);
+  const provisional = useBoard((s) => s.provisional);
+  const lock = useBoard((s) => editLock(s));
+  const proposed = useBoard((s) => proposedOverlay(s) !== null);
+  const starting = useBoard((s) => s.runBusy?.action === 'start');
+  const empty = useBoard((s) => s.version !== null && Object.keys(s.nodes).length === 0);
+  const subject = useBoard((s) => s.subject);
+  const vocab = useBoard((s) => s.vocab);
+  const formalize = useFormalize();
+  const actions = useBoardActions();
+  const store = useBoardStore();
+  const model = useMemo(
+    () => contextActions({ nodes, selected, selectedArrows, selectedMarks, expanded, provisional, lock, proposed }, formalize),
+    [nodes, selected, selectedArrows, selectedMarks, expanded, provisional, lock, proposed, formalize],
+  );
+
+  // D-3b (the tray's "+ presupposes" chips before 1e): what the selection's statements presuppose, on the summary's
+  // hover: the question's cards (the selected arrows' ends, the marked cards) and the selected cards (fixer 1e).
+  const presupposes = useMemo(
+    () => presuppositionsOf(selectionCards({ nodes, selected, selectedArrows, selectedMarks }), nodes).map((name) => presuppositionLabel(name, subject, vocab)),
+    [selected, selectedArrows, selectedMarks, nodes, subject, vocab],
+  );
+  const summaryTitle = model.summary === null ? '' : titleWithPresuppositions(model.summary, presupposes);
+
+  // CM-3: on a narrow window the actions that do not fit go into the "…" menu.
+  const actionsRef = useRef<HTMLSpanElement>(null);
+  const [room, setRoom] = useState<number | null>(null);
+  useLayoutEffect(() => {
+    const element = actionsRef.current;
+    if (!element || typeof ResizeObserver === 'undefined') return;
+    const measure = () => setRoom(element.clientWidth);
+    measure();
+    const observer = new ResizeObserver(measure);
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [model.summary !== null]);
+  const shown = room === null ? model.entries.length : fittingActions(room, model.entries.length, ICON_WIDTH, MORE_WIDTH);
+  const visible = model.entries.slice(0, shown);
+  const overflow = model.entries.slice(shown);
+  const [moreAnchor, setMoreAnchor] = useState<HTMLElement | null>(null);
+
+  /** One selected card (the model's, the same the entries were built for): its actions are about it; Formalize and Delete act on the selection. */
+  const card = model.card;
+  const run = (action: ContextAction) => {
+    setMoreAnchor(null);
+    const thing: MenuThing | null = card !== null ? { kind: 'card', id: card } : null;
+    runBoardAction(action, thing, { actions, store, nodes });
+  };
+
+  if (model.summary === null) {
+    return (
+      <section className="tl-context" aria-label="Context Menu" data-testid="context-menu" data-empty="true">
+        <span className="tl-context__label">Context Menu</span>
+        {empty ? <FirstStep /> : <span className="tl-context__empty" data-testid="context-empty">{FORMALIZE_TEXTS.empty}</span>}
+      </section>
+    );
+  }
+
+  const icon = (entry: ContextEntry, menu: boolean) =>
+    menu ? (
+      <button
+        key={entry.action}
+        type="button"
+        role="menuitem"
+        className="tl-menu__item"
+        data-action={entry.action}
+        disabled={entry.disabled !== null}
+        title={entry.disabled ?? undefined}
+        onClick={() => run(entry.action)}
+      >
+        <span className={`codicon codicon-${CONTEXT_ICONS[entry.action]}`} aria-hidden="true" /> <span className="tl-menu__text">{entry.label}</span>
+      </button>
+    ) : (
+      <button
+        key={entry.action}
+        type="button"
+        className="tl-icon-button tl-icon-button--toolbar"
+        data-action={entry.action}
+        aria-label={entry.label}
+        title={entry.disabled !== null ? `${entry.label}: ${entry.disabled}` : entry.label}
+        disabled={entry.disabled !== null}
+        onClick={() => run(entry.action)}
+      >
+        <span className={`codicon codicon-${entry.icon}`} aria-hidden="true" />
+      </button>
+    );
+
+  return (
+    <section className="tl-context" aria-label="Context Menu" data-testid="context-menu">
+      <span className="tl-context__label">Context Menu</span>
+      <span className="tl-context__summary" data-testid="context-summary" title={summaryTitle}>
+        {model.summary.text}
+      </span>
+      <button
+        type="button"
+        className="tl-button tl-button--small tl-context__formalize"
+        data-testid="formalize"
+        disabled={model.formalize.disabled !== null || starting}
+        title={model.formalize.title}
+        onClick={() => actions.formalize()}
+      >
+        {starting ? <span className="codicon codicon-loading codicon-modifier-spin" aria-hidden="true" /> : null}
+        {FORMALIZE_LABEL}
+      </button>
+      {model.formalize.disabled !== null ? (
+        <span className="tl-context__reason" data-testid="formalize-reason" title={model.formalize.disabled}>
+          {model.formalize.disabled}
+        </span>
+      ) : null}
+      <span className="tl-context__actions" ref={actionsRef} data-testid="context-actions">
+        {visible.map((entry) => icon(entry, false))}
+        {overflow.length > 0 ? (
+          <>
+            <button
+              type="button"
+              className="tl-icon-button tl-icon-button--toolbar"
+              data-testid="context-more"
+              aria-label="More actions"
+              title="More actions"
+              aria-expanded={moreAnchor !== null}
+              onClick={(event) => setMoreAnchor(moreAnchor === null ? event.currentTarget : null)}
+            >
+              <span className="codicon codicon-ellipsis" aria-hidden="true" />
+            </button>
+            <Popover anchor={moreAnchor} open={moreAnchor !== null} onClose={() => setMoreAnchor(null)} role="menu" label="More actions" testId="context-more-menu" className="tl-menu" align="end">
+              {overflow.map((entry) => icon(entry, true))}
+            </Popover>
+          </>
+        ) : null}
+      </span>
+    </section>
+  );
+}
diff --git a/packages/webview/src/header/legend.ts b/packages/webview/src/header/legend.ts
new file mode 100644
index 0000000..c3a55f5
--- /dev/null
+++ b/packages/webview/src/header/legend.ts
@@ -0,0 +1,42 @@
+/**
+ * The board's legend (spec v4 BD-9; D-15: never colour alone), pure so it can be tested: what each entry says and
+ * which swatch it shows. Every swatch differs by a pattern or a glyph as well as by its colour: dots for declared, a
+ * solid line for verified, a hollow head for conditional, a notched head for a mismatch, "λ" on the blue glow, "✓" on the
+ * green one and on the band's seal, "⧗" for a pending proof. (BD-9 also lists "frozen", which comes with FROZEN.)
+ */
+export type LegendSwatch = 'declared' | 'verified' | 'conditional' | 'mismatch' | 'formalised' | 'established' | 'band' | 'pending';
+
+export interface LegendEntry {
+  /** Stable key, rendered as `data-legend`. */
+  key: LegendSwatch;
+  label: string;
+  title: string;
+  /** The glyph the swatch carries besides its colour, if it is not a line pattern. */
+  glyph?: string;
+}
+
+export const LEGEND_ENTRIES: readonly LegendEntry[] = [
+  { key: 'declared', label: 'declared', title: 'You drew this arrow: the target follows, at least in part, from the source (dotted)' },
+  { key: 'verified', label: 'verified by Lean', title: 'A checked proof of the target uses the source (solid)' },
+  { key: 'conditional', label: 'conditional', title: 'The proof takes the source as a hypothesis: proved only if it holds (hollow head)' },
+  {
+    key: 'mismatch',
+    label: 'mismatch',
+    title: 'A proof uses a card you drew no arrow from (TL107): solid, in the warning colour, with a notched head. An arrow the proof does not use stays plain dotted.',
+  },
+  { key: 'formalised', label: 'formalised', title: 'The card has a Lean statement (the blue glow and the "λ Lean" chip)', glyph: 'λ' },
+  {
+    key: 'established',
+    label: 'established',
+    title: 'Proved by Lean all the way down to your axioms, never resting on a pending claim, with current facts (the green glow and the "✓ established" chip)',
+    glyph: '✓',
+  },
+  {
+    key: 'band',
+    label: 'these suffice together',
+    title:
+      'The band binds the arrows a checked proof uses. With ✓: together they suffice (checked by Lean; consistency unchecked). Dashed, without ✓: the proof also rests on something outside it (its tooltip says what).',
+    glyph: '✓',
+  },
+  { key: 'pending', label: 'pending proof', title: 'A proposition whose .holds is still an axiom: assumed until a run proves it (the "pending proof" chip)', glyph: '⧗' },
+];
diff --git a/packages/webview/test/e2e/s1-arrows.spec.ts b/packages/webview/test/e2e/s1-arrows.spec.ts
new file mode 100644
index 0000000..1953e3e
--- /dev/null
+++ b/packages/webview/test/e2e/s1-arrows.spec.ts
@@ -0,0 +1,438 @@
+/**
+ * Spec v4 arrows as board edits (slices 1b, 1c2; AR-1, AR-3, AR-5–AR-8, CM-2, CM-7): drawing an arrow from a card's
+ * handle (the rubber band, the hint before you let go, Esc), into an axiom (AR-6: the impact, then the confirmation;
+ * the card moves to the canvas), "Draw arrows from the selection" in the target's right-click menu, clicking and
+ * Ctrl-clicking arrows, Delete (A16's question when a proof uses one), "follows from nothing" and its ∅ mark, "Move to
+ * axioms" (AR-7) from the menu, "Mark pending" (AR-8), and the selection rectangle. The harness answers every edit ok.
+ */
+import { expect, test } from '@playwright/test';
+import { buildGraph, hostMessage, spyroGraph, spyroProvedGraph, type TlGraph } from '@telelean/core';
+import { edgeKindsGraph, makeNode, mapNode, withStatus } from '../shared/graphs';
+import {
+  arrowHit,
+  arrowPath,
+  boardMenu,
+  canvasPoint,
+  card,
+  cardPoint,
+  checkArrows,
+  clickArrow,
+  columnPoint,
+  contextSection,
+  dragCard,
+  drawArrow,
+  edgePairs,
+  handleOf,
+  list,
+  menuItem,
+  openBoard,
+  order,
+  pointOnArrow,
+  postedOfType,
+  rightClick,
+  send,
+  settle,
+  shotPath,
+  type OpenedBoard,
+} from './helpers';
+
+let board: OpenedBoard | undefined;
+
+test.afterEach(async () => {
+  if (board) expect(await board.problems()).toEqual([]);
+  board = undefined;
+});
+
+const SIDE = 'side-claim';
+const GOAL = 'cynder-not-good';
+
+/** Spyro (or proved Spyro), plus a formalised, unproved proposition with no arrows, right of the goal. */
+function arrowsGraph(version = 1, proved = false): TlGraph {
+  const base = proved ? spyroProvedGraph(version) : spyroGraph(version);
+  const side = makeNode(SIDE, 'PROPOSITION', 'Spyro games avoid dark characters', { proof: { kind: 'none' } });
+  return { ...base, nodes: [...base.nodes, side], positions: { [SIDE]: { x: 760, y: 60 } } };
+}
+
+/**
+ * What the host sends after the arrow SIDE -> new-spyro-pg on the proved board (AR-6): new-spyro-pg a proposition
+ * resting on SIDE, pending proof (its axiom `.holds` stays), and the goal still proved but resting on pending.
+ */
+function afterArrowIntoAxiom(version: number): TlGraph {
+  const base = arrowsGraph(version, true);
+  const nodes = base.nodes.map((n) => {
+    if (n.id === 'new-spyro-pg') return withStatus({ ...n, type: 'PROPOSITION' as const, premises: [SIDE] }, { proof: { kind: 'pending' } });
+    if (n.id === GOAL) return withStatus(n, { flags: ['rests-on-pending'] });
+    return n;
+  });
+  return { ...buildGraph({ subject: 'Spyro', version, nodes, vocabulary: base.vocabulary, semantic: base.semantic }), positions: base.positions ?? {} };
+}
+
+/** Spyro plus SIDE resting on the goal: two canvas cards joined by a drawn arrow that lies wholly on the canvas. */
+function chainGraph(version = 1): TlGraph {
+  const base = spyroGraph(version);
+  const side = makeNode(SIDE, 'PROPOSITION', 'Spyro games avoid dark characters', { proof: { kind: 'none' } }, { premises: [GOAL] });
