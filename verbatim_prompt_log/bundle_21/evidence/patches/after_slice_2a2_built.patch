@@ -0,0 +1,367 @@
+/**
+ * The Vocabulary and Definitions columns above the board (spec v4 BD-1; slice 1c, split from M1's Vocabulary group at
+ * the top of the Axioms column, D-3): box-shaped items grouped by kind, the presuppositions as chips ("assumes
+ * characters exist"), hidden assumptions flagged, definitions that need the user's endorsement flagged. The two columns
+ * scroll on their own. A divider below the band sets its height (kept in the webview state, as a fraction of the board
+ * area); the band collapses to one line that keeps its counts and flags. Items can be highlighted (the band opens, the
+ * item scrolls into view in its column and flashes) from a card's "uses:" dropdown, an identifier in its Lean code, or
+ * the AXIOMS column's "also assumed" line.
+ *
+ * M2: in the proposed view it shows the proposal's vocabulary, with a diff mark (glyph, word, colour, halo) on each
+ * item the proposal adds, changes or removes; the line says "+N new" and the band opens by itself (03 section 7).
+ */
+import type { NodeChangeKind, VocabItem } from '@telelean/core';
+import { memo, useLayoutEffect, useMemo, useRef, useState, type KeyboardEvent, type PointerEvent, type RefObject } from 'react';
+import { KIND_GLYPH, VOCAB_SECTIONS } from '../labels';
+import { presuppositionLabel } from '../model/cardData';
+import { DIFF_GLYPH, DIFF_WORD } from '../model/run';
+import { useBoard, useBoardActions } from '../state/context';
+import { boardView, flashTarget, proposedOverlay, readTopSplit, vocabularyCollapsed } from '../state/store';
+import { revealInColumn } from './reveal';
+import { bandSummary, bandSummaryText, DEFINITIONS_SECTIONS, splitVocabulary, VOCABULARY_SECTIONS } from './vocabularyBand';
+
+const VOCAB_DIFF_TITLE: Readonly<Record<NodeChangeKind, string>> = {
+  added: 'New in the proposal',
+  changed: 'Changed in the proposal',
+  removed: 'Removed by the proposal',
+};
+
+function VocabDiff({ change }: { change: NodeChangeKind }) {
+  return (
+    <span className="tl-diff" data-diff={change} data-testid="diff-badge" title={VOCAB_DIFF_TITLE[change]}>
+      <span className="tl-diff__glyph" aria-hidden="true">
+        {DIFF_GLYPH[change]}
+      </span>
+      {DIFF_WORD[change]}
+    </span>
+  );
+}
+
+const FLAG_TEXT: Readonly<Record<VocabItem['flags'][number], { label: string; title: string; warn: boolean }>> = {
+  'unmarked-assumption': { label: 'hidden assumption', title: 'A Prop-valued axiom with no card: Lean takes it as given (TL104)', warn: true },
+  'shape-violation': { label: 'shape', title: 'Breaks the simple vocabulary rule (TL111)', warn: true },
+  'definitional-choice': { label: 'needs your endorsement', title: 'A definition your statements rely on (D-4: needs your endorsement)', warn: false },
+  stale: { label: 'changed since last check', title: 'Its file changed since Lean last checked it (Lean checks again when the file is saved)', warn: false },
+  new: { label: 'new', title: 'Added by a proposal', warn: false },
+};
+
+/** The `data-highlight` flash token for an item (0 when not flashed); scrolls the item into view when flashed. */
+function useFlash(name: string, element: RefObject<HTMLElement | null>): number {
+  const flashed = useBoard((s) => (s.flash?.target === flashTarget.vocab(name) ? s.flash.token : 0));
+  useLayoutEffect(() => {
+    if (flashed && element.current) revealInColumn(element.current);
+  }, [flashed, element]);
+  return flashed;
+}
+
+function UsedBy({ ids }: { ids: readonly string[] }) {
+  const nodes = useBoard((s) => boardView(s).nodes);
+  const actions = useBoardActions();
+  const present = ids.filter((id) => nodes[id]);
+  if (present.length === 0) return <p className="tl-details__none">No card uses it yet.</p>;
+  return (
+    <ul className="tl-details__list">
+      {present.map((id) => {
+        const node = nodes[id];
+        return node ? (
+          <li key={id}>
+            <button type="button" className="tl-rel" data-rel-id={id} onClick={() => actions.revealNode(id)}>
+              <span className="tl-glyph" data-kind={node.type} aria-hidden="true">
+                {KIND_GLYPH[node.type]}
+              </span>
+              <span className="tl-rel__text">{node.naturalName}</span>
+            </button>
+          </li>
+        ) : null;
+      })}
+    </ul>
+  );
+}
+
+const VocabBox = memo(function VocabBox({ item }: { item: VocabItem }) {
+  const ref = useRef<HTMLDivElement>(null);
+  const flashed = useFlash(item.name, ref);
+  const change = useBoard((s) => proposedOverlay(s)?.diff.vocabulary[item.name]);
+  const actions = useBoardActions();
+  const [open, setOpen] = useState(false);
+  const warn = item.kind === 'unmarked-axiom' || item.flags.some((f) => FLAG_TEXT[f].warn);
+  // The proposal's diff already marks a new item; the "new" flag would say it twice.
+  const flags = change ? item.flags.filter((f) => f !== 'new') : item.flags;
+  return (
+    <div
+      ref={ref}
+      className="tl-vocab__item"
+      data-vocab={item.name}
+      data-kind-vocab={item.kind}
+      data-warn={warn || undefined}
+      data-highlight={flashed ? 'true' : undefined}
+      data-diff={change}
+    >
+      <div className="tl-vocab__head">
+        {change ? <VocabDiff change={change} /> : null}
+        <span className="tl-vocab__name">{item.shortName}</span>
+        {item.type ? (
+          <code className="tl-vocab__type" title={item.type}>
+            {item.type}
+          </code>
+        ) : null}
+        <button
+          type="button"
+          className="tl-card__chevron"
+          aria-expanded={open}
+          aria-label={open ? `Hide ${item.shortName}'s code` : `Show ${item.shortName}'s code and who uses it`}
+          onClick={() => setOpen(!open)}
+        >
+          <span className={`codicon codicon-chevron-${open ? 'down' : 'right'}`} aria-hidden="true" />
+        </button>
+      </div>
+      {item.gloss ? (
+        <div className={item.glossBy === 'agent' ? 'tl-vocab__gloss tl-gloss--agent' : 'tl-vocab__gloss'} data-provenance={item.glossBy === 'agent' ? 'agent' : 'user'}>
+          {item.gloss}
+          {item.glossBy === 'agent' ? <span className="tl-card__agent-marker tl-agent__marker"> (Claude's wording)</span> : null}
+        </div>
+      ) : null}
+      {flags.length > 0 ? (
+        <div className="tl-card__meta">
+          {flags.map((flag) => (
+            <span key={flag} className={`tl-chip${FLAG_TEXT[flag].warn ? ' tl-chip--attention' : ''}`} data-flag={flag} title={FLAG_TEXT[flag].title}>
+              {FLAG_TEXT[flag].label}
+            </span>
+          ))}
+        </div>
+      ) : null}
+      {open ? (
+        <div className="tl-vocab__more">
+          {item.code ? <pre className="tl-lean">{item.code}</pre> : null}
+          <h4 className="tl-details__heading">Used by</h4>
+          <UsedBy ids={item.usedBy} />
+          {item.loc ? (
+            <button type="button" className="tl-icon-button" onClick={() => item.loc && actions.openInEditor(item.loc.file, item.loc.range)}>
+              <span className="codicon codicon-go-to-file" aria-hidden="true" />
+              Open in editor
+            </button>
+          ) : null}
+        </div>
+      ) : null}
+    </div>
+  );
+});
+
+const PresuppositionChip = memo(function PresuppositionChip({ item }: { item: VocabItem }) {
+  const ref = useRef<HTMLSpanElement>(null);
+  const flashed = useFlash(item.name, ref);
+  const subject = useBoard((s) => s.subject);
+  const vocab = useBoard((s) => boardView(s).vocab);
+  const change = useBoard((s) => proposedOverlay(s)?.diff.vocabulary[item.name]);
+  return (
+    <span
+      ref={ref}
+      className="tl-presup tl-vocab__presup"
+      data-vocab={item.name}
+      data-highlight={flashed ? 'true' : undefined}
+      data-diff={change}
+      title={`${item.shortName} : ${item.type ?? ''}${item.gloss ? ` (${item.gloss})` : ''}${change ? ` (${VOCAB_DIFF_TITLE[change].toLowerCase()})` : ''}`}
+    >
+      {change ? (
+        <span className="tl-diff__glyph" aria-label={DIFF_WORD[change]}>
+          {DIFF_GLYPH[change]}
+        </span>
+      ) : null}
+      {presuppositionLabel(item.name, subject, vocab)}
+    </span>
+  );
+});
+
+/** One of the band's two columns: its sections, scrolling on their own. */
+function BandColumn({ title, testId, sections, items, added }: { title: string; testId: string; sections: typeof VOCAB_SECTIONS; items: readonly VocabItem[]; added: number }) {
+  const shown = useMemo(
+    () => sections.map((section) => ({ ...section, items: items.filter((item) => item.kind === section.kind) })).filter((section) => section.items.length > 0),
+    [sections, items],
+  );
+  return (
+    <section className="tl-vcol" data-testid={testId} aria-label={title}>
+      <header className="tl-vcol__header">
+        <h2 className="tl-vcol__title">{title}</h2>
+        <span className="tl-col__count">{items.length}</span>
+        {added > 0 ? (
+          <span className="tl-diff" data-diff="added" title="What the proposal adds">
+            <span className="tl-diff__glyph" aria-hidden="true">
+              +
+            </span>
+            {added} new
+          </span>
+        ) : null}
+      </header>
+      <div className="tl-vcol__list">
+        {shown.length === 0 ? <p className="tl-vcol__empty">None yet.</p> : null}
+        {shown.map((section) => (
+          <div key={section.kind} className="tl-vocab__section" data-section={section.kind}>
+            {/* A column of one section (Definitions) needs no heading of its own. */}
+            {sections.length > 1 ? <h3 className="tl-vocab__heading">{section.title}</h3> : null}
+            {section.kind === 'presupposition' ? (
+              <div className="tl-vocab__chips">
+                {section.items.map((item) => (
+                  <PresuppositionChip key={item.name} item={item} />
+                ))}
+              </div>
+            ) : (
+              <div className="tl-vocab__items">
+                {section.items.map((item) => (
+                  <VocabBox key={item.name} item={item} />
+                ))}
+              </div>
+            )}
+          </div>
+        ))}
+      </div>
+    </section>
+  );
+}
+
+/** How far one arrow key moves the divider (a fraction of the board area). */
+const SPLIT_STEP = 0.05;
+
+/**
+ * The divider below the band: drag it, or focus it and use ↑ / ↓ (Home / End: smallest / largest), to give the band
+ * more or less room; a double click or Enter goes back to the default height. The height is kept in the webview state.
+ */
+function BandDivider({ band }: { band: RefObject<HTMLElement | null> }) {
+  const actions = useBoardActions();
+  const drag = useRef<{ pointer: number; start: number; height: number; total: number; fraction: number | null } | null>(null);
+  const measure = () => {
+    const element = band.current;
+    const area = element?.parentElement;
+    if (!element || !area || area.clientHeight === 0) return null;
+    return { height: element.getBoundingClientRect().height, total: area.clientHeight };
+  };
+  const show = (fraction: number) => {
+    band.current?.style.setProperty('--tl-top-size', `${(fraction * 100).toFixed(1)}%`);
+    if (band.current) band.current.dataset.sized = 'true';
+  };
+  const end = (event: PointerEvent<HTMLDivElement>) => {
+    const d = drag.current;
+    if (!d || d.pointer !== event.pointerId) return;
+    drag.current = null;
+    if (d.fraction !== null) actions.setTopSplit(d.fraction);
+  };
+  const nudge = (fraction: number) => {
+    const value = readTopSplit(fraction);
+    if (value === null) return;
+    show(value);
+    actions.setTopSplit(value);
+  };
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    const m = measure();
+    if (!m) return;
+    const now = m.height / m.total;
+    if (event.key === 'ArrowDown') nudge(now + SPLIT_STEP);
+    else if (event.key === 'ArrowUp') nudge(now - SPLIT_STEP);
+    else if (event.key === 'Home') nudge(0);
+    else if (event.key === 'End') nudge(1);
+    else if (event.key === 'Enter') actions.setTopSplit(null);
+    else return;
+    event.preventDefault();
+  };
+  return (
+    <div
+      className="tl-top__divider"
+      data-testid="top-divider"
+      role="separator"
+      tabIndex={0}
+      aria-orientation="horizontal"
+      aria-label="Resize the Vocabulary and Definitions columns"
+      title="Drag to give the Vocabulary and Definitions columns more or less room (or focus and use ↑ ↓); double-click for the default height"
+      onPointerDown={(event) => {
+        if (event.button !== 0) return;
+        const m = measure();
+        if (!m) return;
+        event.preventDefault();
+        event.currentTarget.setPointerCapture(event.pointerId);
+        drag.current = { pointer: event.pointerId, start: event.clientY, height: m.height, total: m.total, fraction: null };
+      }}
+      onPointerMove={(event) => {
+        const d = drag.current;
+        if (!d || d.pointer !== event.pointerId) return;
+        const fraction = readTopSplit((d.height + event.clientY - d.start) / d.total);
+        if (fraction === null) return;
+        d.fraction = fraction;
+        show(fraction);
+      }}
+      onPointerUp={end}
+      onPointerCancel={end}
+      onLostPointerCapture={end}
+      onDoubleClick={() => actions.setTopSplit(null)}
+      onKeyDown={onKeyDown}
+    />
+  );
+}
+
+/** The band (BD-1). Nothing when the board has no vocabulary at all. */
+export function VocabularyBand() {
+  const items = useBoard((s) => boardView(s).vocabulary);
+  const collapsed = useBoard((s) => vocabularyCollapsed(s));
+  const diff = useBoard((s) => proposedOverlay(s)?.diff.vocabulary);
+  const split = useBoard((s) => s.topSplit);
+  const actions = useBoardActions();
+  const band = useRef<HTMLElement>(null);
+  const columns = useMemo(() => splitVocabulary(items), [items]);
+  const summary = useMemo(() => bandSummary(items, diff ?? {}), [items, diff]);
+
+  // The height the user chose (the CSSOM: the CSP allows no style attributes).
+  useLayoutEffect(() => {
+    const element = band.current;
+    if (!element) return;
+    if (split === null) {
+      element.style.removeProperty('--tl-top-size');
+      delete element.dataset.sized;
+    } else {
+      element.style.setProperty('--tl-top-size', `${(split * 100).toFixed(1)}%`);
+      element.dataset.sized = 'true';
+    }
+  }, [split, collapsed, items.length]);
+
+  if (items.length === 0) return null;
+  const added = summary.added.vocabulary + summary.added.definitions;
+
+  return (
+    <>
+      <section ref={band} className="tl-vocab tl-top" data-testid="vocabulary" data-collapsed={collapsed || undefined} aria-label="Vocabulary and definitions">
+        <button type="button" className="tl-vocab__toggle" aria-expanded={!collapsed} title={bandSummaryText(summary)} onClick={() => actions.toggleVocabulary()}>
+          <span className={`codicon codicon-chevron-${collapsed ? 'right' : 'down'}`} aria-hidden="true" />
+          <span className="tl-vocab__title">Vocabulary</span>
+          <span className="tl-col__count">{summary.vocabulary}</span>
+          {summary.hidden > 0 ? (
+            <span className="tl-chip tl-chip--attention" title="Prop-valued axioms with no card (TL104)">
+              {summary.hidden} hidden assumption{summary.hidden === 1 ? '' : 's'}
+            </span>
+          ) : null}
+          <span className="tl-top__sep" aria-hidden="true">
+            ·
+          </span>
+          <span className="tl-vocab__title">Definitions</span>
+          <span className="tl-col__count">{summary.definitions}</span>
+          {summary.endorse > 0 ? (
+            <span className="tl-chip" data-flag="definitional-choice" title="Definitions your statements rely on: they need your endorsement (D-4)">
+              {summary.endorse} need{summary.endorse === 1 ? 's' : ''} your endorsement
+            </span>
+          ) : null}
+          {added > 0 ? (
+            <span className="tl-diff" data-diff="added" data-testid="vocab-new" title="Vocabulary the proposal adds">
+              <span className="tl-diff__glyph" aria-hidden="true">
+                +
+              </span>
+              {added} new
+            </span>
+          ) : null}
+        </button>
+        {collapsed ? null : (
+          <div className="tl-top__columns">
+            <BandColumn title="Vocabulary" testId="vocabulary-column" sections={VOCABULARY_SECTIONS} items={columns.vocabulary} added={summary.added.vocabulary} />
+            <BandColumn title="Definitions" testId="definitions-column" sections={DEFINITIONS_SECTIONS} items={columns.definitions} added={summary.added.definitions} />
+          </div>
+        )}
+      </section>
+      {collapsed ? null : <BandDivider band={band} />}
+    </>
+  );
+}
diff --git a/packages/webview/src/board/assumed.ts b/packages/webview/src/board/assumed.ts
new file mode 100644
index 0000000..7e9579c
--- /dev/null
+++ b/packages/webview/src/board/assumed.ts
@@ -0,0 +1,57 @@
+/**
+ * Spec v4 BD-1 (slice 1c): what is assumed outside the AXIOMS column, for its header line "also assumed: K pending
+ * claims, N existence assumptions, M hidden assumptions", so the column accounts for every assumption Lean sees. Each
+ * entry links to its card (a pending claim: a proposition whose `.holds` is a Lean axiom, AR-6) or to its Vocabulary
+ * item (an existence assumption: a presupposition `axiom T.exists : Nonempty T`; a hidden assumption: a Prop-valued
+ * axiom with no card, TL104).
+ */
+import type { NodeType, TlNode, VocabItem } from '@telelean/core';
+
+export interface AlsoAssumed {
+  /** Pending claims: proposition ids, in board order. */
+  pending: string[];
+  /** Existence assumptions: presupposition names, in vocabulary order. */
+  existence: string[];
+  /** Hidden assumptions: names of unmarked axioms, in vocabulary order. */
+  hidden: string[];
+}
+
+/**
+ * What the AXIOMS header counts on the board on screen. In the Proposed view before the result is revealed (`result`),
+ * a card whose result is hidden counts as it stands on the Current board (`current`), and a new one not at all: that a
+ * pending claim became proved tells that a proof exists (spec v4.1 RV-6; 1d fixer).
+ */
+export function alsoAssumed(
+  view: {
+    nodes: Readonly<Record<string, TlNode>>;
+    order: Readonly<Record<NodeType, readonly string[]>>;
+    vocabulary: readonly VocabItem[];
+  },
+  result?: { hidden: ReadonlySet<string>; current: Readonly<Record<string, TlNode>> },
+): AlsoAssumed {
+  const shown = (id: string): TlNode | undefined => (result?.hidden.has(id) ? result.current[id] : view.nodes[id]);
+  return {
+    pending: view.order.PROPOSITION.filter((id) => shown(id)?.type === 'PROPOSITION' && shown(id)?.status.proof.kind === 'pending'),
+    existence: view.vocabulary.filter((item) => item.kind === 'presupposition').map((item) => item.name),
+    hidden: view.vocabulary.filter((item) => item.kind === 'unmarked-axiom').map((item) => item.name),
+  };
+}
+
+export type AssumedKind = keyof AlsoAssumed;
+
+const NOUNS: Readonly<Record<AssumedKind, [string, string]>> = {
+  pending: ['pending claim', 'pending claims'],
+  existence: ['existence assumption', 'existence assumptions'],
+  hidden: ['hidden assumption', 'hidden assumptions'],
+};
+
+/** The header line's parts, in the spec's order, leaving out the kinds with nothing ("2 pending claims", …). */
+export function alsoAssumedParts(assumed: AlsoAssumed): Array<{ kind: AssumedKind; text: string; count: number }> {
+  return (['pending', 'existence', 'hidden'] as const)
+    .map((kind) => {
+      const count = assumed[kind].length;
+      const [one, many] = NOUNS[kind];
+      return { kind, count, text: `${count} ${count === 1 ? one : many}` };
+    })
+    .filter((part) => part.count > 0);
+}
diff --git a/packages/webview/src/board/band.ts b/packages/webview/src/board/band.ts
new file mode 100644
index 0000000..6a063c5
--- /dev/null
+++ b/packages/webview/src/board/band.ts
@@ -0,0 +1,123 @@
+/**
+ * The band (spec v4.1 BD-7, B.5; slice 1d), pure: which drawn arrows into a proposition bind together as the ones its
+ * checked proof uses, and whether the band is COMPLETE (the ✓, "these suffice") or OPEN (no ✓, naming what lies
+ * outside it). The board never decides what a proof uses: core computes direct(v) from Lean's elaborated proof
+ * (`status.direct`, the solid arrows); this module only words it and picks the arrows.
+ *
+ *  - band(v) = the drawn arrows into v whose source is in direct(v), plus the drawn hollow-head arrows of a conditional
+ *    proof (its hypotheses), which sit inside an open band.
+ *  - Complete when every card in direct(v) has a drawn arrow into v, v's proof takes no hypothesis, its footprint has no
+ *    hidden assumption (`axiom:`), direct(v) came from the elaborated proof (not the source-text fallback), B.2's
+ *    cross-check found nothing unseen, and neither v's `.holds` nor that of a card in direct(v) states something else
+ *    than its card (TL114: Lean checked the proof from that other statement, not from the one the arrow stands for).
+ *    The band says the arrows suffice together; never that each is needed, nor that the axioms are consistent (S20),
+ *    so its tooltip always says "consistency unchecked".
+ *  - A card with no arrow to bind: its band sits on its "follows from nothing" mark (the ∅ stub) when it has one; else
+ *    there is no band (a proof from nothing shows its chip instead, cardData.ts).
+ *  - No band from out-of-date facts (the card, or a card its proof uses directly, is stale or not checked), none for an
+ *    axiom, an unproved card, or a card whose result the Proposed view still hides (D-19, RV-6).
+ */
+import { PRESUPPOSITION_PREFIX, type TlEdge, type TlNode, type VocabItem } from '@telelean/core';
+
+export interface Band {
+  /** The proposition the band belongs to (one band per card: a proposition has one proof). */
+  target: string;
+  /** The drawn arrows it binds, as overlay edge ids (`${source}->${target}`), in the order of the card's premises. */
+  arrows: string[];
+  /** It sits on the card's ∅ stub (no arrow to bind; the card is marked "follows from nothing"). */
+  onMark: boolean;
+  /** The ✓: these arrows suffice together (checked by Lean). */
+  complete: boolean;
+  /** What lies outside an open band, in words (empty when complete). */
+  outside: string[];
+  /** The tooltip. */
+  title: string;
+}
+
+/** What the band needs from the board on screen (BoardViewData and Overlay both have it). */
+export interface BandContext {
+  nodes: Readonly<Record<string, TlNode>>;
+  edges: readonly TlEdge[];
+  vocab?: ReadonlyMap<string, VocabItem>;
+  /** Cards whose result the Proposed view hides until the review reveals it. */
+  hidden?: ReadonlySet<string>;
+}
+
+export const BAND_COMPLETE_TITLE = 'Together these suffice (checked by Lean) · consistency unchecked';
+
+const OUT_OF_DATE: ReadonlySet<string> = new Set(['stale', 'not-checked']);
+
+function cut(text: string, max = 40): string {
+  return text.length > max ? `${text.slice(0, max - 1).trimEnd()}…` : text;
+}
+
+/** A card as the band names it: “its sentence”, or its id when it is not on this board (another subject's card). */
+export function bandName(id: string, nodes: Readonly<Record<string, TlNode>>): string {
+  const node = nodes[id];
+  return `“${cut(node?.naturalName || id)}”`;
+}
+
+const isProof = (node: TlNode) => node.status.proof.kind === 'proved' || node.status.proof.kind === 'conditional';
+const footprintOf = (node: TlNode): readonly string[] => {
+  const proof = node.status.proof;
+  return proof.kind === 'proved' ? proof.footprint : proof.kind === 'conditional' ? (proof.footprint ?? []) : [];
+};
+
+/** direct(v): core's list (every subject), or, from a graph made before slice 1d, the solid arrows into the card. */
+export function directOf(node: TlNode, edges: readonly TlEdge[]): string[] {
+  if (node.status.direct) return [...node.status.direct.ids];
+  return edges.filter((e) => e.type === 'verified' && e.target === node.id && !e.conditional).map((e) => e.source);
+}
+
+/** The band of one card, or null when it has none (see the module comment). */
+export function bandOf(node: TlNode, ctx: BandContext): Band | null {
+  if (node.type !== 'PROPOSITION' || !isProof(node) || ctx.hidden?.has(node.id)) return null;
+  if (node.status.flags.some((f) => OUT_OF_DATE.has(f))) return null;
+  const proof = node.status.proof;
+  const direct = directOf(node, ctx.edges);
+  const on = proof.kind === 'conditional' ? proof.on : [];
+  for (const id of [...direct, ...on]) if (ctx.nodes[id]?.status.flags.some((f) => OUT_OF_DATE.has(f))) return null;
+
+  const drawn = node.premises.filter((p) => p !== node.id && ctx.nodes[p] !== undefined);
+  const arrows = drawn.filter((p) => direct.includes(p) || on.includes(p)).map((p) => `${p}->${node.id}`);
+  const onMark = arrows.length === 0 && node.fromNothing === true;
+  if (arrows.length === 0 && !onMark) return null;
+
+  const outside: string[] = [];
+  for (const id of direct) if (!drawn.includes(id)) outside.push(`also uses ${bandName(id, ctx.nodes)} (no arrow)`);
+  for (const id of on) outside.push(`given ${bandName(id, ctx.nodes)} (not proved)`);
+  if (footprintOf(node).some((x) => x.startsWith('axiom:'))) outside.push('a hidden assumption');
+  // An arrow stands for its card's statement, but Lean checked the proof from what each `.holds` states: when v's
+  // `.holds`, or that of a card the proof uses, states something else (TL114), the arrows do not say what Lean checked.
+  if (node.status.flags.includes('holds-mismatch')) outside.push('its own .holds states something else (TL114)');
+  for (const id of direct) if (ctx.nodes[id]?.status.flags.includes('holds-mismatch')) outside.push(`the .holds of ${bandName(id, ctx.nodes)} states something else (TL114)`);
+  for (const id of node.status.direct?.unseen ?? []) outside.push(`uses ${bandName(id, ctx.nodes)} in a way the arrows do not show`);
+  if ((node.status.direct?.from ?? 'source') === 'source') outside.push('computed from the source text only');
+  const complete = outside.length === 0;
+
+  const lines = [complete ? BAND_COMPLETE_TITLE : `Open band (no ✓): ${outside.join(' · ')} · consistency unchecked`];
+  const definitions = (node.lean.uses ?? []).filter((name) => ctx.vocab?.get(name)?.kind === 'definition');
+  if (definitions.length > 0) lines.push(`also by definition: ${definitions.map((name) => shortName(name, node, ctx.vocab)).join(', ')}`);
+  const presupposes = footprintOf(node)
+    .filter((x) => x.startsWith(PRESUPPOSITION_PREFIX))
+    .map((x) => x.slice(PRESUPPOSITION_PREFIX.length));
+  if (presupposes.length > 0) lines.push(`also presupposes: ${presupposes.map((name) => shortName(name, node, ctx.vocab)).join(', ')}`);
+  return { target: node.id, arrows, onMark, complete, outside, title: lines.join('\n') };
+}
+
+/** A vocabulary item's name as this board prints it (its short name in its own subject). */
+function shortName(name: string, node: TlNode, vocab: ReadonlyMap<string, VocabItem> | undefined): string {
+  const item = vocab?.get(name);
+  if (item && item.subject === node.subject) return item.shortName;
+  return name.startsWith(`${node.subject}.`) ? name.slice(node.subject.length + 1) : name;
+}
+
+/** Every band of the board on screen (the cards' order). */
+export function bandsOf(ctx: BandContext): Band[] {
+  const out: Band[] = [];
+  for (const node of Object.values(ctx.nodes)) {
+    const band = bandOf(node, ctx);
+    if (band) out.push(band);
+  }
+  return out;
+}
diff --git a/packages/webview/src/board/canvas/CanvasView.ts b/packages/webview/src/board/canvas/CanvasView.ts
new file mode 100644
index 0000000..1488050
--- /dev/null
+++ b/packages/webview/src/board/canvas/CanvasView.ts
@@ -0,0 +1,278 @@
+/**
+ * The PROPOSITIONS canvas's view (spec v4 BD-3, slice 1c): the pan and zoom of one viewport, applied without React.
+ * The transform lives here, not in the store, so panning and zooming never re-render a card: it is written as CSS
+ * custom properties on the viewport (`--tl-tx`, `--tl-ty`, `--tl-s`, through the CSSOM, which the CSP allows), and
+ * the canvas layer's class turns them into `transform: translate(tx, ty) scale(s)`. Listeners (the edge engine, the
+ * toolbar's zoom label) hear every change; popovers hear the `tl-canvas-view` event the viewport dispatches.
+ *
+ * `layout` is the canvas as PropositionCanvas lays it out: every card's position (stored or placed) and collapsed
+ * size, in canvas coordinates. The board's pointer handlers, the toolbar and the reveals read it.
+ */
+import { besideAxiom, newCardPosition, PLACEMENT } from './placement';
+import {
+  boundsOf,
+  centerOn,
+  clampScale,
+  FIT_ALL,
+  fitView,
+  followView,
+  IDENTITY,
+  interpolateView,
+  revealView,
+  sameView,
+  toCanvas,
+  zoomAbout,
+  zoomStep,
+  type Box,
+  type FitOptions,
+  type Point,
+  type Size,
+  type ViewTransform,
+} from './view';
+
+/** Dispatched (bubbling) on the viewport after each view change, so popovers anchored in a card can follow it. */
+export const CANVAS_VIEW_EVENT = 'tl-canvas-view';
+
+/** How long an animated view change (a reveal, Fit all) takes, unless motion is reduced. */
+const ANIMATION_MS = 180;
+
+/** The first view of a board: Fit all, but never so small that the first cards cannot be read. */
+const INITIAL_FIT: FitOptions = { margin: 32, maxScale: 1, minScale: 0.6 };
+
+/** Zoom to selection: fit the selected cards, zooming in up to 150 %. */
+const SELECTION_FIT: FitOptions = { margin: 48, maxScale: 1.5, minScale: FIT_ALL.minScale };
+
+/**
+ * What a new proposition goes next to (BD-8): a card on the canvas (by id), or an axiom of the AXIOMS column (the
+ * client y of its top: the new card goes level with it).
+ */
+export type NewCardAnchor = { kind: 'canvas'; id: string } | { kind: 'axiom'; clientTop: number };
+
+export function reducedMotion(): boolean {
+  return document.body.classList.contains('vscode-reduce-motion') || matchMedia('(prefers-reduced-motion: reduce)').matches;
+}
+
+export class CanvasView {
+  private viewport: HTMLElement | null = null;
+  private view: ViewTransform = IDENTITY;
+  private animation = 0;
+  private readonly listeners = new Set<() => void>();
+  private readonly layoutListeners = new Set<() => void>();
+  private boxes: ReadonlyMap<string, Box> = new Map();
+  private tidyPlanner: ((which: readonly string[] | null) => Record<string, Point>) | null = null;
+  /** The subject the view was last fitted for: a board seen for the first time (or another subject) is fitted. */
+  fittedFor: string | null = null;
+
+  attach(viewport: HTMLElement): void {
+    this.viewport = viewport;
+    this.write();
+  }
+
+  detach(): void {
+    this.stopAnimation();
+    this.viewport = null;
+  }
+
+  get transform(): ViewTransform {
+    return this.view;
+  }
+
+  get element(): HTMLElement | null {
+    return this.viewport;
+  }
+
+  /** The viewport's size (its padding box). */
+  size(): Size {
+    return { w: this.viewport?.clientWidth ?? 0, h: this.viewport?.clientHeight ?? 0 };
+  }
+
+  /** Every card on the canvas: its position and collapsed size (canvas coordinates). */
+  get layout(): ReadonlyMap<string, Box> {
+    return this.boxes;
+  }
+
+  /** PropositionCanvas, after each placement: the cards' boxes. The edge engine re-measures. */
+  setLayout(boxes: ReadonlyMap<string, Box>): void {
+    this.boxes = boxes;
+    for (const listener of this.layoutListeners) listener();
+  }
+
+  /** PropositionCanvas: how Tidy layout places cards (it has the placement's input). */
+  setTidyPlanner(planner: ((which: readonly string[] | null) => Record<string, Point>) | null): void {
+    this.tidyPlanner = planner;
+  }
+
+  /** Tidy layout: new positions for `which` (every proposition when null), not stored yet. */
+  tidyPositions(which: readonly string[] | null): Record<string, Point> {
+    return this.tidyPlanner?.(which) ?? {};
+  }
+
+  /** Called after every view change. */
+  onChange(listener: () => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  /** Called when the cards' layout changes (a placement, a move). */
+  onLayout(listener: () => void): () => void {
+    this.layoutListeners.add(listener);
+    return () => this.layoutListeners.delete(listener);
+  }
+
+  /** Shows `next` (the scale clamped to the zoom range); `animate` eases there unless motion is reduced. */
+  set(next: ViewTransform, animate = false): void {
+    const target = { x: next.x, y: next.y, s: clampScale(next.s) };
+    if (![target.x, target.y].every(Number.isFinite)) return;
+    this.stopAnimation();
+    if (!animate || reducedMotion() || !this.viewport) {
+      this.apply(target);
+      return;
+    }
+    const from = this.view;
+    const size = this.size();
+    const start = performance.now();
+    const step = (now: number) => {
+      const k = Math.min(1, (now - start) / ANIMATION_MS);
+      const eased = 1 - Math.pow(1 - k, 3);
+      this.apply(k >= 1 ? target : interpolateView(from, target, eased, size));
+      this.animation = k >= 1 ? 0 : requestAnimationFrame(step);
+    };
+    this.animation = requestAnimationFrame(step);
+  }
+
+  panBy(dx: number, dy: number): void {
+    if (dx === 0 && dy === 0) return;
+    const v = this.view;
+    this.set({ x: v.x + dx, y: v.y + dy, s: v.s });
+  }
+
+  /** Zooms by `factor` about the client point (x, y) (the wheel: about the cursor). */
+  zoomAtClient(clientX: number, clientY: number, factor: number): void {
+    const origin = this.origin();
+    this.set(zoomAbout(this.view, { x: clientX - origin.x, y: clientY - origin.y }, factor));
+  }
+
+  /** + / − and the toolbar: one step about the viewport's centre. */
+  zoomStep(direction: 1 | -1): void {
+    this.set(zoomStep(this.view, this.size(), direction));
+  }
+
+  /** Fit all: every card in view (at most 100 %). False when there is no card. */
+  fitAll(animate = true): boolean {
+    const box = boundsOf(this.boxes.values());
+    if (!box) return false;
+    this.set(fitView(box, this.size(), FIT_ALL), animate);
+    return true;
+  }
+
+  /** The first view of a board: Fit all, at 60 % at least (the top-left cards then show). */
+  fitInitial(): boolean {
+    const box = boundsOf(this.boxes.values());
+    if (!box || this.size().w === 0) return false;
+    this.set(fitView(box, this.size(), INITIAL_FIT));
+    return true;
+  }
+
+  /** Zoom to selection: the given cards in view. False when none of them is on the canvas. */
+  fitCards(ids: Iterable<string>): boolean {
+    const boxes = [...ids].flatMap((id) => {
+      const box = this.boxes.get(id);
+      return box ? [box] : [];
+    });
+    const box = boundsOf(boxes);
+    if (!box) return false;
+    this.set(fitView(box, this.size(), SELECTION_FIT), true);
+    return true;
+  }
+
+  /**
+   * BD-3 "Show on board and every other reveal pan and zoom the canvas to the card": centres it (at 100 % when the view
+   * is smaller than readable), unless it is in view already. `box` overrides the layout (a card expanded since).
+   */
+  reveal(id: string, box?: Box): boolean {
+    const target = box ?? this.boxes.get(id);
+    if (!target) return false;
+    const next = revealView(this.view, target, this.size());
+    if (next && !sameView(next, this.view)) this.set(next, true);
+    return true;
+  }
+
+  /** BD-4: a canvas edge's "n linked" badge pans (at the current zoom) to centre the card. */
+  panTo(id: string): boolean {
+    const box = this.boxes.get(id);
+    if (!box) return false;
+    this.set(centerOn(box, this.size(), this.view.s), true);
+    return true;
+  }
+
+  /** The canvas follows the focused card: the smallest pan that brings it into view. */
+  follow(id: string, box?: Box): void {
+    const target = box ?? this.boxes.get(id);
+    if (!target) return;
+    const next = followView(this.view, target, this.size());
+    if (next) this.set(next);
+  }
+
+  /** The canvas point under a client point. */
+  clientToCanvas(clientX: number, clientY: number): Point {
+    const origin = this.origin();
+    return toCanvas(this.view, { x: clientX - origin.x, y: clientY - origin.y });
+  }
+
+  /**
+   * BD-8: where a new proposition from the A|P box goes, never on top of another card: right of the selected card
+   * when it is on the canvas; at the canvas's left side, level with it (in view), when it is an axiom of the column;
+   * else in the middle of the view.
+   */
+  newCardPosition(near: NewCardAnchor | null, size: Size = { w: PLACEMENT.cardWidth, h: PLACEMENT.estimatedHeight }): Point {
+    const viewSize = this.size();
+    const center = toCanvas(this.view, { x: viewSize.w / 2, y: viewSize.h / 2 });
+    const boxes = [...this.boxes.values()];
+    if (near?.kind === 'axiom') {
+      const beside = besideAxiom(this.view, viewSize, near.clientTop - this.origin().y, size);
+      return newCardPosition({ near: null, beside, center, boxes, size });
+    }
+    return newCardPosition({ near: near ? (this.boxes.get(near.id) ?? null) : null, center, boxes, size });
+  }
+
+  /** The viewport's padding-box corner in client coordinates. */
+  private origin(): Point {
+    const viewport = this.viewport;
+    if (!viewport) return { x: 0, y: 0 };
+    const r = viewport.getBoundingClientRect();
+    return { x: r.left + viewport.clientLeft, y: r.top + viewport.clientTop };
+  }
+
+  private stopAnimation(): void {
+    if (this.animation) cancelAnimationFrame(this.animation);
+    this.animation = 0;
+  }
+
+  private apply(view: ViewTransform): void {
+    if (sameView(view, this.view)) return;
+    this.view = view;
+    this.write();
+  }
+
+  private write(): void {
+    const viewport = this.viewport;
+    if (viewport) {
+      viewport.style.setProperty('--tl-tx', `${this.view.x}px`);
+      viewport.style.setProperty('--tl-ty', `${this.view.y}px`);
+      viewport.style.setProperty('--tl-s', String(this.view.s));
+      viewport.dispatchEvent(new Event(CANVAS_VIEW_EVENT, { bubbles: true }));
+    }
+    for (const listener of this.listeners) listener();
+  }
+}
+
+let current: CanvasView | null = null;
+
+/** The board's canvas (one per webview), for the reveals of cards and the A|P box's placement. */
+export function setCurrentCanvas(view: CanvasView | null): void {
+  current = view;
+}
+
+export function currentCanvas(): CanvasView | null {
+  return current;
+}
diff --git a/packages/webview/src/board/canvas/gesture.ts b/packages/webview/src/board/canvas/gesture.ts
new file mode 100644
index 0000000..a90bd24
--- /dev/null
+++ b/packages/webview/src/board/canvas/gesture.ts
@@ -0,0 +1,61 @@
+/**
+ * Press, click or drag (spec v4 CM-7, A21): a press becomes a drag once the pointer has moved CLICK_SLOP px or more
+ * from where it went down, and stays a drag even if it comes back. A right press released before that is a click (the
+ * right-click menu); a right drag only pans, and a left drag on a card moves it.
+ */
+
+/** CM-7: "Without movement" means less than 4 px between press and release. */
+export const CLICK_SLOP = 4;
+
+export interface PressPoint {
+  x: number;
+  y: number;
+}
+
+/** Whether `point` is CLICK_SLOP px or more away from `start`. */
+export function beyondSlop(start: PressPoint, point: PressPoint, slop = CLICK_SLOP): boolean {
+  return Math.hypot(point.x - start.x, point.y - start.y) >= slop;
+}
+
+/** One press of a pointer: where it started, where it is, and whether it has become a drag. */
+export class PressTracker {
+  private dragged = false;
+  private last: PressPoint;
+
+  constructor(
+    readonly start: PressPoint,
+    private readonly slop = CLICK_SLOP,
+  ) {
+    this.last = start;
+  }
+
+  /** Records a move; returns the movement since the previous one (zero until the press is a drag). */
+  move(point: PressPoint): { dx: number; dy: number; started: boolean } {
+    if (!this.dragged) {
+      if (!beyondSlop(this.start, point, this.slop)) return { dx: 0, dy: 0, started: false };
+      this.dragged = true;
+      // The first drag step covers everything since the press, so a pan or a move follows the pointer exactly.
+      const first = { dx: point.x - this.start.x, dy: point.y - this.start.y, started: true };
+      this.last = point;
+      return first;
+    }
+    const step = { dx: point.x - this.last.x, dy: point.y - this.last.y, started: false };
+    this.last = point;
+    return step;
+  }
+
+  /** The press has become a drag (it moved CLICK_SLOP px or more at some point). */
+  get dragging(): boolean {
+    return this.dragged;
+  }
+
+  /** Movement from the press to the last recorded point. */
+  get total(): { dx: number; dy: number } {
+    return { dx: this.last.x - this.start.x, dy: this.last.y - this.start.y };
+  }
+
+  /** A release here is a click: the press never became a drag, and the release is within the slop. */
+  isClick(release: PressPoint): boolean {
+    return !this.dragged && !beyondSlop(this.start, release, this.slop);
+  }
+}
diff --git a/packages/webview/src/board/canvas/placement.ts b/packages/webview/src/board/canvas/placement.ts
new file mode 100644
index 0000000..88ac2a2
--- /dev/null
+++ b/packages/webview/src/board/canvas/placement.ts
@@ -0,0 +1,210 @@
+/**
+ * Where propositions go on the canvas (spec v4 BD-3, A24; docs/slice1-plan.md §3 "Placement"). Pure: the canvas
+ * measures its cards' collapsed sizes and calls these.
+ *
+ * - A card with a stored position (layout.json, `TlGraph.positions`) stays exactly there: telelean never moves it.
+ * - Every other proposition gets a layered place, computed here and never written (opening a board writes nothing,
+ *   AP-12) until the user moves the card or chooses Tidy layout. Its layer is the longest declared-arrow path into it
+ *   from any card, the axioms being layer 0, so the canvas's first layer is 1; x = layer × (card width + column gap);
+ *   within a layer the cards stack in board (file) order from the top, skipping the boxes of stored cards, so cards
+ *   never overlap and sources sit to the left of their targets.
+ * - Tidy layout re-places the selected cards (all, when none is selected) the same way, around the others where they
+ *   are shown; the board stores the result as one move (one Undo step).
+ * - BD-8: a proposition from the A|P box goes into view, next to the selected card if any (right of a proposition;
+ *   level with an axiom, at the canvas's left side).
+ * - The Proposed view shows the cards it shares with the Current board where the Current board shows them.
+ */
+import { toCanvas, type Box, type Point, type Size, type ViewTransform } from './view';
+
+export interface PlacementOptions {
+  /** A canvas card's width (CSS `--tl-card-w`; the measured width wins when known). */
+  cardWidth: number;
+  /** Between two layers. */
+  columnGap: number;
+  /** Between two cards of a layer (and around a stored card). */
+  rowGap: number;
+  /** The first card of a layer starts here. */
+  top: number;
+  /** A card's height before it has been measured. */
+  estimatedHeight: number;
+}
+
+export const PLACEMENT: PlacementOptions = { cardWidth: 260, columnGap: 96, rowGap: 22, top: 0, estimatedHeight: 64 };
+
+export interface PlacementInput {
+  /** The propositions, in board (file) order. */
+  ids: readonly string[];
+  /** The declared arrows into a card (its `premises:`). */
+  premisesOf: (id: string) => readonly string[];
+  /** Axioms are layer 0; sources that are neither an axiom nor in `ids` (other subjects, deleted) count for nothing. */
+  isAxiom: (id: string) => boolean;
+  /** Stored positions (top-left corners, canvas coordinates). */
+  stored: Readonly<Record<string, Point>>;
+  /** A card's measured collapsed size (an estimate before it is measured). */
+  sizeOf: (id: string) => Size;
+  options?: Partial<PlacementOptions>;
+}
+
+/**
+ * Each proposition's layer: 1 + the longest path of declared arrows into it, counting an axiom source as layer 0 (so a
+ * proposition resting on axioms only, or on nothing, is in layer 1). A cycle in the files (TL015) is cut where the walk
+ * meets it again, so every card still gets a layer.
+ */
+export function canvasLayers(ids: readonly string[], premisesOf: (id: string) => readonly string[], isAxiom: (id: string) => boolean): Map<string, number> {
+  const known = new Set(ids);
+  const memo = new Map<string, number>();
+  const visiting = new Set<string>();
+  const layerOf = (id: string): number => {
+    const done = memo.get(id);
+    if (done !== undefined) return done;
+    if (visiting.has(id)) return 0; // the arrow that closes a cycle adds nothing
+    visiting.add(id);
+    let layer = 1;
+    for (const source of premisesOf(id)) {
+      if (source === id) continue;
+      if (known.has(source)) layer = Math.max(layer, layerOf(source) + 1);
+      else if (isAxiom(source)) layer = Math.max(layer, 1);
+    }
+    visiting.delete(id);
+    memo.set(id, layer);
+    return layer;
+  };
+  for (const id of ids) layerOf(id);
+  return memo;
+}
+
+/** Boxes that share some of the horizontal band [x, x + w), sorted by their top. */
+function inBand(boxes: readonly Box[], x: number, w: number): Box[] {
+  return boxes.filter((b) => b.x < x + w && x < b.x + b.w).sort((a, b) => a.y - b.y);
+}
+
+/**
+ * The first y at or below `from` where a box of `size` in the band fits between `band`'s boxes (sorted by top), with
+ * `gap` kept above and below each of them.
+ */
+function firstFree(band: readonly Box[], from: number, size: Size, gap: number): number {
+  let y = from;
+  for (const b of band) {
+    if (b.y + b.h + gap <= y) continue; // wholly above
+    if (b.y >= y + size.h + gap) break; // this one and the rest (sorted by top) are below
+    y = b.y + b.h + gap;
+  }
+  return y;
+}
+
+/** Inserts `box` into `band` (sorted by top). */
+function insertSorted(band: Box[], box: Box): void {
+  const index = band.findIndex((b) => b.y > box.y);
+  if (index < 0) band.push(box);
+  else band.splice(index, 0, box);
+}
+
+/** Every proposition's position: its stored one, else its layered place (see the module comment). */
+export function placeCards(input: PlacementInput): Record<string, Point> {
+  const o = { ...PLACEMENT, ...input.options };
+  const out: Record<string, Point> = {};
+  const obstacles: Box[] = [];
+  for (const id of input.ids) {
+    const p = input.stored[id];
+    if (!p) continue;
+    out[id] = { x: p.x, y: p.y };
+    const size = input.sizeOf(id);
+    obstacles.push({ x: p.x, y: p.y, w: size.w, h: size.h });
+  }
+  const layers = canvasLayers(input.ids, input.premisesOf, input.isAxiom);
+  const byLayer = new Map<number, string[]>();
+  for (const id of input.ids) {
+    if (out[id]) continue;
+    const layer = layers.get(id) ?? 1;
+    const list = byLayer.get(layer);
+    if (list) list.push(id);
+    else byLayer.set(layer, [id]);
+  }
+  for (const layer of [...byLayer.keys()].sort((a, b) => a - b)) {
+    const x = layer * (o.cardWidth + o.columnGap);
+    const ids = byLayer.get(layer) ?? [];
+    const band = inBand(obstacles, x, Math.max(o.cardWidth, ...ids.map((id) => input.sizeOf(id).w)));
+    let cursor = o.top;
+    for (const id of ids) {
+      const size = input.sizeOf(id);
+      const y = firstFree(band, cursor, size, o.rowGap);
+      out[id] = { x, y };
+      const box = { x, y, w: size.w, h: size.h };
+      obstacles.push(box);
+      insertSorted(band, box);
+      cursor = y + size.h + o.rowGap;
+    }
+  }
+  return out;
+}
+
+/**
+ * Tidy layout: new positions for the cards in `which` (all of `input.ids` when null), placed as if they had none,
+ * around the other cards where they are shown (`shown`: every card's current position, stored or placed).
+ */
+export function tidyPositions(input: PlacementInput, shown: Readonly<Record<string, Point>>, which: readonly string[] | null): Record<string, Point> {
+  const moving = new Set((which ?? input.ids).filter((id) => input.ids.includes(id)));
+  const stored: Record<string, Point> = {};
+  for (const id of input.ids) {
+    const p = shown[id];
+    if (!moving.has(id) && p) stored[id] = p;
+  }
+  const placed = placeCards({ ...input, stored });
+  const out: Record<string, Point> = {};
+  for (const id of input.ids) {
+    const p = placed[id];
+    if (moving.has(id) && p) out[id] = { x: Math.round(p.x), y: Math.round(p.y) };
+  }
+  return out;
+}
+
+/**
+ * BD-8: where a new proposition from the A|P box goes: right of `near` (the selected card's box, on the canvas) when
+ * there is one; else at `beside` (the place next to a selected axiom: `besideAxiom`); else centred on `center` (the
+ * middle of the view). In each case it is moved down past the cards `boxes` it would overlap.
+ */
+export function newCardPosition(args: { near: Box | null; beside?: Point | null; center: Point; boxes: readonly Box[]; size: Size; options?: Partial<PlacementOptions> }): Point {
+  const o = { ...PLACEMENT, ...args.options };
+  const start = args.near
+    ? { x: args.near.x + args.near.w + o.columnGap, y: args.near.y }
+    : (args.beside ?? { x: args.center.x - args.size.w / 2, y: args.center.y - args.size.h / 2 });
+  const y = firstFree(inBand(args.boxes, start.x, args.size.w), start.y, args.size, o.rowGap);
+  return { x: Math.round(start.x), y: Math.round(y) };
+}
+
+/** BD-8: a new card next to a selected axiom keeps this far (viewport px) inside the canvas's edges. */
+export const BESIDE_AXIOM_INSET = 24;
+
+/**
+ * BD-8 for a selected axiom (it sits in the AXIOMS column, left of the canvas): the new proposition goes to the
+ * canvas's left side, level with the axiom's top (`top`, viewport px, which may lie outside the view when the column
+ * is scrolled), kept in view. Returns the card's top-left corner in canvas coordinates (`newCardPosition`'s `beside`).
+ */
+export function besideAxiom(view: ViewTransform, viewport: Size, top: number, size: Size, inset = BESIDE_AXIOM_INSET): Point {
+  const lowest = Math.max(inset, viewport.h - inset - size.h * view.s);
+  return toCanvas(view, { x: inset, y: Math.min(lowest, Math.max(inset, top)) });
+}
+
+/**
+ * The stored positions the Proposed view places its cards with (BD-3; brief 1c E): the proposal's own (`stored`: the
+ * board's, carried over by the runner, plus those of the cards it removes), and, for every other card it shows that
+ * the Current board shows too, the place the Current board gives it (`shown`: stored or placed). Switching between
+ * Current and Proposed then never moves a card the user has not moved; only the proposal's new cards go through the
+ * layered placement, around the others. Nothing is written: these places are only shown. Returns `stored` itself when
+ * nothing is added.
+ */
+export function keepCurrentPlaces(
+  ids: readonly string[],
+  stored: Readonly<Record<string, Point>>,
+  shown: Readonly<Record<string, Point>> | undefined,
+): Readonly<Record<string, Point>> {
+  if (!shown) return stored;
+  let out: Record<string, Point> | null = null;
+  for (const id of ids) {
+    const p = shown[id];
+    if (stored[id] || !p) continue;
+    out ??= { ...stored };
+    out[id] = p;
+  }
+  return out ?? stored;
+}
