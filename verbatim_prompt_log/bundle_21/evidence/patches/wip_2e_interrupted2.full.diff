+    state().receive(hostMessage('proposal', { proposal: p }));
+    expect(boardView(state()).positions).toEqual({ [GOAL]: { x: 1, y: 2 }, gone: { x: 5, y: 6 } });
+    state().setProposedView(false);
+    expect(boardView(state()).positions).toBe(state().positions);
+  });
+});
diff --git a/packages/webview/test/unit/store-formalize.test.ts b/packages/webview/test/unit/store-formalize.test.ts
new file mode 100644
index 0000000..46ebbca
--- /dev/null
+++ b/packages/webview/test/unit/store-formalize.test.ts
@@ -0,0 +1,134 @@
+/**
+ * Spec v4.1 ES-2, AR-8 (★D7 (b), AP-10), slice 1e: Formalize for dependencies in the store. The selected arrows into one
+ * proposition (or its "follows from nothing" mark) are the question; a source that is a proposition with neither a
+ * proof nor a pending claim is asked about first: with a Lean statement "Mark pending and continue" (claimPending, the
+ * user's own edit, then startRun once the host wrote it) or Cancel; without one, Cancel only.
+ */
+import { hostMessage, spyroGraph, type ActionOutcome, type TlGraph, type TlNode, type WebviewToHostMessage } from '@telelean/core';
+import { describe, expect, it } from 'vitest';
+import { createBoardStore, formalizeOf } from '../../src/state/store';
+import { makeNode } from '../shared/graphs';
+import { runView, TARGET } from '../shared/runs';
+
+const DARK = 'cynder-dark-past';
+/** A proposition with a Lean statement and no `.holds`: "Mark pending" applies. */
+const LEMMA = makeNode('l-lemma', 'PROPOSITION', 'Dark pasts show in games', {}, { lean: { binding: 'pinned', statement: 'Spyro.l_lemma' } });
+/** Another one, for the one-at-a-time questions. */
+const LEMMA2 = makeNode('l-second', 'PROPOSITION', 'PG games are for children', {}, { lean: { binding: 'pinned', statement: 'Spyro.l_second' } });
+/** A proposition without a Lean statement: it must be formalised and proved first. */
+const BARE = makeNode('l-bare', 'PROPOSITION', 'Nobody formalised this', { formal: 'informal' }, { lean: { binding: 'none' } });
+/** A pending proposition (its `.holds` is an axiom): no question. */
+const PENDING = makeNode('l-pending', 'PROPOSITION', 'Assumed until proved', { proof: { kind: 'pending' } }, {
+  lean: { binding: 'pinned', statement: 'Spyro.l_pending', justification: 'Spyro.l_pending.holds', justificationKind: 'axiom' },
+});
+
+/** The Spyro sample with these cards drawn into the target. */
+function graphWith(...extra: TlNode[]): TlGraph {
+  const graph = spyroGraph();
+  const nodes = graph.nodes.map((n) => (n.id === TARGET ? { ...n, premises: [...n.premises, ...extra.map((e) => e.id)] } : n));
+  const edges = [...graph.edges, ...extra.map((e) => ({ id: `premise:${e.id}->${TARGET}`, type: 'premise' as const, source: e.id, target: TARGET, origin: 'declared' as const }))];
+  return { ...graph, nodes: [...nodes, ...extra], edges };
+}
+
+function setup(graph: TlGraph) {
+  const sent: WebviewToHostMessage[] = [];
+  const store = createBoardStore((m) => sent.push(m), { today: () => '2026-11-19', setTimer: () => undefined, persist: () => undefined });
+  store.getState().applyGraph(graph);
+  const state = () => store.getState();
+  const result = (requestId: string, outcome: ActionOutcome) => state().receive(hostMessage('actionResult', { requestId, outcome }));
+  const ofType = <T extends WebviewToHostMessage['type']>(type: T) => sent.filter((m): m is Extract<WebviewToHostMessage, { type: T }> => m.type === type);
+  const select = (...sources: string[]) => sources.forEach((source, i) => state().selectArrow(source, TARGET, i > 0));
+  return { store, sent, state, result, ofType, select };
+}
+
+const OK: ActionOutcome = { ok: true, label: 'Mark pending: done', undoable: true };
+
+describe('Formalize for dependencies with an unproved proposition among the sources (AR-8)', () => {
+  it('asks first; Cancel starts nothing and marks nothing', () => {
+    const t = setup(graphWith(LEMMA));
+    t.select(DARK, LEMMA.id);
+    expect(formalizeOf(t.state())).toMatchObject({ disabled: null, target: TARGET, sources: [DARK, LEMMA.id] });
+    expect(t.state().formalize()).toBe(true);
+    expect(t.state().dialog).toEqual({ kind: 'formalize', mode: 'mark-pending', id: LEMMA.id, target: TARGET, sources: [DARK, LEMMA.id], queue: [], confirmed: [] });
+    expect(t.sent.filter((m) => m.type !== 'select')).toEqual([]);
+    t.state().closeDialog();
+    expect(t.state().dialog).toBeNull();
+    expect(t.sent.filter((m) => m.type !== 'select')).toEqual([]);
+  });
+
+  it('"Mark pending and continue": the mark first (the user\'s own edit), then the run once the host wrote it', () => {
+    const t = setup(graphWith(LEMMA));
+    t.select(DARK, LEMMA.id);
+    t.state().formalize();
+    t.state().confirmFormalizePending();
+    expect(t.state().dialog).toBeNull();
+    expect(t.ofType('claimPending').map((m) => m.payload)).toEqual([{ id: LEMMA.id, requestId: 'r1' }]);
+    expect(t.ofType('startRun')).toEqual([]); // not before the host has written the mark
+    t.result('r1', OK);
+    expect(t.ofType('startRun').map((m) => m.payload)).toEqual([{ target: TARGET, premises: [DARK, LEMMA.id], requestId: 'r2' }]);
+    expect(t.state().runBusy).toMatchObject({ action: 'start', requestId: 'r2' });
+  });
+
+  it('a refused mark starts nothing (its error toast says why)', () => {
+    const t = setup(graphWith(LEMMA));
+    t.select(LEMMA.id);
+    t.state().formalize();
+    t.state().confirmFormalizePending();
+    t.result('r1', { ok: false, code: 'invalid', error: 'Its Lean statement has problems: fix them first.' });
+    expect(t.ofType('startRun')).toEqual([]);
+    expect(t.state().toasts.map((x) => [x.level, x.text])).toEqual([['error', 'Its Lean statement has problems: fix them first.']]);
+  });
+
+  it('several such sources: one question at a time; every chosen mark is sent, then the run', () => {
+    const t = setup(graphWith(LEMMA, LEMMA2));
+    t.select(LEMMA.id, DARK, LEMMA2.id);
+    t.state().formalize();
+    expect(t.state().dialog).toMatchObject({ kind: 'formalize', id: LEMMA.id, queue: [LEMMA2.id], confirmed: [] });
+    t.state().confirmFormalizePending();
+    expect(t.state().dialog).toMatchObject({ kind: 'formalize', id: LEMMA2.id, queue: [], confirmed: [LEMMA.id] });
+    expect(t.ofType('claimPending')).toEqual([]); // nothing is marked before the last answer
+    t.state().confirmFormalizePending();
+    expect(t.ofType('claimPending').map((m) => m.payload.id)).toEqual([LEMMA.id, LEMMA2.id]);
+    t.result('r1', OK);
+    expect(t.ofType('startRun')).toEqual([]);
+    t.result('r2', OK);
+    expect(t.ofType('startRun').map((m) => m.payload.premises)).toEqual([[LEMMA.id, DARK, LEMMA2.id]]);
+  });
+
+  it('a source without a Lean statement: formalize and prove it first (Cancel only), even when others could be marked', () => {
+    const t = setup(graphWith(LEMMA, BARE));
+    t.select(LEMMA.id, BARE.id);
+    expect(t.state().formalize()).toBe(true);
+    expect(t.state().dialog).toMatchObject({ kind: 'formalize', mode: 'no-statement', id: BARE.id });
+    t.state().confirmFormalizePending(); // not offered; does nothing
+    expect(t.state().dialog).toMatchObject({ mode: 'no-statement' });
+    expect(t.sent.filter((m) => m.type !== 'select')).toEqual([]);
+  });
+
+  it('axioms, pending and proved propositions need no question: the run starts at once', () => {
+    const t = setup(graphWith(PENDING));
+    t.select(DARK, PENDING.id);
+    expect(t.state().formalize()).toBe(true);
+    expect(t.state().dialog).toBeNull();
+    expect(t.ofType('startRun').map((m) => m.payload)).toEqual([{ target: TARGET, premises: [DARK, PENDING.id], requestId: 'r1' }]);
+  });
+
+  it('a run that became active while the user was asked: the mark is not sent, and nothing starts', () => {
+    const t = setup(graphWith(LEMMA));
+    t.select(LEMMA.id);
+    t.state().formalize();
+    t.state().receive(hostMessage('run', { run: runView({ subject: 'Bayonetta' }) }));
+    t.state().confirmFormalizePending();
+    expect(t.ofType('claimPending')).toEqual([]);
+    expect(t.ofType('startRun')).toEqual([]);
+  });
+
+  it('the question goes when a card it is about leaves the board', () => {
+    const t = setup(graphWith(LEMMA));
+    t.select(LEMMA.id);
+    t.state().formalize();
+    expect(t.state().dialog?.kind).toBe('formalize');
+    t.state().applyGraph({ ...spyroGraph(9) });
+    expect(t.state().dialog).toBeNull();
+  });
+});
diff --git a/packages/webview/test/unit/store-gestures.test.ts b/packages/webview/test/unit/store-gestures.test.ts
new file mode 100644
index 0000000..05bc08d
--- /dev/null
+++ b/packages/webview/test/unit/store-gestures.test.ts
@@ -0,0 +1,247 @@
+/**
+ * Spec v4 AR-1, AR-7, CM-2, ES-9 (slice 1c2): the board store's side of the arrow gestures: the Delete key
+ * (`pressDelete`: one removeArrows for the selected arrows and marks, a card's dialog only without them, the reason
+ * while locked or in the Proposed view), the selection rectangle (`selectArea`), a proposition moved over the AXIOMS
+ * column (`overAxioms`, and the "Move to axioms" a drop there runs), and which gestures work when (`gestureGateOf`).
+ */
+import { buildGraph, EDIT_SESSION_ACTIVE, hostMessage, spyroGraph, spyroProvedGraph, type ActionOutcome, type TlGraph, type WebviewToHostMessage } from '@telelean/core';
+import { describe, expect, it } from 'vitest';
+import { canvasDropOutcome } from '../../src/board/gestures';
+import { MENU_PROPOSED_ARROWS, MENU_PROPOSED_READ_ONLY } from '../../src/board/menu';
+import { createBoardStore, gestureGateOf } from '../../src/state/store';
+import { makeNode, workspaceState } from '../shared/graphs';
+import { normativeProposal, reviewRun, runView } from '../shared/runs';
+
+const GOAL = 'cynder-not-good';
+const DARK = 'cynder-dark-past';
+const PG = 'new-spyro-pg';
+const RULE = 'pg-no-dark-past';
+const MARKED = 'spyro-is-fun';
+
+/** spyroGraph plus a proposition marked "follows from nothing". */
+function withMark(base: TlGraph = spyroGraph()): TlGraph {
+  const nodes = [...base.nodes, makeNode(MARKED, 'PROPOSITION', 'Spyro games are fun', {}, { fromNothing: true })];
+  return { ...buildGraph({ subject: base.subject, version: base.version, nodes, vocabulary: base.vocabulary, diagnostics: base.diagnostics }), semantic: base.semantic };
+}
+
+function setup(graph: TlGraph = withMark()) {
+  const sent: WebviewToHostMessage[] = [];
+  const store = createBoardStore((m) => sent.push(m), { today: () => '2026-11-19', setTimer: () => undefined, persist: () => undefined });
+  store.getState().applyGraph(graph);
+  store.getState().receive(hostMessage('workspace', { state: workspaceState() }));
+  const state = () => store.getState();
+  const result = (requestId: string, outcome: ActionOutcome) => state().receive(hostMessage('actionResult', { requestId, outcome }));
+  const ofType = (type: string) => sent.filter((m) => m.type === type);
+  return { store, sent, state, result, ofType };
+}
+
+const toasts = (t: ReturnType<typeof setup>) => t.state().toasts.map((x) => [x.level, x.text]);
+
+describe('the Delete key (AR-1): arrows and marks first, a card only without them', () => {
+  it('with arrows and a mark selected and a card focused: one removeArrows with both, and no card dialog', () => {
+    const t = setup();
+    t.state().selectIncomingArrows(GOAL);
+    t.state().selectMark(MARKED, true);
+    expect(t.state().pressDelete(DARK)).toBe(true);
+    expect(t.ofType('removeArrows')).toHaveLength(1);
+    expect(t.sent.at(-1)).toEqual({
+      v: 1,
+      type: 'removeArrows',
+      payload: { arrows: [DARK, PG, RULE].map((source) => ({ source, target: GOAL })), marks: [MARKED], requestId: 'r1' },
+    });
+    expect(t.state().dialog).toBeNull();
+    expect(t.ofType('deleteNode')).toEqual([]);
+  });
+
+  it('with nothing selected, the focused card\'s delete dialog; with no card focused either, nothing (false)', () => {
+    const t = setup();
+    expect(t.state().pressDelete(DARK)).toBe(true);
+    expect(t.state().dialog).toEqual({ kind: 'delete', id: DARK });
+    t.state().closeDialog();
+    // Selected cards are never deleted by the key alone (only a focused card's own Delete asks).
+    t.state().clickCard(DARK, false);
+    const count = t.sent.length;
+    expect(t.state().pressDelete(null)).toBe(false);
+    expect(t.state().pressDelete('nope')).toBe(false);
+    expect(t.sent.length).toBe(count);
+    expect(t.state().dialog).toBeNull();
+  });
+
+  it('a proof uses a removed arrow: one question for the whole Delete (A16), and Cancel sends nothing', () => {
+    const t = setup(withMark(spyroProvedGraph()));
+    t.state().selectArrow(DARK, GOAL, false);
+    t.state().selectMark(MARKED, true);
+    expect(t.state().pressDelete(null)).toBe(true);
+    expect(t.state().dialog).toMatchObject({ kind: 'arrows', change: { kind: 'remove-arrows', arrows: [{ source: DARK, target: GOAL }], marks: [MARKED] } });
+    t.state().closeDialog();
+    expect(t.ofType('removeArrows')).toEqual([]);
+  });
+
+  it('during an edit session (ES-9): nothing is sent, no dialog opens, and the reason is shown', () => {
+    const t = setup();
+    t.state().selectIncomingArrows(GOAL);
+    t.state().receive(hostMessage('run', { run: runView({ state: 'working' }) }));
+    expect(t.state().pressDelete(DARK)).toBe(true);
+    t.state().clearSelection();
+    expect(t.state().pressDelete(DARK)).toBe(true);
+    expect(t.ofType('removeArrows')).toEqual([]);
+    expect(t.state().dialog).toBeNull();
+    expect(toasts(t)).toEqual([['info', EDIT_SESSION_ACTIVE]]);
+  });
+
+  it('in the Proposed view: arrows change only through review items and transforms (the reason, nothing sent)', () => {
+    const t = setup(spyroProvedGraph());
+    t.state().selectIncomingArrows(GOAL);
+    const p = normativeProposal();
+    t.state().receive(hostMessage('run', { run: reviewRun(p) }));
+    t.state().receive(hostMessage('proposal', { proposal: p }));
+    expect(t.state().proposedView).toBe(true);
+    expect(t.state().pressDelete(null)).toBe(true);
+    expect(toasts(t)).toEqual([['info', MENU_PROPOSED_ARROWS]]);
+    expect(t.ofType('removeArrows')).toEqual([]);
+    t.state().clearSelection();
+    expect(t.state().pressDelete(GOAL)).toBe(false);
+    expect(t.state().dialog).toBeNull();
+  });
+});
+
+describe('the selection rectangle (CM-2): selectArea', () => {
+  const found = { cards: [GOAL, MARKED], arrows: [{ source: DARK, target: GOAL }], marks: [MARKED] };
+
+  it('replaces the selection with what it found (cards in its order, arrows, marks) and tells the host the cards', () => {
+    const t = setup();
+    t.state().clickCard(DARK, false);
+    t.state().selectArea(found, false);
+    expect(t.state().selected).toEqual([GOAL, MARKED]);
+    expect(t.state().selectedArrows).toEqual([{ source: DARK, target: GOAL }]);
+    expect(t.state().selectedMarks).toEqual([MARKED]);
+    expect(t.ofType('select').at(-1)?.payload).toEqual({ ids: [GOAL, MARKED] });
+    // The same again changes nothing and tells the host nothing.
+    const count = t.sent.length;
+    t.state().selectArea(found, false);
+    expect(t.sent.length).toBe(count);
+    // An empty rectangle (a plain one) clears it.
+    t.state().selectArea({ cards: [], arrows: [], marks: [] }, false);
+    expect([t.state().selected, t.state().selectedArrows, t.state().selectedMarks]).toEqual([[], [], []]);
+  });
+
+  it('with Ctrl/Cmd it adds to the selection (nothing twice)', () => {
+    const t = setup();
+    t.state().clickCard(DARK, false);
+    t.state().selectArrow(PG, GOAL, true);
+    t.state().selectArea(found, true);
+    expect(t.state().selected).toEqual([DARK, GOAL, MARKED]);
+    expect(t.state().selectedArrows).toEqual([
+      { source: PG, target: GOAL },
+      { source: DARK, target: GOAL },
+    ]);
+    t.state().selectArea(found, true);
+    expect(t.state().selected).toEqual([DARK, GOAL, MARKED]);
+    expect(t.state().selectedArrows).toHaveLength(2);
+  });
+
+  it('keeps only what a click could select: known cards, drawn arrows, drawn marks', () => {
+    const t = setup();
+    t.state().selectArea({ cards: ['nope', GOAL], arrows: [{ source: GOAL, target: DARK }, { source: RULE, target: GOAL }, { source: 'nope', target: GOAL }], marks: [GOAL, MARKED] }, false);
+    expect(t.state().selected).toEqual([GOAL]);
+    expect(t.state().selectedArrows).toEqual([{ source: RULE, target: GOAL }]);
+    expect(t.state().selectedMarks).toEqual([MARKED]);
+  });
+
+  it('works during an edit session (selecting is viewing), and does nothing in the Proposed view', () => {
+    const t = setup();
+    t.state().receive(hostMessage('run', { run: runView({ state: 'working' }) }));
+    t.state().selectArea(found, false);
+    expect(t.state().selected).toEqual([GOAL, MARKED]);
+    const p = setup(spyroProvedGraph());
+    const proposal = normativeProposal();
+    p.state().receive(hostMessage('run', { run: reviewRun(proposal) }));
+    p.state().receive(hostMessage('proposal', { proposal }));
+    p.state().selectArea({ cards: [GOAL], arrows: [{ source: DARK, target: GOAL }], marks: [] }, false);
+    expect([p.state().selected, p.state().selectedArrows]).toEqual([[], []]);
+  });
+});
+
+describe('a proposition moved over the AXIOMS column (AR-7)', () => {
+  it('overAxioms says which card is over it (the column\'s drop zone); a drop there runs "Move to axioms" with its impact first', () => {
+    const t = setup();
+    t.state().setOverAxioms({ id: GOAL, count: 1 });
+    expect(t.state().overAxioms).toEqual({ id: GOAL, count: 1 });
+    // What BoardInput does on the release: the card goes back, and "Move to axioms" states the impact first.
+    const outcome = canvasDropOutcome([GOAL], t.state().overAxioms !== null);
+    t.state().setOverAxioms(null);
+    expect(outcome).toEqual({ kind: 'to-axioms', id: GOAL });
+    if (outcome.kind === 'to-axioms') t.state().moveToAxioms(outcome.id);
+    expect(t.state().dialog).toMatchObject({ kind: 'rationale', id: GOAL, to: 'AXIOM', summary: 'Move to axioms: adds axiom cynder_not_good.holds' });
+    expect(t.ofType('kindChange')).toEqual([]);
+    expect(t.ofType('moveCards')).toEqual([]);
+  });
+
+  it('is cleared when an edit session begins, on another subject, and in the Proposed view', () => {
+    const t = setup();
+    t.state().setOverAxioms({ id: GOAL, count: 2 });
+    t.state().receive(hostMessage('run', { run: runView({ state: 'starting' }) }));
+    expect(t.state().overAxioms).toBeNull();
+    const u = setup();
+    u.state().setOverAxioms({ id: GOAL, count: 1 });
+    u.state().applyGraph({ ...spyroGraph(9), subject: 'Bayonetta' });
+    expect(u.state().overAxioms).toBeNull();
+    // Slice 1d carry-over: really switching to the Proposed view, by the toggle and by a proposal that arrives.
+    const v = setup(spyroProvedGraph());
+    const p = normativeProposal();
+    v.state().receive(hostMessage('run', { run: reviewRun(p) }));
+    v.state().receive(hostMessage('proposal', { proposal: p }));
+    expect(v.state().proposedView).toBe(true);
+    v.state().setProposedView(false);
+    v.state().setOverAxioms({ id: GOAL, count: 1 });
+    expect(v.state().overAxioms).not.toBeNull();
+    v.state().setProposedView(true);
+    expect(v.state().proposedView).toBe(true);
+    expect(v.state().overAxioms).toBeNull();
+    const w = setup(spyroProvedGraph());
+    w.state().receive(hostMessage('run', { run: reviewRun(p) }));
+    w.state().setOverAxioms({ id: GOAL, count: 1 });
+    w.state().receive(hostMessage('proposal', { proposal: p }));
+    expect(w.state().proposedView).toBe(true);
+    expect(w.state().overAxioms).toBeNull();
+  });
+
+  it('a drop on the column lands where it was dropped (slice 1d carry-over): the kind change carries the axiom it goes before', () => {
+    const t = setup();
+    t.state().moveToAxioms(GOAL, PG);
+    expect(t.state().dialog).toMatchObject({ kind: 'rationale', id: GOAL, to: 'AXIOM', beforeId: PG });
+    t.state().confirmRationale('it is what I hold');
+    expect(t.ofType('kindChange').at(-1)?.payload).toMatchObject({ id: GOAL, from: 'PROPOSITION', to: 'AXIOM', beforeId: PG });
+    // Not an axiom of the column (or none): the end of the column.
+    const u = setup();
+    u.state().moveToAxioms(GOAL, 'no-such-card');
+    expect(u.state().dialog).toMatchObject({ kind: 'rationale', beforeId: null });
+  });
+});
+
+describe('which gestures work when (ES-9; gestureGateOf)', () => {
+  it('everything on an idle board; during a run or a start on its way, only selecting; the Proposed view, nothing', () => {
+    const t = setup(spyroProvedGraph());
+    expect(gestureGateOf(t.state())).toEqual({ draw: null, move: null, select: true });
+    t.store.setState({ runBusy: { action: 'start', requestId: 'r9' } });
+    expect(gestureGateOf(t.state())).toEqual({ draw: EDIT_SESSION_ACTIVE, move: EDIT_SESSION_ACTIVE, select: true });
+    t.store.setState({ runBusy: null });
+    const p = normativeProposal();
+    t.state().receive(hostMessage('run', { run: reviewRun(p) }));
+    expect(gestureGateOf(t.state())).toEqual({ draw: EDIT_SESSION_ACTIVE, move: EDIT_SESSION_ACTIVE, select: true });
+    t.state().receive(hostMessage('proposal', { proposal: p }));
+    expect(t.state().proposedView).toBe(true);
+    expect(gestureGateOf(t.state())).toEqual({ draw: MENU_PROPOSED_ARROWS, move: MENU_PROPOSED_READ_ONLY, select: false });
+    // Back on the Current view during the session: the session's reason.
+    t.state().setProposedView(false);
+    expect(gestureGateOf(t.state()).draw).toBe(EDIT_SESSION_ACTIVE);
+  });
+
+  it('a draw released on a card adds one arrow, source → target (the store\'s addArrows; an axiom asks first, AR-6)', () => {
+    const t = setup(spyroProvedGraph());
+    // Into an axiom: the impact dialog, nothing sent yet.
+    expect(t.state().addArrows(PG, [DARK])).toBe(true);
+    expect(t.ofType('addArrows')).toEqual([]);
+    expect(t.state().dialog).toMatchObject({ kind: 'arrows', id: PG, change: { kind: 'add-arrows', target: PG, sources: [DARK] } });
+  });
+});
diff --git a/packages/webview/test/unit/store-lock.test.ts b/packages/webview/test/unit/store-lock.test.ts
new file mode 100644
index 0000000..7a57fd4
--- /dev/null
+++ b/packages/webview/test/unit/store-lock.test.ts
@@ -0,0 +1,276 @@
+/**
+ * Spec v4 ES-7, ES-9, UN-1, UN-3, A27 (slice 1f): while a run of the model folder is active (any subject, any state
+ * before it ends), or this board's start is on its way, the Current board is read-only. Every edit action of the store
+ * posts nothing and changes nothing (an info toast says why), Undo and Redo post nothing at all (the disabled buttons
+ * say why), an edit under way ends when the lock begins, and viewing keeps working. The Proposed view never posts a
+ * board Undo either.
+ */
+import { EDIT_SESSION_ACTIVE, hostMessage, spyroGraph, type ActionOutcome, type ProposalView, type RunState, type RunView, type TlGraph, type WebviewToHostMessage } from '@telelean/core';
+import { describe, expect, it } from 'vitest';
+import {
+  arrowLock,
+  createBoardStore,
+  editLock,
+  PROPOSED_ARROWS_LOCKED,
+  PROPOSED_NO_UNDO,
+  undoLock,
+  undoRedoButtons,
+} from '../../src/state/store';
+import { historyListing, workspaceState } from '../shared/graphs';
+import { normativeProposal, reviewRun, runView, TARGET } from '../shared/runs';
+
+const DARK = 'cynder-dark-past';
+const ACTIVE: readonly RunState[] = ['starting', 'working', 'waiting-for-answer', 'gate', 'review', 'interrupted'];
+const ENDED: readonly RunState[] = ['accepted', 'discarded', 'cancelled', 'failed'];
+
+function setup(graph: TlGraph = spyroGraph()) {
+  const sent: WebviewToHostMessage[] = [];
+  const store = createBoardStore((m) => sent.push(m), { today: () => '2026-11-19', setTimer: () => undefined, persist: () => undefined });
+  store.getState().applyGraph(graph);
+  const state = () => store.getState();
+  const run = (value: RunView | null) => state().receive(hostMessage('run', { run: value }));
+  const proposal = (value: ProposalView | null) => state().receive(hostMessage('proposal', { proposal: value }));
+  const result = (requestId: string, outcome: ActionOutcome) => state().receive(hostMessage('actionResult', { requestId, outcome }));
+  state().receive(hostMessage('workspace', { state: workspaceState() }));
+  return { store, sent, state, run, proposal, result };
+}
+
+/** Every edit gesture the store offers, each tried once on the board on screen. */
+function tryEveryEdit(t: ReturnType<typeof setup>): Record<string, unknown> {
+  const s = t.state;
+  const out: Record<string, unknown> = {};
+  out.addNode = s().addNode('AXIOM', 'Critics notice ratings');
+  out.editNode = s().editNode(TARGET, 'naturalName', 'Cynder would be a bad addition');
+  s().startEdit(TARGET, 'rationale');
+  out.editing = s().editing;
+  s().openDelete(DARK);
+  out.deleteDialog = s().dialog;
+  s().deleteNode(DARK, false);
+  s().requestKindChange(TARGET, 'AXIOM', null);
+  s().moveToAxioms(TARGET);
+  s().dropCard(TARGET, 'AXIOM', null);
+  s().reorder(DARK, null);
+  out.moveCard = s().moveCard(DARK, 1);
+  out.addArrows = s().addArrows(TARGET, ['new-spyro-pg']);
+  out.removeArrows = s().removeArrows([{ source: DARK, target: TARGET }]);
+  out.setFromNothing = s().setFromNothing('new-spyro-pg', true);
+  s().clickCard(DARK, false);
+  out.drawArrows = s().drawArrowsFromSelection(TARGET);
+  s().claimPending(TARGET);
+  s().moveCards({ [TARGET]: { x: 10, y: 20 } });
+  s().selectIncomingArrows(TARGET);
+  out.deleteSelected = s().deleteSelectedArrows();
+  // Slice 1c2: the Delete key, with arrows selected and a card focused.
+  out.pressDelete = s().pressDelete(DARK);
+  const entry = historyListing().entries[0];
+  if (entry) s().openRevert(entry);
+  out.revertDialog = s().dialog;
+  s().revertHistory('c0ffee1');
+  let created: ActionOutcome | undefined;
+  s().createSubject('Bayonetta', (outcome) => (created = outcome));
+  out.createSubject = created;
+  s().undo();
+  s().redo();
+  out.dialog = s().dialog;
+  return out;
+}
+
+/** The message types that change the user's files (none may be posted while the board is locked). */
+const EDIT_TYPES = new Set([
+  'addNode',
+  'editNode',
+  'deleteNode',
+  'kindChange',
+  'reorder',
+  'theseSuffice',
+  'createSubject',
+  'addArrows',
+  'removeArrows',
+  'setFromNothing',
+  'claimPending',
+  'moveCards',
+  'undo',
+  'redo',
+  'historyRevert',
+]);
+const edits = (sent: readonly WebviewToHostMessage[]) => sent.filter((m) => EDIT_TYPES.has(m.type));
+
+describe('editLock (ES-9): when the Current board is read-only', () => {
+  it('while a run of the model folder is active, in any state and on any subject; not once it has ended', () => {
+    expect(editLock({ run: null, runBusy: null })).toBeNull();
+    for (const state of ACTIVE) {
+      expect(editLock({ run: runView({ state }), runBusy: null }), state).toBe(EDIT_SESSION_ACTIVE);
+      expect(editLock({ run: runView({ state, subject: 'Bayonetta' }), runBusy: null }), state).toBe(EDIT_SESSION_ACTIVE);
+    }
+    for (const state of ENDED) expect(editLock({ run: runView({ state }), runBusy: null }), state).toBeNull();
+    // This board's start is on its way to the host: locked already (the host refuses edits then too).
+    expect(editLock({ run: null, runBusy: { action: 'start', requestId: 'r1' } })).toBe(EDIT_SESSION_ACTIVE);
+    expect(editLock({ run: null, runBusy: { action: 'accept', requestId: 'r1' } })).toBeNull();
+    expect(EDIT_SESSION_ACTIVE).toBe("An edit session is active: the board can't be edited until you accept or discard it.");
+  });
+});
+
+describe('the store while the board is locked', () => {
+  it('no edit gesture posts anything or changes the board; an info toast says why (Undo and Redo stay silent, A27)', () => {
+    const t = setup();
+    t.run(runView({ state: 'working' }));
+    const before = { nodes: t.state().nodes, order: t.state().order, edges: t.state().edges, positions: t.state().positions };
+    const out = tryEveryEdit(t);
+    expect(edits(t.sent)).toEqual([]);
+    expect({ nodes: t.state().nodes, order: t.state().order, edges: t.state().edges, positions: t.state().positions }).toEqual(before);
+    expect(out).toMatchObject({
+      addNode: null,
+      editNode: false,
+      editing: null,
+      deleteDialog: null,
+      moveCard: false,
+      addArrows: false,
+      removeArrows: false,
+      setFromNothing: false,
+      drawArrows: false,
+      deleteSelected: true, // handled: nothing sent, and the card's delete dialog stays shut
+      pressDelete: true, // the same through the key (slice 1c2)
+      revertDialog: null,
+      createSubject: { ok: false, code: 'conflict', error: EDIT_SESSION_ACTIVE },
+      dialog: null,
+    });
+    expect(Object.keys(t.state().provisional)).toEqual([]);
+    expect(t.state().toasts.map((x) => [x.level, x.text])).toEqual([['info', EDIT_SESSION_ACTIVE]]);
+  });
+
+  it('Undo and Redo post nothing and add no toast (the disabled buttons say why)', () => {
+    const t = setup();
+    t.run(runView({ state: 'review' }));
+    t.state().undo();
+    t.state().redo();
+    expect(t.sent.filter((m) => m.type === 'undo' || m.type === 'redo')).toEqual([]);
+    expect(t.state().toasts).toEqual([]);
+  });
+
+  it('viewing keeps working: select, expand, arrows into a card, Esc, history list and preview, copy, open, subjects', () => {
+    const t = setup();
+    t.run(runView({ state: 'working', subject: 'Bayonetta' })); // another subject's run locks this board too
+    t.state().clickCard(DARK, false);
+    expect(t.state().selected).toEqual([DARK]);
+    t.state().clickCard(TARGET, true);
+    expect(t.state().selected).toEqual([DARK, TARGET]);
+    t.state().toggleExpanded(TARGET);
+    expect(t.state().expanded[TARGET]).toBe(true);
+    expect(t.state().selectIncomingArrows(TARGET)).toBe(true);
+    expect(t.state().selectedArrows.map((a) => a.source)).toEqual([DARK, 'new-spyro-pg', 'pg-no-dark-past']);
+    t.state().clearSelection();
+    expect(t.state().selectedArrows).toEqual([]);
+    t.state().requestHistory();
+    t.state().previewHistory('c0ffee1', 'parent');
+    expect(t.state().copyText('abbrev x : Prop := y')).toBe(true);
+    t.state().openInEditor('Model/Spyro/Main.lean');
+    t.state().selectSubject('Bayonetta');
+    // (Selecting a card's incoming arrows clears the card selection: the third `select`.)
+    expect(t.sent.map((m) => m.type)).toEqual(['select', 'select', 'select', 'historyList', 'historyPreview', 'copyText', 'openInEditor', 'selectSubject']);
+    expect(edits(t.sent)).toEqual([]);
+  });
+
+  it('when the lock begins, an inline edit, a drag and an edit dialog under way end', () => {
+    const t = setup();
+    t.state().startEdit(TARGET, 'naturalName');
+    t.state().startDrag(DARK);
+    t.state().openDelete(DARK);
+    expect(t.state().editing).not.toBeNull();
+    expect(t.state().drag).not.toBeNull();
+    expect(t.state().dialog).toMatchObject({ kind: 'delete' });
+    t.run(runView({ state: 'starting' }));
+    expect(t.state().editing).toBeNull();
+    expect(t.state().drag).toBeNull();
+    expect(t.state().dialog).toBeNull();
+    // A drag cannot start while locked.
+    t.state().startDrag(DARK);
+    expect(t.state().drag).toBeNull();
+  });
+
+  it('a dialog answered after the lock began sends nothing', () => {
+    const t = setup();
+    t.state().moveToAxioms(TARGET); // the impact first: the rationale dialog
+    expect(t.state().dialog).toMatchObject({ kind: 'rationale' });
+    // The lock begins with a start on its way (no run message yet): the dialog stays, but its answer is refused.
+    t.store.setState({ runBusy: { action: 'start', requestId: 'r9' } });
+    t.state().confirmRationale('a friend said so');
+    expect(edits(t.sent)).toEqual([]);
+    expect(t.state().dialog).toBeNull();
+    expect(t.state().nodes[TARGET]?.type).toBe('PROPOSITION');
+  });
+
+  it('a start on its way locks the board; a refused start unlocks it; an ended run unlocks it too (UN-3: Undo works again)', () => {
+    const t = setup();
+    // Slice 1e: Formalize for dependencies on a selected arrow (the tray's "These suffice" is gone).
+    t.state().selectArrow(DARK, TARGET, false);
+    expect(t.state().formalize()).toBe(true);
+    expect(t.sent.at(-1)?.type).toBe('startRun');
+    expect(t.state().addNode('AXIOM', 'Critics notice ratings')).toBeNull();
+    t.result('r1', { ok: false, code: 'not-yet', error: 'Claude could not be started: no binary' });
+    expect(editLock(t.state())).toBeNull();
+    expect(t.state().addNode('AXIOM', 'Critics notice ratings')).not.toBeNull();
+    // A run that ends (here: accepted) unlocks the board: Undo reaches the host again (the Accept is its newest step).
+    t.run(runView({ state: 'review' }));
+    t.state().undo();
+    expect(t.sent.filter((m) => m.type === 'undo')).toEqual([]);
+    t.run(runView({ state: 'accepted', accepted: { changedFiles: true } }));
+    t.state().undo();
+    expect(t.sent.filter((m) => m.type === 'undo')).toHaveLength(1);
+  });
+});
+
+describe('the Proposed view never posts a board edit or a board Undo (UN-1)', () => {
+  it('during a review: nothing posts; the arrow actions have their own reason', () => {
+    const t = setup();
+    const p = normativeProposal();
+    t.run(reviewRun(p));
+    t.proposal(p);
+    expect(t.state().proposedView).toBe(true);
+    tryEveryEdit(t);
+    expect(edits(t.sent)).toEqual([]);
+    expect(arrowLock(t.state())).toBe(PROPOSED_ARROWS_LOCKED);
+    expect(PROPOSED_ARROWS_LOCKED).toBe('Arrows change only through review items and transforms.');
+    // Current | Proposed still switches; on Current the session's own reason applies.
+    t.state().setProposedView(false);
+    expect(arrowLock(t.state())).toBe(EDIT_SESSION_ACTIVE);
+  });
+
+  it('a proposal on screen without an active run (should one ever be): Undo still posts nothing', () => {
+    const t = setup();
+    t.proposal(normativeProposal());
+    expect(t.state().proposedView).toBe(true);
+    expect(editLock(t.state())).toBeNull();
+    expect(undoLock(t.state())).toBe(PROPOSED_NO_UNDO);
+    t.state().undo();
+    t.state().redo();
+    expect(t.sent.filter((m) => m.type === 'undo' || m.type === 'redo')).toEqual([]);
+  });
+});
+
+describe('the header\'s Undo and Redo buttons (UN-3, A27)', () => {
+  const workspace = { undo: 'Add axiom: Critics notice ratings', redo: 'Delete: The new Spyro game is PG' };
+
+  it('enabled with the step as tooltip when unlocked; disabled with the reason while locked, even with steps to undo', () => {
+    expect(undoRedoButtons(workspace, null)).toEqual({
+      undo: { disabled: false, title: 'Undo: Add axiom: Critics notice ratings (Ctrl+Z)' },
+      redo: { disabled: false, title: 'Redo: Delete: The new Spyro game is PG (Ctrl+Shift+Z)' },
+    });
+    expect(undoRedoButtons({ undo: null, redo: null }, null)).toEqual({ undo: { disabled: true, title: 'Nothing to undo' }, redo: { disabled: true, title: 'Nothing to redo' } });
+    expect(undoRedoButtons(workspace, EDIT_SESSION_ACTIVE)).toEqual({
+      undo: { disabled: true, title: EDIT_SESSION_ACTIVE },
+      redo: { disabled: true, title: EDIT_SESSION_ACTIVE },
+    });
+  });
+
+  it('undoLock: the session\'s reason on the Current view and in the Proposed view; none without a run', () => {
+    const t = setup();
+    expect(undoLock(t.state())).toBeNull();
+    const p = normativeProposal();
+    t.run(reviewRun(p));
+    expect(undoLock(t.state())).toBe(EDIT_SESSION_ACTIVE);
+    t.proposal(p);
+    expect(t.state().proposedView).toBe(true);
+    expect(undoLock(t.state())).toBe(EDIT_SESSION_ACTIVE);
+    expect(undoRedoButtons(t.state().workspace, undoLock(t.state())).undo).toEqual({ disabled: true, title: EDIT_SESSION_ACTIVE });
+  });
+});
