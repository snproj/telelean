+      ...(a.partOfResult !== undefined ? { partOfResult: a.partOfResult } : {}),
+      contentKey,
+      content,
+      ...(asInBase.has(a.key) ? { asInBase: true as const } : {}),
+      ...(factsMissing ? { factsMissing: true as const } : {}),
+    };
+  }
