index 0000000..99ca347
--- /dev/null
+++ b/packages/core/src/review/classify.ts
@@ -0,0 +1,249 @@
+/**
+ * Slice 2a2 (docs/slice2-plan.md section 4.4): RV-7 classes, the items that need their own Accept.
+ *
+ * belief, if any of:
+ *  - b1: an Add of an AXIOM card; any Add premise;
+ *  - b2: a Formalize or Change of an AXIOM card (its sentence, statement or `.holds`);
+ *  - b3: a Lean axiom that is new or changed (presuppositions, pending claims, axiom `.holds`, unmarked axioms), except
+ *    a shape-passing sort, predicate, constant or function;
+ *  - b4: a new or changed definition, instance, coercion, structure, inductive, class, opaque or abbrev in R_stmt (the
+ *    judged state's, and also B's for an existing name), except the cards' statement abbrevs (their docstring mirrors
+ *    are part of their text); any change to existing vocabulary in either R_stmt;
+ *  - (b5 is slice 3's "meaning changed" item.)
+ * changes what is proved, if any of:
+ *  - c1: a card statement or a `.holds` theorem of B is changed or removed (Change, Delete, a Result that replaces your
+ *    proof; `axiom T.holds` becoming a theorem is not c1: pending counts as no proof); builder 2a2: also an existing
+ *    theorem bound to no card that a vocabulary change changes (RV-7: "changes a Lean ... proof that existed when the
+ *    session started");
+ *  - c2: a Result whose target's statement exists in B and differs ("proves a statement changed in this session"):
+ *    builder 2a2, only when W's T.holds is a theorem, since a Result with no proof proves nothing;
+ *  - c3: a changed sentence on a card with Lean;
+ *  - c4: every Add arrow, marked "adds no new basis" when basis(source) ⊆ ⋃ basis(Q's sources) (AF8).
+ *
+ * A closure that cannot see what a statement reaches (`complete: false`, D2-25) makes every new or changed definition
+ * and instance a belief, with `complete: false`.
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import type { DeclFacts } from '../facts.js';
+import { holdsName, probeFailure, SORRY_AXIOM } from '../facts.js';
+import { declTables, factsOf, isAxiom, type DeclEntry } from '../gate/decls.js';
+import { keywordKind } from '../project/factsIndex.js';
+import { normalizeWhitespace } from '../project/text.js';
+import type { ProjectModel } from '../project/types.js';
+import { isPropValued, statementReach } from './closure.js';
+import { parseItemKey } from './keys.js';
+import type { ClassReason, ItemClass, ItemDraft, PremiseDraft, SessionInference } from './types.js';
+
+/** b4's kinds (an abbrev is a `def` in the facts). */
+const B4_KINDS: ReadonlySet<string> = new Set(['def', 'opaque', 'instance', 'structure', 'inductive', 'class']);
+/** Vocabulary kinds of a shape-passing term. */
+const TERM_KINDS: ReadonlySet<string> = new Set(['sort', 'predicate', 'constant', 'function']);
+
+interface Decl {
+  entry?: DeclEntry;
+  facts?: DeclFacts;
+}
+
+function declOf(model: ProjectModel, name: string): Decl | undefined {
+  const entry = declTables(model).byName.get(name);
+  const facts = factsOf(model, name, entry) ?? model.declFacts.get(name);
+  if (entry === undefined && facts === undefined) return undefined;
+  return { ...(entry ? { entry } : {}), ...(facts ? { facts } : {}) };
+}
+
+function kindOf(d: Decl): string | undefined {
+  if (d.facts?.kind !== undefined) return d.facts.kind;
+  const keyword = d.entry?.decl.keyword;
+  return keyword === undefined ? undefined : keyword === 'instance' ? 'instance' : keywordKind(keyword);
+}
+
+/** The facts agree where both have them (the fields computeItems compares, D2-41). */
+function factsAgree(a: DeclFacts | undefined, b: DeclFacts | undefined): boolean {
+  if (a === undefined || b === undefined) return true;
+  const set = (x: readonly string[] | undefined) => (x === undefined ? undefined : [...new Set(x)].sort().join('\u0000'));
+  const both = (x: string | undefined, y: string | undefined) => x === undefined || y === undefined || x === y;
+  const norm = (x: string | undefined) => (x === undefined ? undefined : normalizeWhitespace(x));
+  return (
+    both(a.kind, b.kind) &&
+    both(norm(a.type), norm(b.type)) &&
+    both(norm(a.value), norm(b.value)) &&
+    both(set(a.valueConsts), set(b.valueConsts)) &&
+    both(set(a.typeConsts), set(b.typeConsts))
+  );
+}
+
+/** The declaration differs between B and W: new, removed, or another text or facts. */
+function differs(b: Decl | undefined, w: Decl | undefined): boolean {
+  if (b === undefined || w === undefined) return b !== w;
+  return b.entry?.text !== w.entry?.text || !factsAgree(b.facts, w.facts);
+}
+
+/** A shape-passing vocabulary term of the model (a sort, predicate, constant or function with no shape problem). */
+function isTerm(model: ProjectModel, name: string): boolean {
+  const item = model.vocabulary.find((v) => v.name === name);
+  return item !== undefined && TERM_KINDS.has(item.kind) && !item.flags.includes('shape-violation');
+}
+
+/** The standard axioms and Lean's own: never a card, a presupposition or an assumption of the model. */
+function basisOfFootprint(model: ProjectModel, axioms: readonly string[], cardOfHolds: ReadonlyMap<string, string>): Set<string> {
+  const out = new Set<string>();
+  for (const a of axioms) {
+    const card = cardOfHolds.get(a);
+    if (card !== undefined) {
+      out.add(card);
+      continue;
+    }
+    // Presuppositions and any other assumption of the model (an unmarked Prop axiom); vocabulary is no basis.
+    const f = model.declFacts.get(a);
+    if (f !== undefined && f.kind === 'axiom' && isPropValued(f)) out.add(a);
+  }
+  return out;
+}
+
+/**
+ * §4.4 (2a2). `withDrafts`: every premise draft's statement in R_stmt (`classes`), or none (`classesBeforeReveal`).
+ * `inferences` give Q's sources for c4's "adds no new basis", which it sets on the arrow item's class (AF8).
+ */
+export function classify(i: {
+  base: ProjectModel;
+  current: ProjectModel;
+  drafts: readonly ItemDraft[];
+  premises: readonly PremiseDraft[];
+  inferences: readonly SessionInference[];
+  withDrafts: boolean;
+}): Record<string, ItemClass> {
+  const B = i.base;
+  const W = i.current;
+  /**
+   * 2b2 (§2.1, AP30-5): the cause when the judged state's probe failed; such a class's Accept says it. Without the
+   * probe's detail in `classesBeforeReveal`, the map in force while the results are hidden (fixer 2b2 r1,
+   * A-V2B2-ADV-7: Lean's error can name hidden proof material, §4.7).
+   */
+  const failedProbe = probeFailure(W.facts, { detail: i.withDrafts });
+  const reachW = statementReach(W, i.withDrafts ? i.premises : []);
+  const reachB = statementReach(B, []);
+  /** The cards' statement abbrevs (b4's exception), in either state. */
+  const statements = new Set<string>();
+  for (const model of [B, W]) for (const n of model.nodes.values()) if (n.node.lean.statement !== undefined) statements.add(n.node.lean.statement);
+  const cardOfHolds = new Map<string, string>();
+  for (const n of W.nodes.values()) if (n.node.lean.statement !== undefined) cardOfHolds.set(holdsName(n.node.lean.statement), n.node.id);
+  const typeOf = (card: string) => W.nodes.get(card)?.node.type ?? B.nodes.get(card)?.node.type;
+
+  /**
+   * basis(u) (§4.4): {u} for an axiom or pending card, else u's footprint cards and presuppositions; undefined when
+   * unknown. A proof that uses `sorry` proves nothing: its basis is {u}, as a pending card's (fixer 2a, ADV-9).
+   */
+  const basis = (u: string): Set<string> | undefined => {
+    const node = W.nodes.get(u)?.node;
+    if (node === undefined || node.type === 'AXIOM' || node.lean.statement === undefined) return new Set([u]);
+    const holds = W.declFacts.get(holdsName(node.lean.statement));
+    if (holds === undefined || holds.kind === 'axiom') return new Set([u]);
+    if (holds.usesSorry === true || (holds.axioms ?? []).includes(SORRY_AXIOM)) return new Set([u]);
+    if (holds.axioms === undefined) return undefined;
+    return basisOfFootprint(W, holds.axioms, cardOfHolds);
+  };
+  const addsNoNewBasis = (source: string, target: string): boolean => {
+    const own = basis(source);
+    if (own === undefined) return false;
+    const covered = new Set<string>();
+    const question = i.inferences.find((inf) => inf.target === target)?.question.sources ?? [];
+    for (const q of question) for (const x of basis(q) ?? new Set([q])) covered.add(x);
+    return [...own].every((x) => covered.has(x));
+  };
+
+  const out: Record<string, ItemClass> = {};
+  for (const draft of i.drafts) {
+    const reasons: ClassReason[] = [];
+    let complete = true;
+    let noNewBasis: boolean | undefined;
+    const parsed = parseItemKey(draft.key);
+    const card = parsed?.kind === 'card' || parsed?.kind === 'proof' ? parsed.node : undefined;
+
+    // b1, b2: what the item adds or formalises.
+    if (draft.kind === 'add-premise') reasons.push({ code: 'b1', ...(draft.provides.cards.length > 0 ? { cards: [...draft.provides.cards] } : {}) });
+    if (draft.kind === 'add') {
+      const added = draft.provides.cards.filter((c) => W.nodes.get(c)?.node.type === 'AXIOM');
+      if (added.length > 0) reasons.push({ code: 'b1', cards: added });
+    }
+    if ((draft.kind === 'formalize' || draft.kind === 'change') && card !== undefined && typeOf(card) === 'AXIOM') reasons.push({ code: 'b2', cards: [card] });
+
+    // b3, b4: its declarations, new or changed.
+    for (const name of draft.provides.decls) {
+      const before = declOf(B, name);
+      const after = declOf(W, name);
+      if (after === undefined || !differs(before, after)) continue;
+      const term = isTerm(W, name);
+      if (isAxiom(after.entry, after.facts) && !term) {
+        reasons.push({ code: 'b3', name });
+        continue;
+      }
+      const vocabularyChange = draft.declKind === 'vocabulary-change';
+      if (!vocabularyChange && (term || statements.has(name) || !B4_KINDS.has(kindOf(after) ?? ''))) continue;
+      if (reachW.names.has(name) || (before !== undefined && reachB.names.has(name))) reasons.push({ code: 'b4', name });
+      else if (!reachW.complete || (before !== undefined && !reachB.complete)) {
+        // D2-25: R_stmt could not see what the statements reach, so the definition may lie in it.
+        reasons.push({ code: 'b4', name });
+        complete = false;
+      }
+    }
+
+    // c1-c3: statements and proofs that existed.
+    if ((draft.kind === 'change' || draft.kind === 'delete') && card !== undefined) reasons.push({ code: 'c1', cards: [card] });
+    if (draft.kind === 'declaration' && draft.declKind === 'vocabulary-change') {
+      for (const name of draft.provides.decls) {
+        const before = declOf(B, name);
+        if (before !== undefined && kindOf(before) === 'theorem' && differs(before, declOf(W, name))) reasons.push({ code: 'c1', name });
+      }
+    }
+    if (draft.kind === 'result' && card !== undefined) {
+      const statementB = B.nodes.get(card)?.node.lean.statement;
+      const statementW = W.nodes.get(card)?.node.lean.statement;
+      if (statementB !== undefined) {
+        const holds = holdsName(statementB);
+        const holdsB = declOf(B, holds);
+        // c1: B's proof replaced or removed (a pending `axiom T.holds` is no proof).
+        if (holdsB !== undefined && kindOf(holdsB) === 'theorem') {
+          const holdsW = statementW === undefined ? undefined : declOf(W, holdsName(statementW));
+          if (statementW === undefined || holdsName(statementW) !== holds || differs(holdsB, holdsW)) reasons.push({ code: 'c1', name: holds, cards: [card] });
+        }
+        // c2: a proof of a statement of B that changed; one first written in this session is not changed, and a Result
+        // with no proof proves nothing.
+        const before = declOf(B, statementB);
+        const proof = statementW === undefined ? undefined : declOf(W, holdsName(statementW));
+        const proves = proof !== undefined && kindOf(proof) === 'theorem';
+        if (proves && before !== undefined && (statementW !== statementB || differs(before, declOf(W, statementB)))) reasons.push({ code: 'c2', name: statementB, cards: [card] });
+      }
+    }
+    if ((draft.kind === 'formalize' || draft.kind === 'change') && card !== undefined) {
+      const before = B.nodes.get(card)?.node;
+      const after = W.nodes.get(card)?.node;
+      if (before !== undefined && after !== undefined && after.lean.statement !== undefined && normalizeWhitespace(before.naturalName) !== normalizeWhitespace(after.naturalName))
+        reasons.push({ code: 'c3', cards: [card] });
+    }
+
+    // c4: every Add arrow.
+    if (draft.kind === 'add-arrow') {
+      const arrow = draft.provides.arrows[0] ?? (parsed?.kind === 'arrow' ? parsed.arrow : undefined);
+      if (arrow !== undefined) {
+        reasons.push({ code: 'c4', arrow: { ...arrow } });
+        noNewBasis = addsNoNewBasis(arrow.source, arrow.target);
+      }
+    }
+
+    const belief = !complete || reasons.some((r) => r.code.startsWith('b'));
+    const changesProved = reasons.some((r) => r.code.startsWith('c'));
+    out[draft.key] = {
+      belief,
+      changesProved,
+      reasons,
+      complete,
+      ...(noNewBasis !== undefined ? { addsNoNewBasis: noNewBasis } : {}),
+      // ADV-3: its declarations have no facts (their module did not build): the class is not known.
+      ...(draft.factsMissing === true ? { factsMissing: true as const } : {}),
+      // 2b2 (AP30-5): when the state's probe failed, the cause, which no later check lifts (the reducer's Accept says it).
+      ...(draft.factsMissing === true && failedProbe !== undefined ? { probeFailure: failedProbe } : {}),
+    };
+  }
+  return out;
+}
diff --git a/packages/core/src/review/closure.ts b/packages/core/src/review/closure.ts
new file mode 100644
index 0000000..60f8461
--- /dev/null
+++ b/packages/core/src/review/closure.ts
@@ -0,0 +1,197 @@
+/**
+ * Slice 2a1 (docs/slice2-plan.md section 4.1): elaborated closures over the facts' `typeConsts` and `valueConsts`.
+ *
+ *  - `constsOf(f, mode)`: one declaration's constants. `meaning` (statement closures): a theorem, a Prop-valued
+ *    declaration, an axiom or an opaque gives its typeConsts; a def, abbrev, data instance or other gives typeConsts ∪
+ *    valueConsts; an inductive, structure or class gives its typeConsts (constructors included, §2.1). `uses` (item
+ *    dependencies, proofs): typeConsts ∪ valueConsts for every kind. Undefined when an array it needs is missing.
+ *  - `reach(model, start, mode, stopAt?)`: a breadth-first walk from several sources, memoised per model.
+ *  - `statementReach(model, drafts)`: R_stmt, the meaning closure of every card statement of every subject, plus the
+ *    statements of the given Add premise drafts (from `PremiseDraft.facts`), with `by` (who reaches each name).
+ *
+ * A closure that meets a declaration without facts, or without an array its mode needs, is `complete: false` (D2-25:
+ * classes then count belief, and Apply is refused; that is the readers' part).
+ */
+import type { DeclFacts } from '../facts.js';
+import { declTables } from '../gate/decls.js';
+import type { ProjectModel } from '../project/types.js';
+import { normalizeWhitespace } from '../project/text.js';
+import { premiseKey } from './keys.js';
+import type { PremiseDraft } from './types.js';
+
+export type ClosureMode = 'meaning' | 'uses';
+
+/** What a walk reached. */
+export interface Reach {
+  /** Every declaration of the model the walk reached, its starts included. */
+  names: ReadonlySet<string>;
+  /** False when the walk met a declaration with no facts, or without the constants its mode needs. */
+  complete: boolean;
+  /** Those declarations, in the order the walk met them. */
+  missing: string[];
+}
+
+/** R_stmt (§4.1). */
+export interface StatementReach extends Reach {
+  /** Which cards' statements (card ids) and which drafts (their item keys, `premise:<T>:<leanName>`) reach each name. */
+  by: Record<string, string[]>;
+}
+
+const STRUCTURAL = new Set(['inductive', 'structure', 'class']);
+const TYPE_ONLY = new Set(['theorem', 'axiom', 'opaque']);
+
+const union = (a: readonly string[], b: readonly string[]): string[] => [...new Set([...a, ...b])];
+
+/** Whether the declaration is a proof of a proposition (its type's sort is `Prop`). */
+export function isPropValued(f: DeclFacts): boolean {
+  return f.typeSort !== undefined && normalizeWhitespace(f.typeSort) === 'Prop';
+}
+
+/** §4.1: a declaration's constants for a closure; undefined when an array the mode needs is missing. */
+export function constsOf(f: DeclFacts, mode: ClosureMode): string[] | undefined {
+  const type = f.typeConsts;
+  if (type === undefined) return undefined;
+  if (mode === 'meaning') {
+    if (f.kind !== undefined && STRUCTURAL.has(f.kind)) return [...new Set(type)];
+    if ((f.kind !== undefined && TYPE_ONLY.has(f.kind)) || isPropValued(f)) return [...new Set(type)];
+  }
+  const value = f.valueConsts;
+  if (value === undefined) return undefined;
+  return union(type, value);
+}
+
+/**
+ * A declaration's `uses` constants, or, when its facts lack an array (D2-25), the over-approximation `refs ∪
+ * valueConsts` with `complete: false`.
+ */
+export function usesOrRefs(f: DeclFacts): { names: string[]; complete: boolean } {
+  const uses = constsOf(f, 'uses');
+  if (uses !== undefined) return { names: uses, complete: true };
+  return { names: union(f.refs.map((r) => r.name), f.valueConsts ?? []), complete: false };
+}
+
+type Lookup = (name: string) => DeclFacts | undefined;
+
+function walk(lookup: Lookup, start: Iterable<string>, mode: ClosureMode, record: (name: string) => boolean, stopAt?: (name: string) => boolean): Reach {
+  const names = new Set<string>();
+  const missing: string[] = [];
+  const seen = new Set<string>();
+  const queue: Array<{ name: string; first: boolean }> = [];
+  for (const name of start) {
+    if (seen.has(name)) continue;
+    seen.add(name);
+    queue.push({ name, first: true });
+  }
+  for (let k = 0; k < queue.length; k++) {
+    const { name, first } = queue[k] as { name: string; first: boolean };
+    if (record(name)) names.add(name);
+    if (!first && stopAt?.(name) === true) continue;
+    const facts = lookup(name);
+    const next = facts === undefined ? undefined : constsOf(facts, mode);
+    if (next === undefined) {
+      missing.push(name);
+      continue;
+    }
+    for (const c of next) {
+      if (seen.has(c)) continue;
+      seen.add(c);
+      queue.push({ name: c, first: false });
+    }
+  }
+  return { names, complete: missing.length === 0, missing };
+}
+
+interface Memo {
+  meaning: Map<string, Reach>;
+  uses: Map<string, Reach>;
+}
+const memos = new WeakMap<ProjectModel, Memo>();
+
+function memoOf(model: ProjectModel): Memo {
+  let memo = memos.get(model);
+  if (!memo) {
+    memo = { meaning: new Map(), uses: new Map() };
+    memos.set(model, memo);
+  }
+  return memo;
+}
+
+const modelLookup = (model: ProjectModel): Lookup => (name) => model.declFacts.get(name);
+
+/** The closure of one declaration (memoised per model and mode). */
+function closureOf(model: ProjectModel, name: string, mode: ClosureMode): Reach {
+  const memo = memoOf(model)[mode];
+  let found = memo.get(name);
+  if (!found) {
+    found = walk(modelLookup(model), [name], mode, () => true);
+    memo.set(name, found);
+  }
+  return found;
+}
+
+/**
+ * §4.1: every declaration a breadth-first walk over `constsOf(·, mode)` reaches from `start` (the starts included).
+ * `stopAt`: a declaration the walk reaches (never a start) that it records but does not walk through, e.g. one another
+ * item owns (§4.5). Without `stopAt`, each start's closure is memoised per model.
+ */
+export function reach(model: ProjectModel, start: Iterable<string>, mode: ClosureMode, stopAt?: (name: string) => boolean): Reach {
+  if (stopAt !== undefined) return walk(modelLookup(model), start, mode, () => true, stopAt);
+  const names = new Set<string>();
+  const missing: string[] = [];
+  for (const name of start) {
+    const one = closureOf(model, name, mode);
+    for (const n of one.names) names.add(n);
+    for (const m of one.missing) if (!missing.includes(m)) missing.push(m);
+  }
+  return { names, complete: missing.length === 0, missing };
+}
+
+/**
+ * The meaning closure of one premise draft's statement alone: walked from its scratch facts (`PremiseDraft.facts`) into
+ * the model. `names` holds the model's declarations only (the draft's own scratch names are not in ws/).
+ * Fail closed (D2-25, fixer 2a1 F6): when the facts do not hold the draft's own statement (`leanName`, qualified or
+ * not), e.g. before its first check or after a failed re-check, the walk cannot see what the statement reaches, so it
+ * is `complete: false` with `leanName` first in `missing`.
+ */
+export function draftReach(model: ProjectModel, draft: PremiseDraft): Reach {
+  const tables = declTables(model);
+  const local = draft.facts;
+  const starts = Object.keys(local).sort();
+  const lookup: Lookup = (name) => model.declFacts.get(name) ?? (Object.hasOwn(local, name) ? local[name] : undefined);
+  const reached = walk(lookup, starts, 'meaning', (name) => model.declFacts.has(name) || tables.byName.has(name));
+  if (starts.some((name) => name === draft.leanName || name.endsWith(`.${draft.leanName}`))) return reached;
+  return { names: reached.names, complete: false, missing: [draft.leanName, ...reached.missing.filter((m) => m !== draft.leanName)] };
+}
+
+/**
+ * §4.1 R_stmt: the meaning closure of every card statement of every subject, through other statements, definitions,
+ * lemma types and instances (a `.holds` counts by its type only: `constsOf`), plus the statements of `drafts`
+ * (`draftReach`). `names` holds the model's declarations only. A card bound to a name no declaration has is skipped.
+ */
+export function statementReach(model: ProjectModel, drafts: readonly PremiseDraft[]): StatementReach {
+  const tables = declTables(model);
+  const inModel = (name: string) => model.declFacts.has(name) || tables.byName.has(name);
+  const names = new Set<string>();
+  const missing: string[] = [];
+  const by = new Map<string, Set<string>>();
+  const add = (reached: Reach, who: string) => {
+    for (const name of reached.names) {
+      if (!inModel(name)) continue;
+      names.add(name);
+      let list = by.get(name);
+      if (!list) by.set(name, (list = new Set()));
+      list.add(who);
+    }
+    for (const m of reached.missing) if (!missing.includes(m)) missing.push(m);
+  };
+  const ids = [...model.nodes.keys()].sort();
+  for (const id of ids) {
+    const statement = model.nodes.get(id)?.node.lean.statement;
+    if (statement === undefined || !inModel(statement)) continue;
+    add(closureOf(model, statement, 'meaning'), id);
+  }
+  for (const draft of drafts) add(draftReach(model, draft), premiseKey(draft.target, draft.leanName));
+  const byRecord: Record<string, string[]> = {};
+  for (const name of [...by.keys()].sort()) byRecord[name] = [...(by.get(name) ?? [])].sort();
+  return { names, complete: missing.length === 0, missing, by: byRecord };
+}
diff --git a/packages/core/src/review/deps.ts b/packages/core/src/review/deps.ts
new file mode 100644
index 0000000..26a01c0
--- /dev/null
+++ b/packages/core/src/review/deps.ts
@@ -0,0 +1,192 @@
+/**
+ * Slice 2a2 (docs/slice2-plan.md section 4.5): RV-5 item dependencies, edges I -> J on the judged state:
+ *  1. mentions: a walk over `constsOf(·, 'uses')` from I's declarations, through declarations no item owns and through
+ *     I's own, stopping at a declaration that J ≠ I owns (memoised per declaration, cycles included). Facts without
+ *     the constants over-approximate with refs ∪ valueConsts (`usesOrRefs`, D2-25);
+ *  2. Results: Result(T) -> Result(u) for every source u whose session proof the inference counts (B.1's
+ *     `throughResults`), and Result(T) -> the Add arrow or Add premise item of every arrow s -> T with s in direct(T);
+ *  3. an arrow item -> the item adding the card at either end (none in slice 2);
+ *  4. A17: an Add arrow -> every Remove arrow whose arrow lies on a cycle through it (none in slice 2);
+ *  5. mentioned before: a Change or Delete -> every J whose version in B mentions a name it changes or removes.
+ *
+ * Cycles are SCCs (D2-26): the reducer reads them (`scc.ts`). Which edges a listed item may show while the results are
+ * hidden is the reader's concern (§4.5's "Hidden items": the reducer and the view).
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import type { ArrowEnds } from '../actions.js';
+import { holdsName } from '../facts.js';
+import { declTables, factsOf } from '../gate/decls.js';
+import type { ProjectModel } from '../project/types.js';
+import { normalizeWhitespace } from '../project/text.js';
+import { usesOrRefs } from './closure.js';
+import { parseItemKey, proofKey } from './keys.js';
+import { stronglyConnected } from './scc.js';
+import type { InferenceJudgement, ItemDraft } from './types.js';
+
+/** A declaration's `uses` constants in a model (refs ∪ valueConsts without the arrays); [] without facts. */
+function usesIn(model: ProjectModel): (name: string) => string[] {
+  const memo = new Map<string, string[]>();
+  return (name) => {
+    let found = memo.get(name);
+    if (found === undefined) {
+      const entry = declTables(model).byName.get(name);
+      const facts = model.declFacts.get(name) ?? factsOf(model, name, entry);
+      found = facts === undefined ? [] : usesOrRefs(facts).names.filter((c) => c !== name);
+      memo.set(name, found);
+    }
+    return found;
+  };
+}
+
+/**
+ * The items a walk from a constant meets first (rule 1): the constant's owner, or, through declarations no item owns,
+ * the owners they reach. Memoised per declaration over SCCs, so a cycle of unowned declarations is walked once.
+ */
+function frontierWalker(model: ProjectModel, owner: ReadonlyMap<string, string>): (name: string) => ReadonlySet<string> {
+  const uses = usesIn(model);
+  const tables = declTables(model);
+  const known = (name: string) => model.declFacts.has(name) || tables.byName.has(name);
+  const memo = new Map<string, Set<string>>();
+  const none: ReadonlySet<string> = new Set();
+  return (start) => {
+    const own = owner.get(start);
+    if (own !== undefined) return new Set([own]);
+    if (!known(start)) return none;
+    const done = memo.get(start);
+    if (done !== undefined) return done;
+    const unowned = (name: string) => !owner.has(name) && known(name);
+    const components = stronglyConnected([start], (name) => uses(name).filter((c) => unowned(c) && !memo.has(c)));
+    for (const component of components) {
+      const set = new Set<string>();
+      const members = new Set(component);
+      for (const name of component) {
+        for (const c of uses(name)) {
+          const o = owner.get(c);
+          if (o !== undefined) set.add(o);
+          else if (!members.has(c)) for (const k of memo.get(c) ?? []) set.add(k);
+        }
+      }
+      for (const name of component) memo.set(name, set);
+    }
+    return memo.get(start) ?? none;
+  };
+}
+
+/** Whether `to` is reachable from `from` over the arrows (`from` itself counts). */
+function reaches(arrows: ReadonlyMap<string, readonly string[]>, from: string, to: string): boolean {
+  const seen = new Set([from]);
+  const queue = [from];
+  for (let k = 0; k < queue.length; k++) {
+    const at = queue[k] as string;
+    if (at === to) return true;
+    for (const next of arrows.get(at) ?? []) {
+      if (seen.has(next)) continue;
+      seen.add(next);
+      queue.push(next);
+    }
+  }
+  return false;
+}
+
+/** §4.5 (2a2): RV-5 edges by item key: the keys each item depends on, sorted; every draft has an entry. */
+export function itemDeps(i: {
+  base: ProjectModel;
+  current: ProjectModel;
+  drafts: readonly ItemDraft[];
+  inferences: Readonly<Record<string, InferenceJudgement>>;
+}): Record<string, string[]> {
+  const B = i.base;
+  const W = i.current;
+  const owner = new Map<string, string>();
+  for (const d of i.drafts) for (const name of d.provides.decls) if (!owner.has(name)) owner.set(name, d.key);
+  const edges = new Map<string, Set<string>>(i.drafts.map((d) => [d.key, new Set<string>()]));
+  const add = (from: string, to: string) => {
+    if (from !== to && edges.has(to)) edges.get(from)?.add(to);
+  };
+
+  // 1. mentions (a draft's `mentions` are its declarations' uses constants, its own names left out).
+  const frontier = frontierWalker(W, owner);
+  for (const d of i.drafts) for (const c of d.mentions) for (const k of frontier(c)) add(d.key, k);
+
+  // 2. Results.
+  const providers = (arrow: ArrowEnds) =>
+    i.drafts.filter((e) => (e.kind === 'add-arrow' || e.kind === 'add-premise') && e.provides.arrows.some((a) => a.source === arrow.source && a.target === arrow.target));
+  for (const d of i.drafts) {
+    if (d.kind !== 'result') continue;
+    const parsed = parseItemKey(d.key);
+    if (parsed?.kind !== 'proof') continue;
+    const target = parsed.node;
+    const judged = Object.hasOwn(i.inferences, target) ? i.inferences[target] : undefined;
+    if (judged === undefined) continue;
+    for (const u of judged.throughResults) add(d.key, proofKey(u));
+    for (const s of judged.direct) for (const e of providers({ source: s, target })) add(d.key, e.key);
+  }
+
+  // 3. An arrow item -> the item that adds the card at either of its ends.
+  for (const d of i.drafts) {
+    if (d.kind !== 'add-arrow' && d.kind !== 'remove-arrow') continue;
+    const parsed = parseItemKey(d.key);
+    const arrow = d.provides.arrows[0] ?? (parsed?.kind === 'arrow' || parsed?.kind === 'unarrow' ? parsed.arrow : undefined);
+    if (arrow === undefined) continue;
+    for (const e of i.drafts) {
+      if (e.kind !== 'add' && e.kind !== 'add-premise') continue;
+      if (e.provides.cards.includes(arrow.source) || e.provides.cards.includes(arrow.target)) add(d.key, e.key);
+    }
+  }
+
+  // 4. A17: an Add arrow s -> t depends on a Remove arrow x -> y on a cycle through it (t ⇝ x -> y ⇝ s).
+  const removes = i.drafts.filter((d) => d.kind === 'remove-arrow');
+  if (removes.length > 0) {
+    const arrows = new Map<string, string[]>();
+    const draw = (source: string, target: string) => arrows.set(source, [...(arrows.get(source) ?? []), target]);
+    for (const n of W.nodes.values()) for (const source of n.node.premises) draw(source, n.node.id);
+    const removed = removes.map((r) => ({ key: r.key, arrow: parseItemKey(r.key) })).filter((r) => r.arrow?.kind === 'unarrow');
+    for (const r of removed) if (r.arrow?.kind === 'unarrow') draw(r.arrow.arrow.source, r.arrow.arrow.target);
+    for (const d of i.drafts) {
+      if (d.kind !== 'add-arrow') continue;
+      const added = d.provides.arrows[0];
+      if (added === undefined) continue;
+      for (const r of removed) {
+        if (r.arrow?.kind !== 'unarrow') continue;
+        const { source: x, target: y } = r.arrow.arrow;
+        if (reaches(arrows, added.target, x) && reaches(arrows, y, added.source)) add(d.key, r.key);
+      }
+    }
+  }
+
+  // 5. Mentioned before: a Change or Delete -> every J whose version in B mentions a name it changes or removes.
+  const boundIn = (model: ProjectModel, card: string) => [...model.ownerOfDecl].filter(([, id]) => id === card).map(([name]) => name);
+  const usesB = usesIn(B);
+  const textOf = (model: ProjectModel, name: string) => declTables(model).byName.get(name)?.text;
+  const versionInB = (e: ItemDraft): string[] => {
+    const parsed = parseItemKey(e.key);
+    if (parsed?.kind === 'card') return boundIn(B, parsed.node);
+    if (parsed?.kind === 'proof') {
+      const statement = B.nodes.get(parsed.node)?.node.lean.statement;
+      return statement === undefined ? [] : [holdsName(statement)];
+    }
+    if (parsed?.kind === 'vocab' || parsed?.kind === 'decl') return [parsed.name];
+    return [];
+  };
+  for (const d of i.drafts) {
+    if (d.kind !== 'change' && d.kind !== 'delete') continue;
+    const parsed = parseItemKey(d.key);
+    if (parsed?.kind !== 'card') continue;
+    const touched = new Set(
+      boundIn(B, parsed.node).filter((name) => {
+        const after = textOf(W, name);
+        return after === undefined || normalizeWhitespace(after) !== normalizeWhitespace(textOf(B, name) ?? '');
+      }),
+    );
+    if (touched.size === 0) continue;
+    for (const e of i.drafts) {
+      if (e.key === d.key) continue;
+      if (versionInB(e).some((name) => usesB(name).some((c) => touched.has(c)))) add(d.key, e.key);
+    }
+  }
+
+  const out: Record<string, string[]> = {};
+  for (const d of i.drafts) out[d.key] = [...(edges.get(d.key) ?? [])].sort();
+  return out;
+}
diff --git a/packages/core/src/review/formalize.ts b/packages/core/src/review/formalize.ts
new file mode 100644
index 0000000..36e7dce
--- /dev/null
+++ b/packages/core/src/review/formalize.ts
@@ -0,0 +1,137 @@
+/**
+ * Slice 2b2 (docs/slice2-plan.md section 4.12): Formalize for several targets, at the start of a session and during a
+ * stage (RV-9). Slice 1's one-target check stays in `core/src/formalize.ts` (`formalizeStartProblem`), whose texts and
+ * cycle check these share.
+ *
+ * `formalizeStartProblems(board, inferences, session?)` checks, in this order, and returns every problem it finds,
+ * ordered by check (then by the request's order):
+ *  1. every target is a card of the board's subject, the session's for a mid-stage Formalize, and asked once;
+ *  2. in a session, the results are shown (D2-65): while they are hidden, every request gets this text, and nothing
+ *     after it is checked, so no answer can depend on whether a proof exists;
+ *  3. each target is a proposition whose premises are the sources of arrows drawn into it (in a session Claude's
+ *     accepted arrows count, one still in review gives "Accept this arrow first.", D2-20); an empty question needs the
+ *     mark; in a session, no target has a Shaky item (D2-53), and a new target that is the source of Claude's arrow into
+ *     another target is refused unless the same request selects that arrow (D2-50);
+ *  4. a proposition source without a `.holds` that is no target of the same request: "mark it pending first" outside a
+ *     session, "select the arrows into it too" in one (AR-8: no pending mark during a session);
+ *  5. in a session, a source whose Result is declined Shaky or to be redone (D2-53);
+ *  6. any cycle of drawn and solid arrows in the subject (AP-13; AP-29, G2), named.
+ *
+ * `formalizeOrder(board, inferences)`: a target that is a source of another target's question comes first; ties by
+ * reading order (the board's order of its cards).
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import { FORMALIZE_START_TEXTS, formalizeCycleProblem, needsHoldsFirst } from '../formalize.js';
+import type { TlGraph, TlNode } from '../model.js';
+import { cutText } from '../project/text.js';
+import { REVIEW_TEXTS } from './texts.js';
+import type { FormalizeSession, StartProblem } from './types.js';
+
+type Request = ReadonlyArray<{ target: string; premises: readonly string[] }>;
+
+/** §4.12 (2b2): the start checks 1-6, in their order; [] when the request may start. */
+export function formalizeStartProblems(board: TlGraph, inferences: Request, session?: FormalizeSession): StartProblem[] {
+  const nodes = new Map<string, TlNode>(board.nodes.map((n) => [n.id, n]));
+  const sentence = (id: string) => cutText(nodes.get(id)?.naturalName ?? id, 60);
+  const subject = session?.subject ?? board.subject;
+
+  // 1. One subject, the session's for a mid-stage Formalize; each target once; something asked (the validator's 1-50).
+  const first: StartProblem[] = [];
+  if (session !== undefined && board.subject !== session.subject) first.push({ check: 1, text: REVIEW_TEXTS.runElsewhere(session.subject) });
+  if (inferences.length === 0) first.push({ check: 1, text: FORMALIZE_START_TEXTS.oneTarget });
+  const asked = new Set<string>();
+  for (const { target } of inferences) {
+    const t = nodes.get(target);
+    if (t === undefined || t.subject !== subject) first.push({ check: 1, text: `The target "${target}" is not a card of ${subject}.`, card: target });
+    else if (asked.has(target)) first.push({ check: 1, text: REVIEW_TEXTS.askedTwice(sentence(target)), card: target });
+    asked.add(target);
+  }
+  // 2. In a session, nothing before the results are shown (D2-65).
+  if (session !== undefined && !session.resultsShown) return [...first, { check: 2, text: REVIEW_TEXTS.formalizeResultsHidden }];
+  if (first.length > 0) return first;
+
+  const problems: StartProblem[] = [];
+  const targets = new Set(inferences.map((inf) => inf.target));
+  const selected = (source: string, target: string) => inferences.some((inf) => inf.target === target && inf.premises.includes(source));
+  const arrowItem = (source: string, target: string) => session?.arrows.find((a) => a.source === source && a.target === target);
+  const sessionTargets = new Set(session?.targets ?? []);
+
+  // 3. Each target a proposition, its premises the sources of arrows drawn into it.
+  for (const { target, premises } of inferences) {
+    const t = nodes.get(target) as TlNode;
+    if (t.type !== 'PROPOSITION') {
+      problems.push({ check: 3, text: FORMALIZE_START_TEXTS.axiomTarget, card: target });
+      continue;
+    }
+    const sources = [...new Set(premises)];
+    for (const p of sources) {
+      if (p === target) problems.push({ check: 3, text: `The target "${t.naturalName}" cannot also be one of its own premises.`, card: target });
+      else if (!nodes.has(p)) problems.push({ check: 3, text: `The premise "${p}" is not a card of ${subject}.`, card: p });
+      else if (!t.premises.includes(p)) problems.push({ check: 3, text: FORMALIZE_START_TEXTS.drawFirst, arrow: { source: p, target } });
+      else if (session !== undefined) {
+        // D2-20: Claude's arrows count only once accepted.
+        const item = arrowItem(p, target);
+        if (item !== undefined && item.status !== 'accepted') problems.push({ check: 3, text: REVIEW_TEXTS.acceptArrowFirst, arrow: { source: p, target } });
+      }
+    }
+    if (sources.length === 0 && t.fromNothing !== true) problems.push({ check: 3, text: FORMALIZE_START_TEXTS.oneTarget, card: target });
+    if (session === undefined) continue;
+    // D2-53: RV-9 counts a card with a Shaky item as frozen: its proof could not change.
+    if (session.shakyTargets.includes(target)) problems.push({ check: 3, text: REVIEW_TEXTS.shakyTarget(sentence(target)), card: target });
+    // D2-50: a new target at the source of Claude's arrow into another target, unless the request selects that arrow.
+    if (!sessionTargets.has(target)) {
+      for (const a of session.arrows) {
+        if (a.source !== target || a.target === target || selected(target, a.target)) continue;
+        problems.push({ check: 3, text: REVIEW_TEXTS.claudeArrowSource(sentence(target), sentence(a.target)), arrow: { source: a.source, target: a.target } });
+      }
+    }
+  }
+
+  // 4. A proposition source with neither a proof nor a pending claim, no target of this request (AR-8).
+  for (const { premises } of inferences) {
+    for (const p of [...new Set(premises)]) {
+      const source = nodes.get(p);
+      if (source === undefined || targets.has(p) || !needsHoldsFirst(source)) continue;
+      problems.push({ check: 4, text: session !== undefined ? REVIEW_TEXTS.notProvedSelectArrows(sentence(p)) : REVIEW_TEXTS.notProvedMarkPending(sentence(p)), card: p });
+    }
+  }
+
+  // 5. In a session, a source whose Result is Shaky or to be redone (D2-53).
+  if (session !== undefined) {
+    const shaky = (p: string) => (session.shakyResults !== undefined ? session.shakyResults.includes(p) : session.results[p] === 'declined' && session.shakyTargets.includes(p));
+    for (const { premises } of inferences) {
+      for (const p of [...new Set(premises)]) {
+        if (!nodes.has(p) || !Object.hasOwn(session.results, p)) continue;
+        if (session.results[p] === 'to-be-redone') problems.push({ check: 5, text: REVIEW_TEXTS.redoneSource(sentence(p)), card: p });
+        else if (shaky(p)) problems.push({ check: 5, text: REVIEW_TEXTS.shakySource(sentence(p)), card: p });
+      }
+    }
+  }
+
+  // 6. Any cycle of drawn and solid arrows in the subject (AP-13; AP-29, G2), named.
+  const cards = [...new Set(inferences.flatMap((inf) => [inf.target, ...inf.premises]))].filter((id) => nodes.has(id));
+  const cycle = formalizeCycleProblem({ nodes: board.nodes, edges: board.edges }, cards);
+  if (cycle !== undefined) problems.push({ check: 6, text: cycle });
+
+  // Collected check by check, so already in their order.
+  return problems;
+}
+
+/** §4.12 (2b2): a target that is a source of another target's question comes first; ties by reading order. */
+export function formalizeOrder(board: TlGraph, inferences: Request): string[] {
+  const reading = new Map(board.nodes.map((n, k) => [n.id, k]));
+  const premisesOf = new Map<string, Set<string>>();
+  for (const { target, premises } of inferences) premisesOf.set(target, new Set([...(premisesOf.get(target) ?? []), ...premises]));
+  const before = (a: string, b: string) => (reading.get(a) ?? Number.MAX_SAFE_INTEGER) - (reading.get(b) ?? Number.MAX_SAFE_INTEGER) || (a < b ? -1 : a > b ? 1 : 0);
+  const remaining = [...premisesOf.keys()];
+  const out: string[] = [];
+  while (remaining.length > 0) {
+    const free = remaining.filter((t) => [...(premisesOf.get(t) ?? [])].every((p) => p === t || !remaining.includes(p)));
+    // A cycle among the targets (check 6 refuses it): reading order decides.
+    const next = (free.length > 0 ? free : remaining).sort(before)[0] as string;
+    out.push(next);
+    remaining.splice(remaining.indexOf(next), 1);
+  }
+  return out;
+}
