+      await a.manager.start(START);
+      for (let k = 0; k < 100 && armed?.crashed() !== true && !(at === 4 && rawRun(a).session?.phase === 'stage'); k++) await new Promise((r) => setTimeout(r, 20));
+      expect(armed?.crashed()).toBe(true);
+      a.manager.dispose();
+      vi.restoreAllMocks();
+      const onDisk = rawRun(a).session;
