+/** The type constants of the Spyro fixture (2b3a, D2-30). */
+const TYPE_CONSTS: Readonly<Record<string, string[]>> = {
+  'Spyro.Character': [],
+  'Spyro.Game': [],
+  'Spyro.Character.exists': ['Spyro.Character'],
+  'Spyro.instNonemptyCharacter': ['Spyro.Character'],
