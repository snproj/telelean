+/**
+ * Slice 2b1b (docs/slice2-plan.md sections 2.7 and 4.9): judging a state of an edit session (`judgeState`), and
+ * propose_arrow's refusals (`proposeArrowProblems`).
+ *
+ * `judgeState` runs every rule of its purpose over every inference, sources first, and computes what reconcile (§3.5),
+ * the view (2c2) and the end (§3.10) read of the state: the items (`computeItems`), both class maps (`classify`), the
+ * RV-5 dependencies (`itemDeps`), R_stmt's `by`, and the problems.
+ *  - Global rules, every purpose: G1 against B (G0 stays the engine's: it judges every file of the root, which a
+ *    ProjectModel does not hold); `sorry` and `example`; the vocabulary shape rule for new and changed items;
+ *    `new-axiom` against B by name and type; G5 (against S₀, or B when no step runs); B.3 (`arrow`); B.4 (`holds-kind`);
+ *    `stray-command`; and `other-result` for content no inference created.
+ *  - Step purposes (check, freeze, gate-proved, gate-other, with the scope and S₀): the step limits
+ *    (`existing-changed`), `proof-before-freeze` with R = S₀, `rejected-repeat` for content the step created or changed,
+ *    and the active inference's own rules (not-proved, status-mismatch against S₀, statement-changed against its freeze,
+ *    readiness, not-frozen), with slice 1's messages in the step's words (`stepWording`).
+ *  - Per inference, sources first (`order`): B.1 (`permittedFor`); footprint(T.holds) ⊆ permitted(T) and B.2 with E(T),
+ *    for a proof of this session (T.holds differs from B's, in text or meaning), and for the active step's target as
+ *    slice 1 judged it against S₀ (a proved finish always; check in stage prove and a not-proved finish when T.holds
+ *    changed since S₀, in text or meaning); the footprint of every declaration the inference's steps created (ledger
+ *    `created`, or the active step's new ones); `other-result` for its proof and proof material, statements and premise
+ *    drafts.
+ *  - `stepFindings`: the global findings, the active inference's and the step-purpose rules; for `stage` and `final`,
+ *    the global findings. Other inferences feed RV-11 only (their `passes`). A step whose rules find nothing else still
+ *    fails while it leaves a difference no review item can hold that S₀ did not have (fixer 2b1b r1, A-ADV-3).
+ *  - A step purpose without its scope and S₀ throws (fixer 2b1b r1, S-F3): judging it as a stage would skip the step's
+ *    rules and pass what they refuse.
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import { ActionError, type ArrowEnds } from '../actions.js';
+import { holdsName, probeFailure, STANDARD_AXIOM_NAMES } from '../facts.js';
+import { declTables, factsOf } from '../gate/decls.js';
+import {
+  buildFindings,
+  exampleFindings,
+  malformedBindingFindings,
+  notFrozenFindings,
+  notProvedFindings,
+  orderFindings,
+  proofBeforeFreezeFindings,
+  readinessFindings,
+  readyCards,
+  ruleContext,
+  sorryAxiomFindings,
+  statementChangedFindings,
+  statusMismatchFindings,
+  vocabularyShapeFindings,
+  type RuleContext,
+} from '../gate/rules.js';
+import {
+  arrowFindings,
+  arrowProblems,
+  changedSinceBase,
+  declarationFootprintFindings,
+  footprintJudged,
+  holdsKindFindings,
+  meaningChanged,
+  noHiddenEdgeFindings,
+  otherResultFindings,
+  sessionExampleWording,
+  sessionMarkupFindings,
+  sessionNewAxiomFindings,
+  sessionRuleContext,
+  stepLimitFindings,
+  stepWording,
+  STEP_PURPOSES,
+  strayCommandFindings,
+  targetFootprintFindings,
+} from '../gate/sessionRules.js';
+import type { GateFinding, RulePurpose } from '../gate/types.js';
+import { signatureAxioms } from '../gate/permitted.js';
+import type { ProjectModel } from '../project/types.js';
+import { normalizeWhitespace } from '../project/text.js';
+import { where } from '../gate/g0.js';
+import { classify } from './classify.js';
+import { statementReach } from './closure.js';
+import { itemDeps } from './deps.js';
+import { computeItems, premiseDraftKey } from './items.js';
+import { premiseKey, proofKey } from './keys.js';
+import { isSessionProof, permittedFor } from './permitted.js';
+import { fallbackLabel, inferenceOf, isShaky } from './records.js';
+import { CLAUDE_SESSION_TEXTS, REVIEW_TEXTS } from './texts.js';
+import type { InferenceJudgement, ItemDraft, JudgeInput, LedgerEntry, SessionInference, StateJudgement, StepScope } from './types.js';
+
+const quote = (text: string) => JSON.stringify(text);
+const byTarget = (a: SessionInference, b: SessionInference) => a.order - b.order || (a.target < b.target ? -1 : a.target > b.target ? 1 : 0);
+
+/**
+ * `rejected-repeat` (D2-66, step purposes only), for content the step created or changed since S₀ (`changed`: the keys
+ * whose content key differs from S₀'s or that S₀ did not have):
+ *  - `rejected`: an item whose content key is one of its rejected keys (DO-1);
+ *  - `premise`: a premise draft of the step whose draft key a rejected premise holds (§4.3);
+ *  - `arrow`: an arrow the step added that the person declined (DO-0);
+ *  - `shaky-identical`: the inference's Shaky set back unchanged (every item of it with its own content key), unless the
+ *    finish said `no_alternative` (DO-3); judged by check_lean and at a finish, never at the freeze (the set's proofs
+ *    can change only after it).
+ * Content the person brought back (Undo, un-reject) was not made by the step, so no stage or final judgement refuses it
+ * (F4).
+ */
+function rejectedRepeatFindings(i: {
+  input: JudgeInput;
+  scope: StepScope;
+  drafts: readonly ItemDraft[];
+  startKeys: ReadonlyMap<string, string>;
+}): GateFinding[] {
+  const { input, scope } = i;
+  const out: GateFinding[] = [];
+  const records = new Map(input.items.map((r) => [r.key, r]));
+  const now = new Map(i.drafts.map((d) => [d.key, d]));
+  const rejectedPremises = new Set(input.items.filter((r) => r.kind === 'add-premise').flatMap((r) => r.rejectedFingerprints));
+  const premiseRepeats = input.premises.filter((p) => p.step === scope.step && rejectedPremises.has(premiseDraftKey(p)));
+  // A premise draft `premise` reports below is not `rejected` too: one finding per problem (fixer 2b1b r1, S-F7).
+  const saidByPremise = new Set(premiseRepeats.map((p) => premiseKey(p.target, p.leanName)));
+  for (const d of i.drafts) {
+    if (i.startKeys.get(d.key) === d.contentKey) continue;
+    if (d.kind === 'add-premise' && saidByPremise.has(d.key)) continue;
+    const r = records.get(d.key);
+    if (r === undefined || !r.rejectedFingerprints.includes(d.contentKey)) continue;
+    out.push({
+      step: 'G3',
+      code: 'rejected-repeat',
+      message: `${fallbackLabel(r)} is exactly a version the person rejected in this session: never propose it again; propose something else, or leave it out.`,
+      names: d.provides.decls.length > 0 ? [...d.provides.decls] : [d.key],
+      token: 'rejected',
+      inference: scope.target,
+    });
+  }
+  for (const p of premiseRepeats) {
+    out.push({
+      step: 'G3',
+      code: 'rejected-repeat',
+      message: `The missing premise ${p.leanName} (${quote(p.naturalName)}) is one the person rejected in this session: do not propose it again.`,
+      names: [p.leanName],
+      token: 'premise',
+      inference: scope.target,
+    });
+  }
+  const seen = new Set<string>();
+  for (const e of input.ledger) {
+    if (e.kind !== 'arrow' || e.step !== scope.step || seen.has(`${e.source}>${e.target}`)) continue;
+    seen.add(`${e.source}>${e.target}`);
+    if (!input.rejectedArrows.some((a) => a.source === e.source && a.target === e.target)) continue;
+    out.push({
+      step: 'G3',
+      code: 'rejected-repeat',
+      message: `The person declined “${e.source}” → “${e.target}” in this session: do not propose it again.`,
+      names: [e.source],
+      nodeId: e.target,
+      token: 'arrow',
+      inference: scope.target,
+    });
+  }
+  if (input.purpose !== 'freeze' && input.noAlternative !== true) {
+    const shaky = input.items.filter((r) => isShaky(r) && inferenceOf(r) === scope.target && scope.openItems.includes(r.key));
+    if (shaky.length > 0 && shaky.every((r) => now.get(r.key)?.contentKey === r.fingerprint)) {
+      out.push({
+        step: 'G3',
+        code: 'rejected-repeat',
+        message: `The person declined ${shaky.map(fallbackLabel).join(', ')} as Shaky, and this step left all of them as they were: propose a different arrangement for them together (any single one may stay), or, if there is none, finish with no_alternative: true.`,
+        names: shaky.map((r) => r.key),
+        token: 'shaky-identical',
+        inference: scope.target,
+      });
+    }
+  }
+  return out;
+}
+
+/** A Result's verdict, flags, footprint, direct uses, Rests on, band and missing arrows in this state (§2.9). */
+function resultOf(
+  base: ProjectModel,
+  current: ProjectModel,
+  target: string,
+  sources: ReadonlySet<string>,
+): Pick<InferenceJudgement, 'verdict' | 'flags' | 'footprint' | 'direct' | 'restsOn' | 'band' | 'missing'> {
+  const node = current.nodes.get(target)?.node;
+  const proof = node?.status.proof;
+  const proved = proof?.kind === 'proved' || proof?.kind === 'conditional';
+  const none = { verdict: 'not-proved' as const, flags: [], footprint: [], direct: [], restsOn: [], band: { used: [], notNeeded: [], complete: false, open: [] }, missing: [] };
+  if (node === undefined || proof === undefined || !proved) return none;
+  const statement = node.lean.statement;
+  const holds = statement !== undefined ? holdsName(statement) : undefined;
+  const facts = holds !== undefined ? current.declFacts.get(holds) : undefined;
+  const footprint = facts !== undefined && facts.kind !== 'axiom' ? [...(facts.axioms ?? [])] : [];
+  const steps = proof.kind === 'proved' ? proof.footprint : (proof.footprint ?? []);
+  const restsOn = steps.filter((x) => current.nodes.has(x));
+  const direct = [...(node.status.direct?.ids ?? [])];
+  const drawn = node.premises;
+  const verdict = proof.kind === 'proved' ? (node.status.flags.includes('established') ? ('established' as const) : ('proved' as const)) : ('not-proved' as const);
+  const flags: InferenceJudgement['flags'] = [];
+  if (proof.kind === 'proved' && node.status.flags.includes('self-evident')) flags.push('proved-from-nothing');
+  const before = base.nodes.get(target)?.node;
+  const tablesB = declTables(base);
+  const tablesW = declTables(current);
+  if (holds !== undefined && before?.lean.justificationKind === 'theorem' && tablesB.byName.get(holds)?.text !== tablesW.byName.get(holds)?.text) flags.push('replaces-your-proof');
+  const was = before?.lean.statement;
+  if (proof.kind === 'proved' && was !== undefined && statement !== undefined) {
+    const bf = base.declFacts.get(was);
+    const cf = current.declFacts.get(statement);
+    const norm = (t: string | undefined) => (t === undefined ? undefined : normalizeWhitespace(t));
+    const changed = was !== statement || tablesB.byName.get(was)?.text !== tablesW.byName.get(statement)?.text || (bf !== undefined && cf !== undefined && norm(bf.value) !== norm(cf.value));
+    if (changed) flags.push('proves-changed-statement');
+  }
+  const on = proof.kind === 'conditional' ? proof.on : [];
+  const open = [...new Set([...direct.filter((d) => !drawn.includes(d)), ...on])];
+  const OUT_OF_DATE = ['stale', 'not-checked'];
+  const fresh = [target, ...direct].every((id) => !(current.nodes.get(id)?.node.status.flags ?? []).some((f) => OUT_OF_DATE.includes(f)));
+  const mismatch = [target, ...direct].some((id) => current.nodes.get(id)?.node.status.flags.includes('holds-mismatch') === true);
+  const complete =
+    proof.kind === 'proved' &&
+    open.length === 0 &&
+    !steps.some((x) => x.startsWith('axiom:')) &&
+    node.status.direct?.from === 'proof' &&
+    (node.status.direct?.unseen ?? []).length === 0 &&
+    fresh &&
+    !mismatch;
+  return {
+    verdict,
+    flags,
+    footprint,
+    direct,
+    restsOn,
+    band: { used: drawn.filter((s) => direct.includes(s)), notNeeded: [...sources].filter((s) => !direct.includes(s)), complete, open },
+    missing: direct.filter((d) => d !== target && !sources.has(d)).map((source) => ({ source, drawn: drawn.includes(source) })),
+  };
+}
+
+/** §2.7, §4.9 (2b1b): every rule of the purpose over every inference, sources first, with computeItems, both class maps and RV-5. */
+export function judgeState(input: JudgeInput): StateJudgement {
+  const { purpose, base, current } = input;
+  // Fixer 2b1b r1 (S-F3): a step purpose without its scope or S₀ would be judged as a stage, without the step's rules
+  // (its limits, not-proved, status-mismatch, rejected-repeat): a green that fails open on a caller's mistake.
+  if (STEP_PURPOSES.has(purpose) && (input.scope === undefined || input.stepStart === undefined)) {
+    throw new ActionError('invalid', `judgeState: “${purpose}” judges a running step, and needs its scope and the state it started from (S₀).`);
+  }
+  const step = STEP_PURPOSES.has(purpose) && input.scope !== undefined && input.stepStart !== undefined;
+  const scope = step ? input.scope : undefined;
+  const stepStart = step ? input.stepStart : undefined;
+
+  // The inferences, sources first; the active step asks its own question (its StepScope's) of its target. `recorded`
+  // keeps the questions on the record (a re-ask's old question, §3.2).
+  const recorded = [...input.inferences].sort(byTarget);
+  const ordered = recorded.map((inf) => (scope !== undefined && inf.target === scope.target ? { ...inf, question: scope.question } : inf));
+  if (scope !== undefined && !ordered.some((inf) => inf.target === scope.target)) {
+    ordered.push({ target: scope.target, question: scope.question, order: Number.MAX_SAFE_INTEGER, steps: [scope.step] });
+  }
+  const firstTarget = scope?.target ?? ordered[0]?.target ?? '';
+  const subject = current.nodes.get(firstTarget)?.node.subject ?? base.nodes.get(firstTarget)?.node.subject ?? '';
+  const questionCards = [...new Set(ordered.flatMap((inf) => inf.question.sources))];
+  const rulePurpose: RulePurpose = step ? (purpose as RulePurpose) : 'check';
+  const ctxB: RuleContext = ruleContext({
+    purpose: rulePurpose,
+    selection: { subject, target: firstTarget, premises: questionCards, adoptedGhosts: [] },
+    stage: input.stage,
+    base,
+    current,
+    roundStart: stepStart ?? base,
+    ...(step && input.freeze !== undefined ? { freeze: input.freeze } : {}),
+    teleleanBlocks: [],
+  });
+  // The active step's context against S₀, and whether its target's `.holds` changed since S₀: its text, or (fixer 2b1b
+  // r1, A-ADV-4) its meaning, e.g. the person's proof elaborated through a `@[simp]` lemma the step added.
+  const activeCtx: RuleContext | undefined =
+    scope !== undefined && stepStart !== undefined
+      ? ruleContext({
+          purpose: rulePurpose,
+          selection: { subject, target: scope.target, premises: [...scope.question.sources], adoptedGhosts: [] },
+          stage: input.stage,
+          base: stepStart,
+          current,
+          roundStart: stepStart,
+          ...(input.freeze !== undefined ? { freeze: input.freeze } : {}),
+          teleleanBlocks: [],
+        })
+      : undefined;
+  const targetChanged =
+    activeCtx !== undefined &&
+    stepStart !== undefined &&
+    (activeCtx.targetProofNew || (activeCtx.targetHolds !== undefined && meaningChanged(stepStart, current, activeCtx.targetHolds)));
+  // A re-ask's question applies to the material earlier steps made for its target only once the step claims it: at a
+  // proved finish, and by check_lean once T.holds changed; a finish without a proof keeps the old question (C-V2B1B-C2).
+  const stepQuestionForMaterial = purpose === 'gate-proved' || (purpose === 'check' && targetChanged);
+  const sc = sessionRuleContext({
+    purpose,
+    stage: input.stage,
+    base,
+    current,
+    ...(stepStart !== undefined ? { stepStart } : {}),
+    ...(scope !== undefined ? { scope } : {}),
+    ...(step && input.freeze !== undefined ? { freeze: input.freeze } : {}),
+    inferences: ordered,
+    ledger: input.ledger,
+    items: input.items,
+    premises: input.premises,
+    rejectedArrows: input.rejectedArrows,
+    ctx: ctxB,
+    sessionProof: (target) => isSessionProof(base, current, target),
+    recorded,
+    stepQuestionForMaterial,
+  });
+
+  // ---- the items of this state (§4.2), and S₀'s when a step's rules need them
+  const items = computeItems({
+    base,
+    current,
+    ledger: input.ledger,
+    premises: input.premises,
+    inferences: input.inferences,
+    ended: input.ended,
+    ...(scope !== undefined && stepStart !== undefined ? { active: { step: scope.step, target: scope.target, stepStart, ...(input.freeze !== undefined ? { freeze: input.freeze } : {}) } } : {}),
+  });
+  let start: ReturnType<typeof computeItems> | undefined;
+  const atStart = (): ReturnType<typeof computeItems> => {
+    if (start !== undefined || scope === undefined || stepStart === undefined) return start ?? { drafts: [], problems: [] };
+    start = computeItems({
+      base,
+      current: stepStart,
+      ledger: input.ledger,
+      premises: input.premises.filter((p) => p.step !== scope.step),
+      inferences: input.inferences,
+      ended: input.ended,
+    });
+    return start;
+  };
+  const draftsAtStart = (): ItemDraft[] => atStart().drafts;
+
+  // ---- what the scope opens (ES-2): the declarations of `openItems`; under `openProof`, the target's Result at S₀ (its
+  // `.holds` and its proof material: the target's Proof is open), but at a finish without a proof, which leaves it as
+  // it was (fixer 2b1b r1, C-V2B1B-C2: a re-ask may drop a lemma that rests on a source it no longer asks for).
+  const openNames = new Set<string>();
+  if (scope !== undefined && stepStart !== undefined) {
+    const open = new Set(scope.openItems);
+    if (scope.openProof && purpose !== 'gate-other') open.add(proofKey(scope.target));
+    for (const d of draftsAtStart()) if (open.has(d.key)) for (const name of d.provides.decls) openNames.add(name);
+  }
+
+  // ---- global rules
+  const built = buildFindings(ctxB);
+  const buildFailed = built.length > 0;
+  const changedNames = new Set([...ctxB.added, ...ctxB.changed]);
+  const pinnable = new Set<string>(
+    scope !== undefined
+      ? [...scope.fuzzyStatements, ...(stepStart?.nodes.get(scope.target)?.node.lean.statement === undefined ? [scope.target] : [])]
+      : [...ordered.map((inf) => inf.target), ...questionCards],
+  );
+  const global: GateFinding[] = [
+    ...built,
+    ...sorryAxiomFindings(ctxB),
+    ...sessionExampleWording(exampleFindings(ctxB)),
+    // The shape rule for new and changed items (Appendix B): a changed name counts as new here.
+    ...vocabularyShapeFindings({ ...ctxB, inBase: (name: string) => ctxB.inBase(name) && !changedNames.has(name) }),
+    ...sessionNewAxiomFindings(sc),
+    ...holdsKindFindings(sc, openNames),
+    ...sessionMarkupFindings(sc, pinnable),
+    ...arrowFindings(sc),
+    ...strayCommandFindings(sc, openNames),
+  ];
+  if (scope !== undefined && stepStart !== undefined && activeCtx !== undefined) {
+    const coveredAtStart = new Set(draftsAtStart().flatMap((d) => d.provides.decls));
+    global.push(...stepLimitFindings(sc, openNames, coveredAtStart), ...stepWording(proofBeforeFreezeFindings(activeCtx)));
+  }
+
+  // ---- what each inference's steps created, for its footprints; `other-result` by the mentioner's inference
+  const { judged, owners } = changedSinceBase(sc);
+  const holderOf = (name: string) => owners.get(name) ?? name;
+  const creatorTarget = (name: string): string | undefined => sc.creatorOf(holderOf(name))?.target;
+  const declsOf = new Map<string | undefined, typeof judged>();
+  for (const j of judged) {
+    if (!footprintJudged(sc, j)) continue;
+    const t = creatorTarget(j.name);
+    const key = t !== undefined && sc.targets.has(t) ? t : undefined;
+    const list = declsOf.get(key) ?? [];
+    list.push(j);
+    declsOf.set(key, list);
+  }
+  const otherResult = otherResultFindings(sc, judged, owners);
+  const otherOf = new Map<string | undefined, GateFinding[]>();
+  for (const f of otherResult) {
+    const key = f.inference !== undefined && sc.targets.has(f.inference) ? f.inference : undefined;
+    const list = otherOf.get(key) ?? [];
+    list.push(key === undefined ? withoutInference(f) : f);
+    otherOf.set(key, list);
+  }
+  global.push(...(otherOf.get(undefined) ?? []));
+  // Declarations no inference created may rest on the vocabulary layer only (fail closed).
+  const vocabularyLayer = new Set([...STANDARD_AXIOM_NAMES, ...signatureAxioms(current)]);
+  global.push(...declarationFootprintFindings(sc, declsOf.get(undefined) ?? [], vocabularyLayer, undefined, buildFailed));
+
+  // ---- per inference, sources first
+  const judgements: Record<string, InferenceJudgement> = {};
+  const proveStage = purpose === 'gate-proved' || purpose === 'gate-other' || (purpose === 'check' && input.stage === 'prove');
+  const activeStep = scope !== undefined ? { activeStep: scope.step } : {};
+  for (const inference of ordered) {
+    const target = inference.target;
+    const b1 = permittedFor({ base, current, target, inferences: ordered, ledger: input.ledger, items: input.items, earlier: judgements, ...activeStep });
+    const permitted = new Set(b1.permitted);
+    const sources = new Set(Object.keys(b1.contrib));
+    const active = scope?.target === target;
+    const findings: GateFinding[] = [];
+    let judgeProof: boolean;
+    let existing = false;
+    if (active && stepStart !== undefined && activeCtx !== undefined) {
+      existing = !targetChanged;
+      judgeProof = purpose === 'gate-proved' || ((purpose === 'gate-other' || (purpose === 'check' && input.stage === 'prove')) && targetChanged);
+      const ready = readyCards(activeCtx);
+      findings.push(
+        ...stepWording([
+          ...notProvedFindings(activeCtx),
+          ...statusMismatchFindings(activeCtx),
+          ...statementChangedFindings(activeCtx),
+          ...readinessFindings(activeCtx, ready),
+          ...malformedBindingFindings(activeCtx, ready),
+          ...notFrozenFindings(activeCtx),
+        ]),
+      );
+    } else judgeProof = isSessionProof(base, current, target);
+    if (judgeProof) findings.push(...targetFootprintFindings(sc, target, permitted, existing, buildFailed), ...noHiddenEdgeFindings(sc, target, sources, existing));
+    // The active step's declarations are judged, as slice 1 judged a run's, once a footprint can be asked of them.
+    const decls = declsOf.get(target) ?? [];
+    const judgedHere = active && !proveStage ? undefined : permitted;
+    const question = recorded.find((inf) => inf.target === target)?.question;
+    const reasked = active && scope !== undefined && question !== undefined && !sameQuestion(question, scope.question);
+    if (reasked) {
+      // C-V2B1B-C2: what an earlier step made for this target is judged with the question it was made under, until the
+      // step claims its new question (a proved finish, or check_lean on a changed T.holds); then with that question,
+      // saying why (the proof is open, so the step may drop or rework it).
+      const earlier = decls.filter((j) => sc.creatorOf(holderOf(j.name))?.active === false);
+      const own = decls.filter((j) => sc.creatorOf(holderOf(j.name))?.active !== false);
+      const before = stepQuestionForMaterial ? permitted : new Set(permittedFor({ base, current, target, inferences: recorded, ledger: input.ledger, items: input.items, earlier: judgements, ...activeStep }).permitted);
+      const hint = stepQuestionForMaterial
+        ? `An earlier step wrote it for “${target}” under a question this step no longer asks: the target's proof is open in this step, so remove it, or rest it on this step's sources.`
+        : undefined;
+      findings.push(...declarationFootprintFindings(sc, own, judgedHere, target, buildFailed));
+      findings.push(...declarationFootprintFindings(sc, earlier, judgedHere === undefined ? undefined : before, target, buildFailed, hint));
+    } else findings.push(...declarationFootprintFindings(sc, decls, judgedHere, target, buildFailed));
+    findings.push(...(otherOf.get(target) ?? []));
+    const tagged = orderFindings(findings.map((f) => ({ ...f, inference: target })));
+    judgements[target] = { target, passes: tagged.length === 0, ...resultOf(base, current, target, sources), ...b1, findings: tagged };
+  }
+
+  // ---- step purposes: rejected-repeat
+  const stepRules: GateFinding[] = [];
+  if (scope !== undefined && stepStart !== undefined) {
+    const startKeys = new Map(draftsAtStart().map((d) => [d.key, d.contentKey]));
+    stepRules.push(...rejectedRepeatFindings({ input, scope, drafts: items.drafts, startKeys }));
+  }
+
+  // ---- items, classes, dependencies, problems
+  const drafts = items.drafts;
+  const classes = classify({ base, current, drafts, premises: input.premises, inferences: input.inferences, withDrafts: true });
+  const classesBeforeReveal = classify({ base, current, drafts, premises: input.premises, inferences: input.inferences, withDrafts: false });
+  const deps = itemDeps({ base, current, drafts, inferences: judgements });
+  const problems: StateJudgement['problems'] = [...items.problems, ...buildProblems(current, drafts)];
+  const missingFacts = drafts.filter((d) => d.factsMissing === true).map((d) => d.key);
+  // 2b2 (§2.1, D2-75): a state whose probe failed is refused at every purpose, naming the cause; with no draft lacking
+  // facts too (nothing to key), since its constants are missing everywhere. Without the probe's detail (fixer 2b2 r1,
+  // A-V2B2-ADV-7): the stage's problems show while the results may be hidden, and Lean's error can name hidden proof
+  // material (§4.7); the classes in force while they are shown, and the backstop at Apply, carry the detail.
+  const failedProbe = probeFailure(current.facts, { detail: false });
+  if (current.facts === undefined) problems.push({ code: 'facts', text: REVIEW_TEXTS.factsMissing });
+  else if (failedProbe !== undefined) problems.push({ code: 'facts', text: REVIEW_TEXTS.factsProbeFailed(failedProbe), ...(missingFacts.length > 0 ? { keys: missingFacts } : {}) });
+  else if (missingFacts.length > 0) problems.push({ code: 'facts', text: REVIEW_TEXTS.factsMissing, keys: missingFacts });
+
+  const orderedGlobal = orderFindings(global);
+  const activeFindings = scope !== undefined ? (judgements[scope.target]?.findings ?? []) : [];
+  let stepFindings = step ? orderFindings([...orderedGlobal, ...activeFindings, ...stepRules]) : orderedGlobal;
+  // Fixer 2b1b r1 (A-ADV-3): AP-26's reasoning, made total. A step that its rules pass may still leave a difference no
+  // review item can hold (computeItems reports it unowned, and Apply stays disabled for the rest of the session, since
+  // later steps may not touch it). Each one S₀ did not have is then a step finding, so Claude restores it while it can.
+  // Only when no other rule spoke: those name the same differences more precisely (one finding per problem).
+  if (step && stepFindings.length === 0) {
+    const fresh = minusTexts(
+      items.problems.filter((p) => p.code === 'unowned'),
+      atStart().problems.filter((p) => p.code === 'unowned'),
+    );
+    stepFindings = fresh.map((p) => ({
+      step: 'G3',
+      code: 'existing-changed',
+      message: CLAUDE_SESSION_TEXTS.unownedChange(p.text),
+      token: 'unowned',
+      ...(p.declaration !== undefined ? { names: [p.declaration] } : {}),
+    }));
+    // Fixer 2b2 r1 (A-V2B2-ADV-4): ES-2's preset as reconcile reads it. Every item of S₀ the scope does not open keeps
+    // its content key, which the stage compares; a change no rule named (e.g. a comment S₀ attached to one declaration
+    // that now goes with another, because the step wrote a declaration next to it or removed the one it described)
+    // would return an accepted item to review as "updated", with its accepted dependents. Not for an item whose facts
+    // are missing in either state (a failed probe, a module that did not build), whose key cannot be compared, nor when
+    // the two states' facts come from different probes (one with the marker, one without: §2.1's approximate case).
+    // Nor for a premise draft that is not written (fixer 2b2 r2, R1-1): it is outside ws/, and a step may propose it
+    // again under its key (S13, §3.5), which reconcile versions.
+    const sameProbe = stepStart?.facts?.probe?.status === current.facts?.probe?.status;
+    if (stepFindings.length === 0 && scope !== undefined && sameProbe) stepFindings = frozenItemFindings(atStart().drafts, items.drafts, scope, input.ledger);
+  }
+  return {
+    commit: input.commit,
+    filesKey: input.filesKey,
+    purpose,
+    ok: !buildFailed && orderedGlobal.length === 0 && !problems.some((p) => p.code === 'facts'),
+    global: orderedGlobal,
+    stepFindings,
+    inferences: judgements,
+    drafts,
+    classes,
+    classesBeforeReveal,
+    deps,
+    reach: statementReach(current, input.premises).by,
+    problems,
+  };
+}
+
+/**
+ * Fixer 2b2 r1 (A-V2B2-ADV-4): the items of S₀ that the scope does not open (its `openItems`; under `openProof` the
+ * active target's Result, which its own rules govern at every purpose) whose content key the judged state changed, or
+ * which it lost; one finding each, naming its declarations (`existing-changed`, token `session`: content an earlier step
+ * proposed). Fixer 2b2 r2 (R1-1): not a premise draft that no ledger `premise` entry names (computeItems makes its item
+ * from the draft, outside ws/): a draft of the same key from the step is its newer proposal (S13: a reworded repeat
+ * passes; §3.5), whose new version reconcile records ("updated"). A written premise is content in ws/, frozen as any.
+ */
+function frozenItemFindings(atStart: readonly ItemDraft[], now: readonly ItemDraft[], scope: StepScope, ledger: readonly LedgerEntry[]): GateFinding[] {
+  const open = new Set([...scope.openItems, ...(scope.openProof ? [proofKey(scope.target)] : [])]);
+  const written = new Set(ledger.flatMap((e) => (e.kind === 'premise' ? [e.item] : [])));
+  const byKey = new Map(now.map((d) => [d.key, d]));
+  const out: GateFinding[] = [];
+  for (const d of atStart) {
+    if (open.has(d.key) || d.factsMissing === true) continue;
+    if (d.kind === 'add-premise' && !written.has(d.key)) continue;
+    const later = byKey.get(d.key);
+    if (later !== undefined && (later.factsMissing === true || later.contentKey === d.contentKey)) continue;
+    const what = d.provides.decls.length > 0 ? d.provides.decls.join(', ') : d.key;
+    out.push({
+      step: 'G3',
+      code: 'existing-changed',
+      message: CLAUDE_SESSION_TEXTS.frozenItemChanged(what),
+      token: 'session',
+      ...(d.provides.decls.length > 0 ? { names: [...d.provides.decls] } : {}),
+    });
+  }
+  return out;
+}
+
+/** Two questions ask the same: the same sources (as sets) and the same mark. */
+function sameQuestion(a: SessionInference['question'], b: SessionInference['question']): boolean {
+  const x = [...new Set(a.sources)].sort();
+  const y = [...new Set(b.sources)].sort();
+  return a.fromNothing === b.fromNothing && x.length === y.length && x.every((s, k) => s === y[k]);
+}
+
+/** The problems of `now` that `before` lacks, by text, as multisets (each of `before` cancels one of `now`). */
+function minusTexts<P extends { text: string }>(now: readonly P[], before: readonly P[]): P[] {
+  const left = new Map<string, number>();
+  for (const p of before) left.set(p.text, (left.get(p.text) ?? 0) + 1);
+  const out: P[] = [];
+  for (const p of now) {
+    const n = left.get(p.text) ?? 0;
+    if (n > 0) left.set(p.text, n - 1);
+    else out.push(p);
+  }
+  return out;
+}
+
+/** A finding without its `inference` (one the session judges globally). */
+function withoutInference(f: GateFinding): GateFinding {
+  const { inference: _inference, ...rest } = f;
+  void _inference;
+  return rest;
+}
+
+/**
+ * Lean's errors mapped to the items that own the declarations they are in (§3.6 "the errors are mapped to the items
+ * owning the failing declarations"): one `no-longer-builds` problem per error inside a declaration an item provides.
+ */
+function buildProblems(current: ProjectModel, drafts: readonly ItemDraft[]): StateJudgement['problems'] {
+  const facts = current.facts;
+  if (facts === undefined) return [];
+  const owner = new Map<string, string>();
+  for (const d of drafts) for (const name of d.provides.decls) if (!owner.has(name)) owner.set(name, d.key);
+  const tables = declTables(current);
+  const out: StateJudgement['problems'] = [];
+  for (const m of facts.build.messages) {
+    if (m.severity !== 'error' || m.file === undefined || m.range === undefined) continue;
+    const at = m.range.start;
+    for (const [name, entry] of tables.byName) {
+      if (entry.file.path !== m.file) continue;
+      const r = entry.decl.range;
+      const inside = (r.start.line < at.line || (r.start.line === at.line && r.start.character <= at.character)) && (at.line < r.end.line || (at.line === r.end.line && at.character <= r.end.character));
+      if (!inside) continue;
+      const key = owner.get(name) ?? owner.get(factsOf(current, name, entry)?.name ?? '');
+      if (key === undefined) continue;
+      out.push({ code: 'no-longer-builds', text: `${where(m.file, m.range)}: error: ${m.text}`, keys: [key], declaration: name });
+      break;
+    }
+  }
+  return out;
+}
+
+/** §4.9 (2b1b): propose_arrow's refusals, each with its `arrow` token and its text for Claude; [] accepts the arrow (AF8). */
+export function proposeArrowProblems(i: {
+  current: ProjectModel;
+  scope: StepScope;
+  inferences: readonly SessionInference[];
+  ledger: readonly LedgerEntry[];
+  rejectedArrows: readonly ArrowEnds[];
+  source: string;
+  target: string;
+}): Array<{ token: string; text: string }> {
+  return arrowProblems({
+    model: i.current,
+    drawnIn: i.current,
+    scope: i.scope,
+    inferences: i.inferences,
+    ledger: i.ledger,
+    rejectedArrows: i.rejectedArrows,
+    source: i.source,
+    target: i.target,
+    inLedger: false,
+  });
+}
+
diff --git a/packages/core/src/review/keys.ts b/packages/core/src/review/keys.ts
new file mode 100644
index 0000000..ad53a7e
--- /dev/null
+++ b/packages/core/src/review/keys.ts
@@ -0,0 +1,58 @@
+/**
+ * Slice 2a1 (docs/slice2-plan.md section 2.2, the key table): item keys, an item's identity across stages. Persisted,
+ * never shown.
+ *
+ * | Key | Item | Kinds |
+ * |---|---|---|
+ * | `card:<node>` | a card's fields | formalize, change, delete; add, for a card Claude creates (slice 3) |
+ * | `proof:<node>` | a card's proof | result, proof-broken |
+ * | `premise:<target>:<leanName>` | a missing premise with its arrow | add-premise |
+ * | `arrow:<source>><target>` / `unarrow:<source>><target>` | Claude's arrow | add-arrow / remove-arrow |
+ * | `vocab:<lean name>` | one new plain vocabulary term | vocabulary-term |
+ * | `decl:<lean name>` | a definition, instance or coercion; a presupposition with its helper instance; a change to existing vocabulary | declaration |
+ */
+import type { ArrowEnds } from '../actions.js';
+
+export const cardKey = (node: string): string => `card:${node}`;
+export const proofKey = (node: string): string => `proof:${node}`;
+export const premiseKey = (target: string, leanName: string): string => `premise:${target}:${leanName}`;
+export const arrowKey = (source: string, target: string): string => `arrow:${source}>${target}`;
+export const unarrowKey = (source: string, target: string): string => `unarrow:${source}>${target}`;
+export const vocabKey = (name: string): string => `vocab:${name}`;
+export const declKey = (name: string): string => `decl:${name}`;
+
+/** A key read back into its parts (card ids never hold `:` or `>`, ID_PATTERN; Lean names may hold neither). */
+export type ParsedItemKey =
+  | { kind: 'card' | 'proof'; node: string }
+  | { kind: 'premise'; target: string; leanName: string }
+  | { kind: 'arrow' | 'unarrow'; arrow: ArrowEnds }
+  | { kind: 'vocab' | 'decl'; name: string };
+
+export function parseItemKey(key: string): ParsedItemKey | undefined {
+  const colon = key.indexOf(':');
+  if (colon <= 0) return undefined;
+  const kind = key.slice(0, colon);
+  const rest = key.slice(colon + 1);
+  if (rest === '') return undefined;
+  switch (kind) {
+    case 'card':
+    case 'proof':
+      return { kind, node: rest };
+    case 'premise': {
+      const at = rest.indexOf(':');
+      if (at <= 0 || at === rest.length - 1) return undefined;
+      return { kind, target: rest.slice(0, at), leanName: rest.slice(at + 1) };
+    }
+    case 'arrow':
+    case 'unarrow': {
+      const at = rest.indexOf('>');
+      if (at <= 0 || at === rest.length - 1) return undefined;
+      return { kind, arrow: { source: rest.slice(0, at), target: rest.slice(at + 1) } };
+    }
+    case 'vocab':
+    case 'decl':
+      return { kind, name: rest };
+    default:
+      return undefined;
+  }
+}
diff --git a/packages/core/src/review/mask.ts b/packages/core/src/review/mask.ts
new file mode 100644
index 0000000..5d95233
--- /dev/null
+++ b/packages/core/src/review/mask.ts
@@ -0,0 +1,401 @@
+/**
+ * Slice 2c1 (docs/slice2-plan.md sections 2.9 and 4.7; D2-61, AF6): the RV-6 base mask. While the results of a stage are
+ * hidden, the Proposed view shows every proof-derived datum as in B, the session's base, with statements and vocabulary
+ * from the working copy:
+ *  - `baseMask` reads it off B and the ledger (telelean's own record): each target's `.holds` as in B (B's text, or
+ *    absent), every proof-phase declaration, Claude's arrows, and the written premise cards with their arrows and mark
+ *    removals;
+ *  - `maskFacts` masks the working copy's facts field by field: the left-out names and their messages go; a target's
+ *    `.holds` takes B's DeclFacts, with B's messages for it placed at the start of the working copy's declaration; every
+ *    other declaration B has with the same text keeps the working copy's DeclFacts, positions included, with only
+ *    `axioms` and `usesSorry` from B, and B's messages for it moved by the line offset; the rest keeps the working copy's;
+ *    every other message is dropped; the module entries stay the working copy's, so no file reads stale;
+ *  - `projectMaskOf` turns it into the build's `ProjectMask` (`codeOverride` with B's text, range and keyword, and the
+ *    text B's card code had between the statement and the `.holds`; B's layout of every other card B has; the comment
+ *    and enclosing lines that go with a left-out declaration), and `maskedModel` builds the masked project: the working
+ *    copy's texts and positions, so the build places refs, messages and anonymous instances as it does for the working
+ *    copy, each block bound as the parser reads the file without what is left out, and nothing hidden reaches a graph.
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import { ActionError, type ArrowEnds } from '../actions.js';
+import { holdsName, type DeclFacts, type LeanFacts, type LeanMessageFact } from '../facts.js';
+import { declTables, factsOf, type DeclEntry, type DeclTables } from '../gate/decls.js';
+import type { Position, Range } from '../model.js';
+import { moduleOfPath } from '../paths.js';
+import { codeJoint } from '../project/build.js';
+import { buildProjectModel } from '../project/index.js';
+import { rangeContains } from '../project/text.js';
+import type { ModelNode, ProjectInput, ProjectMask, ProjectModel } from '../project/types.js';
+import type { Span } from '../markup/types.js';
+import { compareTexts } from './items.js';
+import type { BaseMask, LedgerEntry, SessionInference } from './types.js';
+
+/** A record without a prototype, so no card id or name is read as one of Object's own keys (`__proto__`, …). */
+const record = <T>(): Record<string, T> => Object.create(null) as Record<string, T>;
+
+const own = <T>(map: Readonly<Record<string, T>>, key: string): T | undefined => (Object.prototype.hasOwnProperty.call(map, key) ? map[key] : undefined);
+
+/**
+ * §4.7 (2c1): the base mask, read off B and the ledger. `holds`: each target's `.holds` as B has it (B's declaration
+ * text), or `absent` when B has none. `drop`: the names whose first ledger `created` entry is a proof phase's, but a name
+ * B has (the ledger cannot have created it). `dropArrows`: every ledger `arrow` entry but one B draws. `dropNodes`: the
+ * cards of the ledger's `premise` entries that B lacks. `restoreMarks`: the cards a `mark-removed` entry names that B
+ * marked "follows from nothing". Each list sorted, without duplicates.
+ */
+export function baseMask(i: { base: ProjectModel; inferences: readonly SessionInference[]; ledger: readonly LedgerEntry[] }): BaseMask {
+  const B = declTables(i.base);
+  const holds = record<BaseMask['holds'][string]>();
+  for (const inference of i.inferences) {
+    const statement = i.base.nodes.get(inference.target)?.node.lean.statement;
+    const name = statement !== undefined ? holdsName(statement) : undefined;
+    const entry = name !== undefined ? B.byName.get(name) : undefined;
+    holds[inference.target] = name !== undefined && entry !== undefined ? { kind: 'base', name, text: entry.text } : { kind: 'absent' };
+  }
+  const phase = new Map<string, 'statements' | 'proof'>();
+  for (const e of i.ledger) if (e.kind === 'created' && !phase.has(e.name)) phase.set(e.name, e.phase);
+  const inB = (name: string) => B.byName.has(name) || i.base.declFacts.has(name);
+  const drop = [...phase].filter(([name, p]) => p === 'proof' && !inB(name)).map(([name]) => name);
+  const arrows = new Map<string, ArrowEnds>();
+  for (const e of i.ledger) {
+    if (e.kind !== 'arrow' || (i.base.nodes.get(e.target)?.node.premises.includes(e.source) ?? false)) continue;
+    arrows.set(JSON.stringify([e.target, e.source]), { source: e.source, target: e.target });
+  }
+  const dropNodes = new Set<string>();
+  const restoreMarks = new Set<string>();
+  for (const e of i.ledger) {
+    if (e.kind === 'premise' && !i.base.nodes.has(e.card)) dropNodes.add(e.card);
+    if (e.kind === 'mark-removed' && i.base.nodes.get(e.card)?.node.fromNothing === true) restoreMarks.add(e.card);
+  }
+  const sorted = (names: Iterable<string>) => [...new Set(names)].sort();
+  return {
+    holds,
+    drop: sorted(drop),
+    dropArrows: [...arrows.values()].sort((a, b) => (a.target < b.target ? -1 : a.target > b.target ? 1 : a.source < b.source ? -1 : a.source > b.source ? 1 : 0)),
+    dropNodes: sorted(dropNodes),
+    restoreMarks: sorted(restoreMarks),
+  };
+}
+
+/** What the mask leaves out of the working copy, by name, and the targets' `.holds` that take B's (`base`). */
+interface Masked {
+  /** Proof-phase declarations no card of the working copy binds, and the declarations of the written premise cards. */
+  drop: Set<string>;
+  /** The working copy's `.holds` of targets B had none for (or under another name than B's). */
+  absent: Set<string>;
+  /** By name: the `.holds` B has, with B's declaration. */
+  overrides: Map<string, DeclEntry>;
+  /** By the name of such a `.holds`: its target's statement in the working copy, where B's messages for it go. */
+  anchors: Map<string, string>;
+}
+
+function maskedNames(current: ProjectModel, base: ProjectModel, mask: BaseMask): Masked {
+  const B = declTables(base);
+  const dropped = new Set(mask.dropNodes);
+  // A proof-phase declaration that a card of the working copy binds (its statement, an AXIOM card's `.holds`, a pin) is
+  // that card's visible content, as computeItems owns it (`card:<c>`): a step that formalised statements and ended
+  // without a freeze records them as `proof` (D2-43), and the other outcome freezes them (fixer 2c1 r1, A-ADV-1). A
+  // target's `.holds` stays covered by `holds` below.
+  const drop = new Set<string>();
+  for (const name of mask.drop) if (!current.ownerOfDecl.has(name)) drop.add(name);
+  // A written premise card's declarations: what it owns (its statement, its `.holds`, any other pinned name).
+  for (const [name, owner] of current.ownerOfDecl) if (dropped.has(owner)) drop.add(name);
+  const absent = new Set<string>();
+  const overrides = new Map<string, DeclEntry>();
+  const anchors = new Map<string, string>();
+  for (const target of Object.keys(mask.holds)) {
+    const holds = own(mask.holds, target);
+    const statement = current.nodes.get(target)?.node.lean.statement;
+    const now = statement !== undefined ? holdsName(statement) : undefined;
+    if (holds?.kind === 'base') {
+      const entry = B.byName.get(holds.name);
+      if (entry !== undefined) overrides.set(holds.name, entry);
+      if (statement !== undefined) anchors.set(holds.name, statement);
+      if (now !== undefined && now !== holds.name) absent.add(now);
+    } else if (now !== undefined) absent.add(now);
+  }
+  for (const name of overrides.keys()) {
+    drop.delete(name);
+    absent.delete(name);
+  }
+  return { drop, absent, overrides, anchors };
+}
+
+/** Every syntactic declaration of a model (named ones and anonymous instances), each file's sorted by position. */
+function declsByFile(tables: DeclTables): Map<string, DeclEntry[]> {
+  const out = new Map<string, DeclEntry[]>();
+  for (const entry of tables.byName.values()) {
+    const list = out.get(entry.file.path);
+    if (list === undefined) out.set(entry.file.path, [entry]);
+    else list.push(entry);
+  }
+  for (const list of out.values()) list.sort((a, b) => a.decl.span.start - b.decl.span.start);
+  return out;
+}
+
+/** The declaration of `file` whose range holds `at`, if any. */
+function declAt(byFile: ReadonlyMap<string, readonly DeclEntry[]>, file: string, at: Position): DeclEntry | undefined {
+  return byFile.get(file)?.find((entry) => rangeContains(entry.decl.range, at));
+}
+
+/** A position moved from a declaration that starts at `from` to the same place of one that starts at `to`. */
+function moved(p: Position, from: Position, to: Position): Position {
+  return { line: p.line - from.line + to.line, character: p.line === from.line ? p.character - from.character + to.character : p.character };
+}
+
+/**
+ * §4.7 (2c1, AF6): the working copy's facts under the mask, field by field (§2.9). `current` must have facts (the
+ * stage judgement's, `judged-facts.json`): `maskedModel` builds without facts when it has none. A name only Lean reports
+ * (a field, a constructor) goes with its parent: the facts' `parent`, else the declaration whose range holds it, else the
+ * longest name prefix that is a declaration, as computeItems reads it. A target's `.holds` keeps B's DeclFacts as B has
+ * them, positions included (the build places its refs against B's range, `codeOverride`), in the working copy's file;
+ * B's messages for it go to the start of the target's statement in the working copy (fixer 2c1 r1, S-V2C1-S4). The
+ * decls keep the working copy's order; `check.probed` counts the masked ones; no `detail` stays (A-ADV-6).
+ */
+export function maskFacts(i: { current: ProjectModel; base: ProjectModel; mask: BaseMask }): LeanFacts {
+  const facts = i.current.facts;
+  if (facts === undefined) throw new ActionError('invalid', 'The base mask needs the facts of the state it masks; build that state without facts instead.');
+  const { drop, absent, overrides, anchors } = maskedNames(i.current, i.base, i.mask);
+  const W = declTables(i.current);
+  const B = declTables(i.base);
+  const wByFile = declsByFile(W);
+  const bByFile = declsByFile(B);
+  const hidden = (name: string) => drop.has(name) || absent.has(name);
+  /** W's declaration of a W DeclFacts: by name in its file, or an anonymous instance by its file and start line. */
+  const entryOf = (f: DeclFacts): DeclEntry | undefined => {
+    const named = W.byName.get(f.name);
+    if (named !== undefined && named.file.path === f.file) return named;
+    return wByFile.get(f.file)?.find((e) => e.decl.fullName === undefined && e.decl.keyword === 'instance' && e.decl.range.start.line === f.range.start.line);
+  };
+  /** The declaration a facts-only name goes with (computeItems' rule). */
+  const parentOf = (f: DeclFacts): string | undefined => {
+    if (f.parent !== undefined) return f.parent;
+    const around = declAt(wByFile, f.file, f.range.start);
+    if (around !== undefined) return around.name;
+    let best: string | undefined;
+    for (const name of W.byName.keys()) if (f.name.startsWith(`${name}.`) && (best === undefined || name.length > best.length)) best = name;
+    return best;
+  };
+  /** A name B has with the same text in the working copy (and not left out): its proof-derived facts are B's. */
+  const sameText = (entry: DeclEntry | undefined): DeclEntry | undefined => {
+    if (entry === undefined || hidden(entry.name) || overrides.has(entry.name)) return undefined;
+    const before = B.byName.get(entry.name);
+    return before !== undefined && before.text === entry.text ? before : undefined;
+  };
+  const withBaseProof = (f: DeclFacts, b: DeclFacts | undefined): DeclFacts => {
+    const { axioms: _axioms, usesSorry: _usesSorry, ...rest } = f;
+    void _axioms;
+    void _usesSorry;
+    return { ...rest, ...(b?.axioms !== undefined ? { axioms: [...b.axioms] } : {}), ...(b?.usesSorry !== undefined ? { usesSorry: b.usesSorry } : {}) };
+  };
+  const baseFactsOf = (name: string, entry: DeclEntry | undefined) => factsOf(i.base, name, entry);
+  /** B's DeclFacts of a target's `.holds`, in the working copy's file (the build matches facts to declarations by file). */
+  const overridden = (name: string): DeclFacts | undefined => {
+    const b = baseFactsOf(name, overrides.get(name));
+    const now = W.byName.get(name);
+    if (b === undefined) return undefined;
+    return now !== undefined ? { ...b, file: now.file.path, module: moduleOfPath(now.file.path) ?? b.module } : { ...b };
+  };
+
+  const decls: DeclFacts[] = [];
+  const emitted = new Set<string>();
+  for (const f of facts.decls) {
+    const entry = entryOf(f);
+    const owner = entry?.name ?? parentOf(f) ?? f.name;
+    if (hidden(f.name) || hidden(owner)) continue;
+    if (overrides.has(f.name)) {
+      const b = overridden(f.name);
+      if (b !== undefined && !emitted.has(f.name)) decls.push(b);
+      emitted.add(f.name);
+      continue;
+    }
+    if (overrides.has(owner)) continue;
+    const same = sameText(entry ?? W.byName.get(owner));
+    if (same !== undefined) {
+      decls.push(withBaseProof(f, entry !== undefined ? baseFactsOf(entry.name, same) : i.base.declFacts.get(f.name)));
+      continue;
+    }
+    decls.push(f);
+  }
+  // A target's `.holds` the working copy has with no facts of its own still shows B's proof.
+  for (const name of [...overrides.keys()].sort()) {
+    if (emitted.has(name)) continue;
+    const b = overridden(name);
+    if (b !== undefined) decls.push(b);
+  }
+
+  const messages: LeanMessageFact[] = [];
+  for (const m of facts.build.messages) {
+    if (m.file === undefined || m.range === undefined) continue;
+    const entry = declAt(wByFile, m.file, m.range.start);
+    if (entry === undefined || hidden(entry.name) || overrides.has(entry.name) || sameText(entry) !== undefined) continue;
+    messages.push(m);
+  }
+  for (const m of i.base.facts?.build.messages ?? []) {
+    if (m.file === undefined || m.range === undefined) continue;
+    const before = declAt(bByFile, m.file, m.range.start);
+    if (before === undefined) continue;
+    const now = W.byName.get(before.name);
+    if (now === undefined) continue;
+    const at = (entry: DeclEntry) => ({ file: entry.file.path, ...(moduleOfPath(entry.file.path) !== undefined ? { module: moduleOfPath(entry.file.path) as string } : {}) });
+    if (overrides.has(before.name)) {
+      // Placed at the start of the target's statement in the working copy, so it attaches to the same card wherever the
+      // step put the `.holds`, and keeps its place among the other diagnostics (fixer 2c1 r1, S-V2C1-S4).
+      const anchor = W.byName.get(anchors.get(before.name) ?? '') ?? now;
+      const start = anchor.decl.range.start;
+      messages.push({ ...withoutPlace(m), ...at(anchor), range: { start, end: start } });
+    } else if (sameText(now) !== undefined) {
+      const from = before.decl.range.start;
+      const to = now.decl.range.start;
+      const range: Range = { start: moved(m.range.start, from, to), end: moved(m.range.end, from, to) };
+      messages.push({ ...withoutPlace(m), ...at(now), range });
+    }
+  }
+
+  // The working copy's envelope, without any `detail`: Lean's own words (a failed probe's first error, a failed build's
+  // or check's) can quote hidden proof material (fixer 2c1 r1, A-ADV-6; §4.7's last residual).
+  const { detail: _detail, probe, ...envelope } = facts;
+  void _detail;
+  return {
+    ...envelope,
+    build: withoutDetail({ ...facts.build, messages }),
+    check: withoutDetail({ ...facts.check, probed: decls.length }),
+    ...(probe !== undefined ? { probe: withoutDetail(probe) } : {}),
+    decls,
+  };
+}
+
+/** A part of the facts without its `detail`. */
+function withoutDetail<T extends { detail?: string }>(part: T): T {
+  const { detail: _detail, ...rest } = part;
+  void _detail;
+  return rest as T;
+}
+
+/** A message without its file, module and range (they are set again). */
+function withoutPlace(m: LeanMessageFact): LeanMessageFact {
+  const { file: _file, module: _module, range: _range, ...rest } = m;
+  void _file;
+  void _module;
+  void _range;
+  return rest;
+}
+
+/**
+ * The build's form of a base mask (`ProjectMask`, project/types.ts): the names left out (`drop`: proof-phase
+ * declarations no card binds and the written premise cards' declarations; `absent`: the working copy's `.holds` of
+ * targets B had none for), a `codeOverride` for each target's `.holds` B has that the working copy declares (B's text,
+ * range and keyword, and the text B had between the card's statement and it when B's code held both as one stretch),
+ * `codeLayout` (B's layout of every other card whose statement and `.holds` have B's texts), the `lines` that go with a
+ * left-out declaration (its attached comments and enclosing lines, `compareTexts`), Claude's arrows, the written premise
+ * cards, the marks to restore, and `derivedIds`: a card whose `id:` line telelean wrote back over B's derived id while
+ * its `lean:` pins stayed B's, with that id (only a hidden write, current or taken out, writes such an id).
+ */
+export function projectMaskOf(i: { current: ProjectModel; base: ProjectModel; mask: BaseMask }): ProjectMask {
+  const { drop, absent, overrides } = maskedNames(i.current, i.base, i.mask);
+  const W = declTables(i.current);
+  const B = declTables(i.base);
+  /** B's text between a B card's statement and its `.holds` when B's code held both as one stretch. */
+  const jointOf = (node: ModelNode | undefined): string | undefined => {
+    const statement = node?.statementDecl;
+    const holds = node?.holdsDecl;
+    const statementFile = statement !== undefined ? i.base.files.get(statement.file) : undefined;
+    const holdsFile = holds !== undefined ? i.base.files.get(holds.file) : undefined;
+    return statement !== undefined && holds !== undefined && statementFile !== undefined && holdsFile !== undefined
+      ? codeJoint({ file: statementFile, decl: statement.decl }, { file: holdsFile, decl: holds.decl })
+      : undefined;
+  };
+  const codeOverride = record<ProjectMask['codeOverride'][string]>();
+  for (const [name, entry] of [...overrides].sort(([a], [b]) => (a < b ? -1 : 1))) {
+    if (!W.byName.has(name)) continue;
+    const card = i.base.ownerOfDecl.get(name);
+    const joined = jointOf(card !== undefined ? i.base.nodes.get(card) : undefined);
+    codeOverride[name] = { text: entry.text, range: entry.decl.range, keyword: entry.decl.keyword, ...(joined !== undefined ? { joined } : {}) };
+  }
+  // B's layout of every other card the working copy has with B's statement and `.holds` (fixer 2c1 r1, C-V2C1-C3).
+  const left = (name: string) => drop.has(name) || absent.has(name) || overrides.has(name);
+  const sameText = (name: string) => W.byName.get(name)?.text !== undefined && W.byName.get(name)?.text === B.byName.get(name)?.text;
+  const codeLayout = record<ProjectMask['codeLayout'][string]>();
+  for (const [id, now] of [...i.current.nodes].sort(([a], [b]) => (a < b ? -1 : 1))) {
+    const before = i.base.nodes.get(id);
+    const statement = now.node.lean.statement;
+    if (before === undefined || statement === undefined || before.node.lean.statement !== statement) continue;
+    const holds = holdsName(statement);
+    if (left(statement) || left(holds) || now.holdsDecl === undefined || before.holdsDecl === undefined || before.statementDecl === undefined) continue;
+    if (!sameText(statement) || !sameText(holds)) continue;
+    const joined = jointOf(before);
+    codeLayout[holds] = joined !== undefined ? { joined } : {};
+  }
+  // The lines that go with a left-out declaration, or with a target's `.holds` whose card shows B's (a proof's comment
+  // goes with the Result): its attached comments, and enclosing lines around such declarations only.
+  const leftOut = (name: string) => drop.has(name) || absent.has(name) || overrides.has(name);
+  const lines = record<Span[]>();
+  for (const file of compareTexts(i.base, i.current).files) {
+    for (const unit of file.added) {
+      if (unit.kind !== 'line') continue;
+      const attached = unit.attachedTo !== undefined && leftOut(unit.attachedTo);
+      const encloses = unit.enclosing === true && (unit.encloses ?? []).length > 0 && (unit.encloses ?? []).every(leftOut);
+      if (attached || encloses) (lines[file.path] ??= []).push({ start: unit.span.start, end: unit.span.end });
+    }
+  }
+  const derivedIds = record<string>();
+  for (const [id, entry] of [...i.current.nodes].sort(([a], [b]) => (a < b ? -1 : 1))) {
+    const now = entry.block;
+    const before = i.base.nodes.get(id)?.block;
+    if (before === undefined || before.idWritten || !now.idWritten) continue;
+    const pins = (blockLines: typeof now.lines) => blockLines.filter((l) => l.key === 'lean').map((l) => l.raw.trim());
+    if (JSON.stringify(pins(now.lines)) !== JSON.stringify(pins(before.lines))) continue;
+    derivedIds[now.id] = before.id;
+  }
+  return {
+    absent: [...absent].sort(),
+    codeOverride,
+    codeLayout,
+    lines,
+    drop: [...drop].sort(),
+    dropArrows: i.mask.dropArrows.map((a) => ({ source: a.source, target: a.target })),
+    dropNodes: [...i.mask.dropNodes],
+    restoreMarks: [...i.mask.restoreMarks],
+    derivedIds,
+  };
+}
+
+/**
+ * The masked project (§4.7, D2-61): the working copy's files under `projectMaskOf`, with `maskFacts`' facts (none when
+ * the working copy has none). Freshness is the working copy's: a file fresh there is fresh here, and every other file
+ * keeps the state its module gives it. A file B lacks whose every declaration the mask leaves out, with no block, is left
+ * out whole (a new module of proof material only). `endorsements` and `lakefile` (fixer 2c1 r1, S-V2C1-S6): the
+ * working copy's build inputs a ProjectModel does not keep, passed through, so the masked board flags what the working
+ * copy's flags. 2c2's `buildSessionView` builds the hidden view's graph from it.
+ */
+export function maskedModel(i: {
+  current: ProjectModel;
+  base: ProjectModel;
+  mask: BaseMask;
+  endorsements?: ProjectInput['endorsements'];
+  lakefile?: ProjectInput['lakefile'];
+}): ProjectModel {
+  const mask = projectMaskOf(i);
+  const left = new Set([...mask.drop, ...mask.absent]);
+  const byFile = declsByFile(declTables(i.current));
+  const files = [...i.current.files.values()].filter((file) => {
+    if (i.base.files.has(file.path) || file.blocks.length > 0) return true;
+    const decls = byFile.get(file.path) ?? [];
+    return decls.length === 0 || !decls.every((e) => left.has(e.name));
+  });
+  const facts = i.current.facts !== undefined ? maskFacts(i) : undefined;
+  const modules = new Map((i.current.facts?.modules ?? []).map((m) => [m.file, m.sourceSha256]));
+  const fileHashes: Record<string, string> = {};
+  for (const file of files) {
+    const hash = modules.get(file.path) ?? '';
+    fileHashes[file.path] = i.current.freshFiles.has(file.path) ? hash : `${hash}~not-fresh`;
+  }
+  return buildProjectModel({
+    files,
+    fileHashes,
+    ...(facts !== undefined ? { facts } : {}),
+    library: i.current.library,
+    ...(i.endorsements !== undefined ? { endorsements: i.endorsements } : {}),
+    ...(i.lakefile !== undefined ? { lakefile: i.lakefile } : {}),
+    mask,
+  });
+}
diff --git a/packages/core/src/review/permitted.ts b/packages/core/src/review/permitted.ts
new file mode 100644
index 0000000..1418d4f
--- /dev/null
+++ b/packages/core/src/review/permitted.ts
@@ -0,0 +1,154 @@
+/**
+ * Slice 2b1b (docs/slice2-plan.md section 4.8): B.1 for one inference on one state.
+ *
+ *   permitted(T) = the standard axioms ∪ the signature axioms ∪ the presuppositions of T's and the sources' statements
+ *                  ∪ ⋃ contrib(u), for u in sources(Q(T) ∪ E(T)), u ≠ T; T.holds and sorryAx excluded.
+ *
+ *  - Q(T)'s sources count only while their arrow exists in the state judged (D2-59): a source of the question with no
+ *    arrow into T in `current` is no source here (so not in `contrib`, nor allowed by B.2).
+ *  - E(T) (`extra`): the ledger's arrows into T whose item is not declined and that the judged state draws (the active
+ *    step's own before its normalise writes them; fixer 2b1b r1, A-ADV-1: a cascade's revert takes an arrow out of
+ *    ws/ but leaves its entry), plus T's written premises (the ledger's `premise` entries for T). So E(T) is what ws/
+ *    holds (AF2, AF12).
+ *  - contrib(u):
+ *      claim         an axiom `.holds` without TL114, on an axiom card, or on a pending one (`pending`: the Result then
+ *                    rests on pending);
+ *      own-proof     the person's own unchanged proof from B (`footprintSinceBase`, as slice 1);
+ *      session-proof u is a target of the session whose `.holds` here is a theorem that differs from B's, and u's
+ *                    inference passes in this same state (`earlier`, judged sources first): its footprint, and u joins
+ *                    `throughResults` (an RV-5 edge). The state decides, never the records (D2-48, D2-63);
+ *      nothing       otherwise, with why: `no-holds`, `conditional`, `mismatch`, `circular`, `not-passing` (a session
+ *                    proof whose inference does not pass, or was not judged before T), `unchecked` (no facts, or a
+ *                    proof neither the person's own unchanged one nor a session target's).
+ *
+ * So no Claude proof widens the set it is judged against (M2's P2 fix, generalised): a footprint enters permitted(T)
+ * only from the person's own unchanged proof, or from a session proof that passes its own inference in the same state.
+ *
+ * Pure TypeScript: no Node or vscode APIs (the webview bundles core).
+ */
+import { holdsName, SORRY_AXIOM, STANDARD_AXIOM_NAMES } from '../facts.js';
+import { declTables } from '../gate/decls.js';
+import { footprintSinceBase, signatureAxioms } from '../gate/permitted.js';
+import { meaningChanged } from '../gate/sessionRules.js';
+import type { TlNode } from '../model.js';
+import type { ProjectModel } from '../project/types.js';
+import { compareLeanNames } from '../project/text.js';
+import { arrowKey } from './keys.js';
+import type { InferenceJudgement, ItemRecord, LedgerEntry, SessionInference } from './types.js';
+
+type Contribution = InferenceJudgement['contrib'][string];
+
+/**
+ * E(T)'s sources (§4.8): the ledger's `arrow` entries into T whose item is not declined and whose arrow `current` draws
+ * into T, then T's written premises (the ledger's `premise` entries for T), each once, in ledger order. `activeStep`:
+ * the running step, whose own entries count before its normalise draws them (fixer 2b1b r1, A-ADV-1: an arrow a
+ * cascade's revert took out of ws/ keeps its entry, and a proof could otherwise use its source with no arrow drawn).
+ * `current`, the judged state, is required (fixer 2b1b r2, R1-2): the ledger and the records alone are not E(T).
+ */
+export function extraSources(target: string, ledger: readonly LedgerEntry[], items: readonly ItemRecord[], current: ProjectModel, activeStep?: string): string[] {
+  const declined = new Set(items.filter((r) => r.status === 'declined').map((r) => r.key));
+  const drawn = current.nodes.get(target)?.node.premises ?? [];
+  const out: string[] = [];
+  for (const entry of ledger) {
+    if (entry.kind === 'arrow' && entry.target === target && !declined.has(arrowKey(entry.source, entry.target))) {
+      if (entry.step !== activeStep && !drawn.includes(entry.source)) continue;
+      out.push(entry.source);
+    } else if (entry.kind === 'premise' && entry.target === target) out.push(entry.card);
+  }
+  return [...new Set(out)];
+}
+
+/** Q(T)'s sources that count in this state: those whose arrow into T exists in `current` (D2-59). */
+export function questionSources(current: ProjectModel, target: string, question: SessionInference['question']): string[] {
+  const premises = current.nodes.get(target)?.node.premises ?? [];
+  return [...new Set(question.sources)].filter((s) => premises.includes(s));
+}
+
+/**
+ * u's `.holds` in `current` is a theorem whose declaration B does not have as it is (a proof of this session): its text
+ * differs, or (fixer 2b1b r1, A-ADV-4) its text is B's but its meaning is not (D2-41: printed type and value, value and
+ * type constants), e.g. the person's proof elaborated through a `@[simp]` lemma a step added.
+ */
+export function isSessionProof(base: ProjectModel, current: ProjectModel, u: string): boolean {
+  const node = current.nodes.get(u)?.node;
+  const statement = node?.lean.statement;
+  if (node === undefined || statement === undefined || node.lean.justificationKind !== 'theorem') return false;
+  const holds = holdsName(statement);
+  const now = declTables(current).byName.get(holds);
+  if (now === undefined) return current.declFacts.has(holds) && !base.declFacts.has(holds);
+  if (declTables(base).byName.get(holds)?.text !== now.text) return true;
+  return meaningChanged(base, current, holds);
+}
+
+/**
+ * §4.8 (2b1b): B.1 for one inference on one state. `earlier`: the judgements of the inferences judged before it,
+ * sources first; `items` and `ledger` give E(T). judgeState calls it once per inference (AF8). `inferences` gives Q(T)
+ * (the caller passes the active step's question for its target) and the session's targets.
+ */
+export function permittedFor(i: {
+  base: ProjectModel;
+  current: ProjectModel;
+  target: string;
+  inferences: readonly SessionInference[];
+  ledger: readonly LedgerEntry[];
+  items: readonly ItemRecord[];
+  earlier: Readonly<Record<string, InferenceJudgement>>;
+  /** The running step at step purposes: its own ledger arrows count in E(T) before its normalise draws them. */
+  activeStep?: string;
+}): Pick<InferenceJudgement, 'extra' | 'contrib' | 'permitted' | 'throughResults'> {
+  const { base, current, target } = i;
+  const node = current.nodes.get(target)?.node;
+  const statement = node?.lean.statement ?? base.nodes.get(target)?.node.lean.statement;
+  const targetHolds = statement !== undefined ? holdsName(statement) : undefined;
+  const inference = i.inferences.find((inf) => inf.target === target);
+  const extra = extraSources(target, i.ledger, i.items, current, i.activeStep);
+  const sources = [...new Set([...(inference ? questionSources(current, target, inference.question) : []), ...extra])].filter((s) => s !== target);
+  const targets = new Set(i.inferences.map((inf) => inf.target));
+
+  const presuppositions: string[] = [...(node?.lean.presupposes ?? [])];
+  const granted: string[] = [];
+  const contrib: InferenceJudgement['contrib'] = {};
+  const throughResults: string[] = [];
+
+  /** What u gives, and the axioms it adds to the permitted set. */
+  const contribOf = (u: string, n: TlNode): { c: Contribution; axioms: string[] } => {
+    const nothing = (reason: NonNullable<Contribution['reason']>) => ({ c: { kind: 'nothing' as const, reason }, axioms: [] });
+    const own = n.lean.statement;
+    if (own === undefined || n.lean.justification === undefined) return nothing('no-holds');
+    if (n.status.flags.includes('holds-mismatch')) return nothing('mismatch');
+    if (n.lean.justificationKind === 'axiom') {
+      return { c: { kind: 'claim', ...(n.type === 'PROPOSITION' ? { pending: true } : {}) }, axioms: [holdsName(own)] };
+    }
+    const proof = n.status.proof;
+    if (proof.kind === 'conditional') return nothing('conditional');
+    if (proof.kind !== 'proved' || n.lean.axioms === undefined) return nothing('unchecked');
+    const axioms = n.lean.axioms.filter((a) => a !== SORRY_AXIOM);
+    if (targetHolds !== undefined && axioms.includes(targetHolds)) return nothing('circular');
+    const mine = footprintSinceBase(current, base, u, n, targetHolds);
+    if (mine !== undefined) return { c: { kind: 'own-proof' }, axioms: mine };
+    if (targets.has(u) && isSessionProof(base, current, u)) {
+      const judged = Object.hasOwn(i.earlier, u) ? i.earlier[u] : undefined;
+      if (judged?.passes !== true) return nothing('not-passing');
+      throughResults.push(u);
+      return { c: { kind: 'session-proof' }, axioms };
+    }
+    return nothing('unchecked');
+  };
+
+  for (const u of sources) {
+    const n = current.nodes.get(u)?.node;
+    if (n === undefined) {
+      contrib[u] = { kind: 'nothing', reason: 'no-holds' };
+      continue;
+    }
+    presuppositions.push(...(n.lean.presupposes ?? []));
+    const { c, axioms } = contribOf(u, n);
+    contrib[u] = c;
+    granted.push(...axioms);
+  }
+
+  const permitted = [...new Set([...STANDARD_AXIOM_NAMES, ...signatureAxioms(current), ...presuppositions, ...granted])]
+    .filter((a) => a !== targetHolds && a !== SORRY_AXIOM)
+    .sort(compareLeanNames);
+  return { extra, contrib, permitted, throughResults };
+}
