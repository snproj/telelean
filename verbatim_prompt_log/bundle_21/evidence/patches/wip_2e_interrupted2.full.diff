+  };
+
+  // Belt and braces: the viewport clips its content (overflow: clip), so nothing should scroll it; if the browser
+  // scrolls it anyway (bringing a focused card into view), the scroll becomes a pan.
+  const onViewportScroll = () => {
+    const { scrollLeft, scrollTop } = viewport;
+    if (scrollLeft === 0 && scrollTop === 0) return;
+    viewport.scrollLeft = 0;
+    viewport.scrollTop = 0;
+    canvas.panBy(-scrollLeft, -scrollTop);
+  };
+
+  // The rubber band follows the source card when the column scrolls or the canvas pans or zooms during a draw (the
+  // engine draws a frame after each of them).
+  const offFrame = engine.onFrame(() => {
+    if (press?.kind === 'draw' && press.tracker.dragging) updateDraw(press);
+  });
+
+  // ES-9: an edit session that begins during a move or a draw ends it (the host would refuse the edit), and switching
+  // to the Proposed view ends any gesture but a pan.
+  const offStore = store.subscribe((state) => {
+    const p = press;
+    if (!p || p.kind === 'right') return;
+    const g = gestureGateOf(state);
+    if ((p.kind === 'move' && g.move !== null) || (p.kind === 'draw' && g.draw !== null) || (p.kind === 'area' && !g.select)) abort();
+  });
+
+  document.addEventListener('pointerdown', onAnyPointerDown, true);
+  board.addEventListener('pointerdown', onPointerDown);
+  board.addEventListener('pointermove', onPointerMove);
+  board.addEventListener('pointerup', onPointerUp);
+  board.addEventListener('pointercancel', cancel);
+  board.addEventListener('pointerleave', onPointerLeave);
+  board.addEventListener('lostpointercapture', lostCapture);
+  board.addEventListener('click', onClick, true);
+  board.addEventListener('contextmenu', onContextMenu);
+  board.addEventListener('wheel', onWheel, { passive: false });
+  viewport.addEventListener('keydown', onKeyDown);
+  window.addEventListener('keydown', onAnyKey, true);
+  viewport.addEventListener('focusin', onFocusIn);
+  viewport.addEventListener('scroll', onViewportScroll);
+  return () => {
+    abort();
+    offFrame();
+    offStore();
+    document.removeEventListener('pointerdown', onAnyPointerDown, true);
+    board.removeEventListener('pointerdown', onPointerDown);
+    board.removeEventListener('pointermove', onPointerMove);
+    board.removeEventListener('pointerup', onPointerUp);
+    board.removeEventListener('pointercancel', cancel);
+    board.removeEventListener('pointerleave', onPointerLeave);
+    board.removeEventListener('lostpointercapture', lostCapture);
+    board.removeEventListener('click', onClick, true);
+    board.removeEventListener('contextmenu', onContextMenu);
+    board.removeEventListener('wheel', onWheel);
+    viewport.removeEventListener('keydown', onKeyDown);
+    window.removeEventListener('keydown', onAnyKey, true);
+    viewport.removeEventListener('focusin', onFocusIn);
+    viewport.removeEventListener('scroll', onViewportScroll);
+  };
+}
diff --git a/packages/webview/src/board/CanvasToolbar.tsx b/packages/webview/src/board/CanvasToolbar.tsx
new file mode 100644
index 0000000..777728c
--- /dev/null
+++ b/packages/webview/src/board/CanvasToolbar.tsx
@@ -0,0 +1,81 @@
+/**
+ * The canvas's toolbar (spec v4 BD-3, slice 1c), in its top-right corner: zoom out, the zoom level, zoom in, Fit all,
+ * Zoom to selection and Tidy layout. Tidy layout re-places the selected cards (all, when none is selected) and stores
+ * their positions, one Undo step; it is an edit, so it is disabled while an edit session is active (ES-9) and in the
+ * Proposed view, with the reason. The view changes always work.
+ */
+import { useCallback, useSyncExternalStore } from 'react';
+import { useBoard, useBoardStore } from '../state/context';
+import { boardView, editLock, proposedOverlay } from '../state/store';
+import type { CanvasView } from './canvas/CanvasView';
+import { MENU_PROPOSED_READ_ONLY } from './menu';
+
+/** The propositions among the selected cards (the ones Tidy layout and Zoom to selection act on). */
+export function selectedOnCanvas(state: Parameters<typeof boardView>[0] & { selected: readonly string[] }): string[] {
+  const nodes = boardView(state).nodes;
+  return state.selected.filter((id) => nodes[id]?.type === 'PROPOSITION');
+}
+
+/** Tidy layout: the new positions of the selected propositions (all, when none is selected), stored as one move. */
+export function tidyLayout(canvas: CanvasView, store: ReturnType<typeof useBoardStore>): boolean {
+  const state = store.getState();
+  const which = selectedOnCanvas(state);
+  const positions = canvas.tidyPositions(which.length > 0 ? which : null);
+  if (Object.keys(positions).length === 0) return false;
+  state.moveCards(positions);
+  return true;
+}
+
+export function CanvasToolbar({ canvas }: { canvas: CanvasView }) {
+  const subscribe = useCallback((listener: () => void) => canvas.onChange(listener), [canvas]);
+  const scale = useSyncExternalStore(subscribe, () => canvas.transform.s);
+  const lock = useBoard((s) => editLock(s));
+  const proposed = useBoard((s) => proposedOverlay(s) !== null);
+  const selected = useBoard((s) => selectedOnCanvas(s).length);
+  const hasCards = useBoard((s) => boardView(s).order.PROPOSITION.length > 0);
+  const store = useBoardStore();
+  const tidyReason = proposed ? MENU_PROPOSED_READ_ONLY : lock;
+  const small = 'tl-button tl-button--secondary tl-button--small';
+
+  return (
+    <div className="tl-canvas__tools" role="toolbar" aria-label="Canvas" data-testid="canvas-tools">
+      <button type="button" className="tl-icon-button tl-icon-button--toolbar" aria-label="Zoom out" title="Zoom out (−)" data-testid="zoom-out" onClick={() => canvas.zoomStep(-1)}>
+        <span className="codicon codicon-zoom-out" aria-hidden="true" />
+      </button>
+      <span className="tl-canvas__zoom" data-testid="zoom-level" title="Zoom: the mouse wheel zooms about the cursor; right-drag pans">
+        {Math.round(scale * 100)}%
+      </span>
+      <button type="button" className="tl-icon-button tl-icon-button--toolbar" aria-label="Zoom in" title="Zoom in (+)" data-testid="zoom-in" onClick={() => canvas.zoomStep(1)}>
+        <span className="codicon codicon-zoom-in" aria-hidden="true" />
+      </button>
+      <button type="button" className={small} data-testid="fit-all" disabled={!hasCards} title="Show every proposition (0)" onClick={() => canvas.fitAll()}>
+        Fit all
+      </button>
+      <button
+        type="button"
+        className={small}
+        data-testid="zoom-selection"
+        disabled={selected === 0}
+        title={selected === 0 ? 'Select propositions on the canvas to zoom to them' : `Show the ${selected === 1 ? 'selected card' : `${selected} selected cards`}`}
+        onClick={() => canvas.fitCards(store.getState().selected)}
+      >
+        Zoom to selection
+      </button>
+      <button
+        type="button"
+        className={small}
+        data-testid="tidy-layout"
+        disabled={tidyReason !== null || !hasCards}
+        title={
+          tidyReason ??
+          (selected > 0
+            ? `Place the ${selected === 1 ? 'selected card' : `${selected} selected cards`} again, sources left of their targets, and keep them there (one Undo step)`
+            : 'Place every proposition again, sources left of their targets, and keep them there (one Undo step)')
+        }
+        onClick={() => tidyLayout(canvas, store)}
+      >
+        Tidy layout
+      </button>
+    </div>
+  );
+}
diff --git a/packages/webview/src/board/ContextMenu.tsx b/packages/webview/src/board/ContextMenu.tsx
new file mode 100644
index 0000000..9bdcb94
--- /dev/null
+++ b/packages/webview/src/board/ContextMenu.tsx
@@ -0,0 +1,104 @@
+/**
+ * The right-click menu (spec v4 CM-7; slice 1c): at the pointer, the actions for the card, arrow, mark or empty canvas
+ * under it (board/menu.ts lists them; BoardInput opens it after a right click without movement and has applied the
+ * selection rule). It is a common/Popover menu hanging from a 1-pixel anchor placed at the pointer through the CSSOM;
+ * when it closes, the focus goes back to the card (or the canvas) it was about. Slice 1e: a drawn arrow's and a
+ * mark's menus offer Formalize for dependencies as the header's Context Menu section does (board/useFormalize.ts),
+ * and every action runs through board/runAction.ts, shared with that section.
+ */
+import { Fragment, useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { Popover } from '../common/Popover';
+import { useBoard, useBoardActions, useBoardStore } from '../state/context';
+import { boardView, editLock, proposedOverlay } from '../state/store';
+import type { MenuRequest } from './BoardInput';
+import type { CanvasView } from './canvas/CanvasView';
+import { menuEntries, menuName, type MenuAction, type MenuThing } from './menu';
+import { runBoardAction } from './runAction';
+import { useFormalize } from './useFormalize';
+
+function menuLabel(thing: MenuThing, name: (id: string) => string): string {
+  switch (thing.kind) {
+    case 'card':
+      return `Actions for “${name(thing.id)}”`;
+    case 'arrow':
+      return `Actions for the arrow from “${name(thing.source)}” into “${name(thing.target)}”`;
+    case 'undeclared':
+      return `Actions for the arrow the proof of “${name(thing.target)}” uses from “${name(thing.source)}” (not drawn)`;
+    case 'mark':
+      return `Actions for the "follows from nothing" mark of “${name(thing.id)}”`;
+    case 'canvas':
+      return 'Canvas actions';
+  }
+}
+
+export function ContextMenu({ menu, onClose, canvas }: { menu: MenuRequest | null; onClose: () => void; canvas: CanvasView }) {
+  const nodes = useBoard((s) => boardView(s).nodes);
+  const selected = useBoard((s) => s.selected);
+  const selectedArrows = useBoard((s) => s.selectedArrows);
+  const selectedMarks = useBoard((s) => s.selectedMarks);
+  const expanded = useBoard((s) => s.expanded);
+  const provisional = useBoard((s) => s.provisional);
+  const lock = useBoard((s) => editLock(s));
+  const proposed = useBoard((s) => proposedOverlay(s) !== null);
+  const formalize = useFormalize();
+  const actions = useBoardActions();
+  const store = useBoardStore();
+  const anchorRef = useRef<HTMLSpanElement>(null);
+  const [anchor, setAnchor] = useState<HTMLElement | null>(null);
+
+  useLayoutEffect(() => {
+    const element = anchorRef.current;
+    if (!element || !menu) {
+      setAnchor(null);
+      return;
+    }
+    element.style.setProperty('left', `${Math.round(menu.x)}px`);
+    element.style.setProperty('top', `${Math.round(menu.y)}px`);
+    setAnchor(element);
+  }, [menu]);
+
+  const entries = useMemo(
+    () => (menu ? menuEntries(menu.thing, { nodes, selected, selectedArrows, selectedMarks, expanded, provisional, lock, proposed, formalize }) : []),
+    [menu, nodes, selected, selectedArrows, selectedMarks, expanded, provisional, lock, proposed, formalize],
+  );
+
+  const run = (action: MenuAction) => {
+    const thing = menu?.thing;
+    onClose();
+    if (!thing) return;
+    runBoardAction(action, thing, { actions, store, nodes, canvas });
+  };
+
+  return (
+    <>
+      <span ref={anchorRef} className="tl-menu-anchor" aria-hidden="true" />
+      <Popover
+        anchor={menu ? anchor : null}
+        open={menu !== null && anchor !== null}
+        onClose={onClose}
+        role="menu"
+        label={menu ? menuLabel(menu.thing, (id) => menuName(nodes, id)) : undefined}
+        testId="board-menu"
+        className="tl-menu tl-board-menu"
+        returnFocus={menu?.returnFocus ?? null}
+      >
+        {entries.map((entry, i) => (
+          <Fragment key={entry.action}>
+            {entry.group && i > 0 ? <div className="tl-menu__separator" role="separator" /> : null}
+            <button
+              type="button"
+              role="menuitem"
+              className="tl-menu__item"
+              data-action={entry.action}
+              disabled={entry.disabled !== null}
+              title={entry.disabled ?? undefined}
+              onClick={() => run(entry.action)}
+            >
+              <span className="tl-menu__text">{entry.label}</span>
+            </button>
+          </Fragment>
+        ))}
+      </Popover>
+    </>
+  );
+}
diff --git a/packages/webview/src/board/DropZone.tsx b/packages/webview/src/board/DropZone.tsx
new file mode 100644
index 0000000..0ded9ac
--- /dev/null
+++ b/packages/webview/src/board/DropZone.tsx
@@ -0,0 +1,36 @@
+/**
+ * The labelled drop zone of a part of the board during a drag that would change a card's kind (D-17): what the drop
+ * would do, from kindChangeImpact (D-11), e.g. "Move to axioms: its proof becomes an axiom". It lets the pointer
+ * through, so the drop still lands on the card or list underneath. An axiom dragged to the propositions is refused
+ * (spec v4 AR-6): the zone says how to make it a proposition instead. Slice 1c: the canvas shows the refusal while an
+ * axiom of the column is dragged over it. Slice 1c2 (AR-7): the AXIOMS column shows its zone while a proposition moved
+ * on the canvas is over it (`id`: the card the drop is about); several moved cards are refused (`several`), since the
+ * column takes one card at a time.
+ */
+import { AXIOM_DROP_REFUSAL, AXIOM_TO_PROPOSITION_REFUSAL, type NodeType } from '@telelean/core';
+import { plainText } from '../model/format';
+import { useBoard } from '../state/context';
+import { impactOf, kindChangeRefused } from '../state/store';
+import { SEVERAL_TO_AXIOMS } from './gestures';
+
+export function DropZone({ kind, id, active, several = false }: { kind: NodeType; id: string; active: boolean; several?: boolean }) {
+  const refused = useBoard((s) => kindChangeRefused(s, id, kind));
+  const summary = useBoard((s) => impactOf(s, id, kind)?.summary ?? null);
+  const detail = useBoard((s) => impactOf(s, id, kind)?.detail ?? null);
+  const confirm = useBoard((s) => impactOf(s, id, kind)?.needsConfirmation === true);
+  if (several || refused) {
+    return (
+      <div className="tl-dropzone" data-testid="dropzone" data-kind={kind} data-refused="true" data-active={active || undefined} aria-hidden="true">
+        <span className="tl-dropzone__summary">{several ? SEVERAL_TO_AXIOMS.summary : AXIOM_DROP_REFUSAL}</span>
+        <span className="tl-dropzone__detail">{several ? SEVERAL_TO_AXIOMS.detail : AXIOM_TO_PROPOSITION_REFUSAL}</span>
+      </div>
+    );
+  }
+  if (!summary) return null;
+  return (
+    <div className="tl-dropzone" data-testid="dropzone" data-kind={kind} data-active={active || undefined} data-confirm={confirm || undefined} aria-hidden="true">
+      <span className="tl-dropzone__summary">{summary}</span>
+      {detail ? <span className="tl-dropzone__detail">{plainText(detail)}</span> : null}
+    </div>
+  );
+}
diff --git a/packages/webview/src/board/PropositionCanvas.tsx b/packages/webview/src/board/PropositionCanvas.tsx
new file mode 100644
index 0000000..5028af7
--- /dev/null
+++ b/packages/webview/src/board/PropositionCanvas.tsx
@@ -0,0 +1,277 @@
+/**
+ * The PROPOSITIONS canvas (spec v4 BD-1, BD-3; slice 1c): a viewport (overflow clipped, focusable) holding one
+ * transformed layer, in which every proposition is absolutely positioned at its stored position, or at the place the
+ * layered placement gives it (canvas/placement.ts, from the cards' measured collapsed sizes; never written until the
+ * user moves the card or chooses Tidy layout). The view (pan and zoom) is CanvasView's; the pointer, wheel and keys are
+ * BoardInput's. The cards sit in the DOM in reading order (top to bottom, then left to right), so Tab goes through
+ * them in that order after the AXIOMS column; when a new placement changes that order, React moves card elements,
+ * which drops the keyboard focus, so the canvas gives it back. An expanded card opens over the cards below it (raised
+ * above them and above the arrows), without moving anything.
+ *
+ * The Proposed view shows the cards it shares with the Current board where the Current board last showed them (stored
+ * or placed: `keepCurrentPlaces`), so switching views moves no card; only the proposal's new cards are placed anew.
+ *
+ * Positions reach the DOM as CSS custom properties set through the CSSOM (`--tl-x`, `--tl-y` on each card's slot):
+ * the CSP allows no inline style attributes.
+ */
+import { dropTargetForElements } from '@atlaskit/pragmatic-drag-and-drop/adapter/element-adapter';
+import { memo, useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { useBoard, useBoardStore } from '../state/context';
+import { boardView, editLock, proposedOverlay } from '../state/store';
+import { placeSlot, SLOT_SELECTOR } from './BoardInput';
+import type { CanvasView } from './canvas/CanvasView';
+import { keepCurrentPlaces, PLACEMENT, placeCards, tidyPositions, type PlacementInput } from './canvas/placement';
+import type { Box, Point, Size } from './canvas/view';
+import { CanvasToolbar } from './CanvasToolbar';
+import { columnTargetData, isCardDragData } from './dnd';
+import { DropZone } from './DropZone';
+import { CANVAS_SIDES, type CanvasSide } from './geometry';
+import { NodeCard } from './NodeCard';
+
+export interface CanvasRefs {
+  viewport: (element: HTMLDivElement | null) => void;
+  layer: (element: HTMLDivElement | null) => void;
+  /** One empty element per canvas edge: the engine puts that edge's "n linked" button there. */
+  slots: Readonly<Record<CanvasSide, (element: HTMLSpanElement | null) => void>>;
+}
+
+const ESTIMATE: Size = { w: PLACEMENT.cardWidth, h: PLACEMENT.estimatedHeight };
+
+/**
+ * A card's collapsed size: its border box, less its details while it is expanded (BD-3: placement uses the collapsed
+ * sizes, so expanding a card never moves another one).
+ */
+function collapsedSize(card: HTMLElement): Size {
+  const details = card.querySelector<HTMLElement>(':scope > .tl-details');
+  if (!details) return { w: card.offsetWidth, h: card.offsetHeight };
+  const margin = Number.parseFloat(getComputedStyle(details).marginTop) || 0;
+  return { w: card.offsetWidth, h: Math.max(24, card.offsetHeight - details.offsetHeight - margin) };
+}
+
+const CanvasSlot = memo(function CanvasSlot({ id, x, y, expanded }: { id: string; x: number; y: number; expanded: boolean }) {
+  const ref = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    if (ref.current) placeSlot(ref.current, x, y);
+  }, [x, y]);
+  return (
+    <div ref={ref} className="tl-canvas__slot" data-slot-id={id} data-expanded={expanded || undefined}>
+      <NodeCard id={id} place="canvas" />
+    </div>
+  );
+});
+
+export function PropositionCanvas({ canvas, refs }: { canvas: CanvasView; refs: CanvasRefs }) {
+  const ids = useBoard((s) => boardView(s).order.PROPOSITION);
+  const nodes = useBoard((s) => boardView(s).nodes);
+  const viewStored = useBoard((s) => boardView(s).positions);
+  const proposed = useBoard((s) => proposedOverlay(s) !== null);
+  const expanded = useBoard((s) => s.expanded);
+  const subject = useBoard((s) => s.subject);
+  const hasGraph = useBoard((s) => s.version !== null);
+  const dragFrom = useBoard((s) => s.drag?.from ?? null);
+  const dragId = useBoard((s) => s.drag?.id ?? null);
+  const dropActive = useBoard((s) => s.dropKind === 'PROPOSITION');
+  const store = useBoardStore();
+  const viewport = useRef<HTMLDivElement | null>(null);
+  const layer = useRef<HTMLDivElement | null>(null);
+  /** Measured collapsed sizes, by card id. */
+  const [sizes, setSizes] = useState<ReadonlyMap<string, Size>>(() => new Map());
+  /** Where the Current board last showed its cards (stored or placed), by subject: the Proposed view keeps them there. */
+  const currentShown = useRef(new Map<string, Readonly<Record<string, Point>>>());
+  /** The element on the canvas that has the keyboard focus (a card, or a control in one), to give it back after a re-sort. */
+  const focused = useRef<{ id: string; element: HTMLElement } | null>(null);
+
+  // The Proposed view (read-only, nothing is written): the proposal's positions, then the Current board's places.
+  const stored = useMemo(
+    () => (proposed ? keepCurrentPlaces(ids, viewStored, currentShown.current.get(subject)) : viewStored),
+    [proposed, ids, viewStored, subject],
+  );
+
+  const input = useMemo<PlacementInput>(
+    () => ({
+      ids,
+      premisesOf: (id) => nodes[id]?.premises ?? [],
+      isAxiom: (id) => nodes[id]?.type === 'AXIOM',
+      stored,
+      sizeOf: (id) => sizes.get(id) ?? ESTIMATE,
+    }),
+    [ids, nodes, stored, sizes],
+  );
+  const placed = useMemo(() => placeCards(input), [input]);
+  // Reading order: top to bottom, then left to right (the Tab order, BD-3).
+  const sorted = useMemo(() => [...ids].sort((a, b) => (placed[a]?.y ?? 0) - (placed[b]?.y ?? 0) || (placed[a]?.x ?? 0) - (placed[b]?.x ?? 0)), [ids, placed]);
+
+  // What the Current board shows, for the Proposed view (above).
+  useLayoutEffect(() => {
+    if (!proposed) currentShown.current.set(subject, placed);
+  }, [proposed, subject, placed]);
+
+  // Which element on the canvas has the focus. A press anywhere else means the user moved on, even to something that
+  // takes no focus: the focus is then not given back.
+  useEffect(() => {
+    const onFocusIn = (event: FocusEvent) => {
+      const target = event.target;
+      const slot = target instanceof HTMLElement && layer.current?.contains(target) ? target.closest<HTMLElement>(SLOT_SELECTOR) : null;
+      const id = slot?.dataset.slotId;
+      focused.current = id && target instanceof HTMLElement ? { id, element: target } : null;
+    };
+    const onPointerDown = (event: PointerEvent) => {
+      const f = focused.current;
+      if (f && !(event.target instanceof Node && f.element.contains(event.target))) focused.current = null;
+    };
+    document.addEventListener('focusin', onFocusIn, true);
+    document.addEventListener('pointerdown', onPointerDown, true);
+    return () => {
+      document.removeEventListener('focusin', onFocusIn, true);
+      document.removeEventListener('pointerdown', onPointerDown, true);
+    };
+  }, []);
+
+  // A new reading order (a move, an edit that changed a card's height, a new graph) makes React move card elements,
+  // and moving the focused one drops the keyboard focus to <body>: give it back (to the same element, else its card),
+  // without scrolling. BoardInput brings a card focused from the keyboard into view.
+  useLayoutEffect(() => {
+    const f = focused.current;
+    const active = document.activeElement;
+    if (!f || (active !== null && active !== document.body)) return;
+    const target = f.element.isConnected
+      ? f.element
+      : layer.current?.querySelector<HTMLElement>(`${SLOT_SELECTOR}[data-slot-id="${CSS.escape(f.id)}"] > .tl-card`);
+    if (target) target.focus({ preventScroll: true });
+    else focused.current = null;
+  }, [sorted]);
+
+  /** Reads the cards' collapsed sizes; a change re-places the cards that have no stored position. */
+  const measure = useCallback(() => {
+    const element = layer.current;
+    if (!element) return;
+    setSizes((previous) => {
+      const next = new Map<string, Size>();
+      let changed = false;
+      for (const slot of element.querySelectorAll<HTMLElement>('[data-slot-id]')) {
+        const id = slot.dataset.slotId;
+        const card = slot.querySelector<HTMLElement>(':scope > .tl-card');
+        if (!id || !card) continue;
+        const old = previous.get(id);
+        // An expanded card keeps the collapsed size measured before it opened.
+        const size = card.dataset.expanded && old ? old : collapsedSize(card);
+        if (size.w === 0 && size.h === 0) {
+          if (old) next.set(id, old);
+          continue;
+        }
+        next.set(id, size);
+        if (!old || Math.abs(old.w - size.w) >= 1 || Math.abs(old.h - size.h) >= 1) changed = true;
+      }
+      if (next.size !== previous.size) changed = true;
+      return changed ? next : previous;
+    });
+  }, []);
+
+  // After every render: new cards, edited sentences, expanded or collapsed cards.
+  useLayoutEffect(measure);
+
+  // Text reflow without a render (fonts loading, the panel resizing the card's chips): measure again.
+  useEffect(() => {
+    const element = layer.current;
+    if (!element) return;
+    const observer = new ResizeObserver(() => measure());
+    for (const card of element.querySelectorAll('.tl-card')) observer.observe(card);
+    return () => observer.disconnect();
+  }, [sorted, measure]);
+
+  // The canvas as laid out: what the view (Fit all, reveals, moves) and the edge engine work with.
+  useLayoutEffect(() => {
+    const boxes = new Map<string, Box>();
+    for (const id of ids) {
+      const p = placed[id];
+      if (!p) continue;
+      const size = sizes.get(id) ?? ESTIMATE;
+      boxes.set(id, { x: p.x, y: p.y, w: size.w, h: size.h });
+    }
+    canvas.setLayout(boxes);
+  }, [canvas, ids, placed, sizes]);
+
+  // Tidy layout re-places cards with this board's placement, around the others where they are shown.
+  useEffect(() => {
+    canvas.setTidyPlanner((which) => tidyPositions(input, placed, which));
+    return () => canvas.setTidyPlanner(null);
+  }, [canvas, input, placed]);
+
+  // The first view of a board (and of each subject): Fit all, once the cards have been measured.
+  const measuredAll = ids.every((id) => sizes.has(id));
+  const fitFirst = useCallback(() => {
+    if (!hasGraph || canvas.fittedFor === subject || !measuredAll) return;
+    if (ids.length === 0 || canvas.fitInitial()) canvas.fittedFor = subject;
+  }, [canvas, hasGraph, subject, measuredAll, ids.length]);
+  useLayoutEffect(fitFirst);
+  useEffect(() => {
+    const element = viewport.current;
+    if (!element) return;
+    // A board laid out later (a hidden panel shown) is fitted once it has a size.
+    const observer = new ResizeObserver(() => fitFirst());
+    observer.observe(element);
+    return () => observer.disconnect();
+  }, [fitFirst]);
+
+  // An axiom dragged here from the column is refused (AR-6: "Draw an arrow into it to make it a proposition").
+  useEffect(() => {
+    const element = viewport.current;
+    if (!element) return;
+    return dropTargetForElements({
+      element,
+      getData: () => columnTargetData('PROPOSITION'),
+      // Slice 1f (ES-9): no drop lands while an edit session (a run) is active.
+      canDrop: ({ source }) => isCardDragData(source.data) && editLock(store.getState()) === null,
+    });
+  }, [store]);
+
+  const setViewport = useCallback(
+    (element: HTMLDivElement | null) => {
+      viewport.current = element;
+      // The view writes its transform on the viewport from the start (before any layout effect needs it).
+      if (element) canvas.attach(element);
+      else canvas.detach();
+      refs.viewport(element);
+    },
+    [canvas, refs],
+  );
+  const setLayer = useCallback(
+    (element: HTMLDivElement | null) => {
+      layer.current = element;
+      refs.layer(element);
+    },
+    [refs],
+  );
+
+  return (
+    <div
+      ref={setViewport}
+      className="tl-canvas"
+      data-canvas="true"
+      data-drop={dragFrom === null ? undefined : dropActive ? 'active' : 'candidate'}
+      tabIndex={0}
+      role="region"
+      aria-roledescription="canvas"
+      aria-label="Propositions: the mouse wheel zooms, right-drag pans; with the canvas focused, + and − zoom, 0 shows all, the arrow keys pan"
+      aria-keyshortcuts="+ - 0 ArrowLeft ArrowRight ArrowUp ArrowDown"
+    >
+      <div ref={setLayer} className="tl-canvas__layer" role="list" aria-label="Propositions">
+        {sorted.map((id) => {
+          const p = placed[id];
+          return p ? <CanvasSlot key={id} id={id} x={p.x} y={p.y} expanded={expanded[id] === true} /> : null;
+        })}
+      </div>
+      {hasGraph && ids.length === 0 ? (
+        <p className="tl-canvas__empty" data-testid="canvas-empty">
+          No propositions yet: add one in the box below (choose Proposition), or right-click here and choose “New proposition here”.
+        </p>
+      ) : null}
+      {dragFrom === 'AXIOM' && dragId !== null ? <DropZone kind="PROPOSITION" id={dragId} active={dropActive} /> : null}
+      <CanvasToolbar canvas={canvas} />
+      {CANVAS_SIDES.map((side) => (
+        // Filled by the edge engine; React never renders children here.
+        <span key={side} ref={refs.slots[side]} className="tl-canvas__badge-slot" data-side={side} />
+      ))}
+    </div>
+  );
+}
