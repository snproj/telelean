+++ b/packages/runner/test/workspace/arrows.test.ts
@@ -0,0 +1,132 @@
+/**
+ * Spec v4 slice 1b with the real core: arrows as board edits on a scratch copy of mental_model/ in a scratch git
+ * repository (Lean off). Each action is planned in core and applied, recorded and undone by the workspace like every
+ * other board edit: one Undo step each, restoring the files exactly, and one History entry under its own action kind
+ * (move-cards is layout only, like reorder: undoable, but not snapshotted on its own). A refusal changes nothing.
+ * Slice 1f: remove-arrows also takes the "follows from nothing" marks of the same Delete, as one step.
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+
+import { createModelWorkspace, fsEditApplier, fsTextSource, type ModelWorkspace } from '../../src/workspace/index.js';
+import { cleanup, copyMentalModel, makeTempDir, read, snapshotTree, userGit } from './helpers.js';
+
+const MAIN = 'Model/Spyro/Main.lean';
+const LAYOUT = '.telelean/subjects/Spyro/layout.json';
+const GOAL = 'cynder-not-good';
+
+describe('arrows as board edits with the real core (slice 1b)', () => {
+  let tmp: string;
+  let root: string;
+  let ws: ModelWorkspace;
+  let original: Record<string, string>;
+  beforeAll(async () => {
+    tmp = makeTempDir('arrows');
+    root = copyMentalModel(tmp);
+    userGit(root, 'init', '-q');
+    ws = createModelWorkspace({ root, text: fsTextSource(root), applier: fsEditApplier(root), semantic: { enabled: false }, now: () => new Date('2026-11-19T10:00:00Z') });
+    await ws.load();
+    original = snapshotTree(root);
+  });
+  afterAll(() => {
+    ws?.dispose();
+    cleanup(tmp);
+  });
+
+  const node = (id: string) => ws.graph('Spyro').nodes.find((n) => n.id === id);
+  const undoExactly = async () => {
+    const before = snapshotTree(root);
+    const undo = await ws.undo('Spyro');
+    expect(undo.ok, JSON.stringify(undo)).toBe(true);
+    return before;
+  };
+
+  it('remove-arrows, then add-arrows: each one step, undone exactly', async () => {
+    const removed = await ws.perform({ kind: 'remove-arrows', arrows: [{ source: 'pg-no-dark-past', target: GOAL }] });
+    expect(removed, JSON.stringify(removed)).toMatchObject({ ok: true, undoable: true });
+    expect(removed.ok && removed.label).toMatch(/^Remove arrow: PG games cannot have characters with .*→ Cynder would not be a good addition/);
+    expect(read(root, MAIN)).toContain('premises: cynder-dark-past, new-spyro-pg\n');
+    expect(node(GOAL)?.premises).toEqual(['cynder-dark-past', 'new-spyro-pg']);
+    expect((await ws.workspaceState('Spyro')).undo).toBe(removed.ok ? removed.label : '');
+
+    const added = await ws.perform({ kind: 'add-arrows', target: GOAL, sources: ['pg-no-dark-past'] });
+    expect(added, JSON.stringify(added)).toMatchObject({ ok: true });
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+
+    await undoExactly();
+    expect(read(root, MAIN)).toContain('premises: cynder-dark-past, new-spyro-pg\n');
+    await undoExactly();
+    expect(snapshotTree(root)[MAIN]).toBe(original[MAIN]);
+  });
+
+  it('set-from-nothing on an axiom makes it a proposition (type and layout in one step); undo restores both', async () => {
+    const outcome = await ws.perform({ kind: 'set-from-nothing', id: 'new-spyro-pg', on: true });
+    expect(outcome, JSON.stringify(outcome)).toMatchObject({ ok: true, label: 'Follows from nothing: The new Spyro game is PG' });
+    expect(read(root, MAIN)).toContain('id: new-spyro-pg\ntype: PROPOSITION\nnatural_name: The new Spyro game is PG\nrationale: known from gaming news\nsource: reported\nfollows_from: nothing\n');
+    expect(node('new-spyro-pg')).toMatchObject({ type: 'PROPOSITION', fromNothing: true });
+    expect(JSON.parse(read(root, LAYOUT)).columns.PROPOSITION).toContain('new-spyro-pg');
+    await undoExactly();
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+    expect(read(root, LAYOUT)).toBe(original[LAYOUT]);
+    expect(node('new-spyro-pg')?.type).toBe('AXIOM');
+  });
+
+  it('claim-pending adds the axiom .holds ("Mark pending"); undo removes it', async () => {
+    const outcome = await ws.perform({ kind: 'claim-pending', id: GOAL });
+    expect(outcome, JSON.stringify(outcome)).toMatchObject({ ok: true, label: 'Mark pending: Cynder would not be a good addition to the new Spyro game' });
+    expect(read(root, MAIN)).toContain('abbrev cynder_not_good : Prop := ¬ GoodAddition cynder newSpyro\naxiom cynder_not_good.holds : cynder_not_good\n');
+    await undoExactly();
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+  });
+
+  it('move-cards writes only the layout (one Undo step, no snapshot of its own)', async () => {
+    const outcome = await ws.perform({ kind: 'move-cards', positions: { [GOAL]: { x: 120, y: -40 } } });
+    expect(outcome, JSON.stringify(outcome)).toMatchObject({ ok: true, label: 'Move: Cynder would not be a good addition to the new Spyro game', undoable: true });
+    expect(JSON.parse(read(root, LAYOUT)).positions).toEqual({ [GOAL]: { x: 120, y: -40 } });
+    expect(ws.graph('Spyro').positions).toEqual({ [GOAL]: { x: 120, y: -40 } });
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+    await undoExactly();
+    expect(read(root, LAYOUT)).toBe(original[LAYOUT]);
+    expect(ws.graph('Spyro')).not.toHaveProperty('positions');
+  });
+
+  it('a refusal (a cycle) changes nothing and records nothing', async () => {
+    const before = snapshotTree(root);
+    const undoBefore = (await ws.workspaceState('Spyro')).undo;
+    const outcome = await ws.perform({ kind: 'add-arrows', target: 'pg-no-dark-past', sources: [GOAL] });
+    expect(outcome).toEqual({
+      ok: false,
+      code: 'invalid',
+      error: 'This arrow would make a cycle: Cynder would not be a good addition to … → PG games cannot have characters with da… → Cynder would not be a good addition to ….',
+    });
+    expect(snapshotTree(root)).toEqual(before);
+    expect((await ws.workspaceState('Spyro')).undo).toBe(undoBefore);
+  });
+
+  it('slice 1f (carry-over 2): one Delete of an arrow and a "follows from nothing" mark is one step, undone exactly', async () => {
+    const marked = await ws.perform({ kind: 'set-from-nothing', id: 'new-spyro-pg', on: true });
+    expect(marked, JSON.stringify(marked)).toMatchObject({ ok: true });
+    const afterMark = snapshotTree(root);
+    const removed = await ws.perform({ kind: 'remove-arrows', arrows: [{ source: 'pg-no-dark-past', target: GOAL }], marks: ['new-spyro-pg'] });
+    expect(removed, JSON.stringify(removed)).toMatchObject({ ok: true, undoable: true, label: "Remove 1 arrow and 1 'follows from nothing' mark" });
+    expect(read(root, MAIN)).toContain('premises: cynder-dark-past, new-spyro-pg\n');
+    expect(read(root, MAIN)).not.toContain('follows_from:');
+    expect(node('new-spyro-pg')?.fromNothing).toBeUndefined();
+    // One Undo takes back both.
+    await undoExactly();
+    expect(snapshotTree(root)).toEqual(afterMark);
+    expect(node('new-spyro-pg')).toMatchObject({ type: 'PROPOSITION', fromNothing: true });
+    expect(node(GOAL)?.premises).toEqual(['cynder-dark-past', 'new-spyro-pg', 'pg-no-dark-past']);
+    await undoExactly();
+    expect(read(root, MAIN)).toBe(original[MAIN]);
+    expect(read(root, LAYOUT)).toBe(original[LAYOUT]);
+  });
+
+  it('records each action in the history under its own kind', async () => {
+    const listing = await ws.listHistory('Spyro');
+    const actions = listing.entries.map((e) => e.action);
+    for (const kind of ['remove-arrows', 'add-arrows', 'set-from-nothing', 'claim-pending'] as const) expect(actions, kind).toContain(kind);
+    expect(actions).not.toContain('move-cards');
+    expect(actions).not.toContain('manual');
+    expect(listing.entries.find((e) => e.action === 'claim-pending')?.label).toBe('Mark pending: Cynder would not be a good addition to the new Spyro game');
+  });
+});
diff --git a/packages/webview/src/board/AlsoAssumed.tsx b/packages/webview/src/board/AlsoAssumed.tsx
new file mode 100644
index 0000000..3f6ca59
--- /dev/null
+++ b/packages/webview/src/board/AlsoAssumed.tsx
@@ -0,0 +1,79 @@
+/**
+ * The AXIOMS column header's second line (spec v4 BD-1, slice 1c): "also assumed: K pending claims, N existence
+ * assumptions, M hidden assumptions". Each part links to its cards or Vocabulary items: one item is shown at once
+ * (the card is revealed, the item highlighted in the Vocabulary column), several open a menu to choose from.
+ */
+import { Fragment, useMemo, useState } from 'react';
+import { Popover } from '../common/Popover';
+import { displayName, presuppositionLabel } from '../model/cardData';
+import { useBoard, useBoardActions } from '../state/context';
+import { boardView, proposedOverlay } from '../state/store';
+import { alsoAssumed, alsoAssumedParts, type AssumedKind } from './assumed';
+
+const TITLE: Readonly<Record<AssumedKind, string>> = {
+  pending: 'Propositions pending proof: their `.holds` is a Lean axiom, assumed until a run proves it',
+  existence: 'Presuppositions: Lean assumes these kinds of things exist (in the Vocabulary column)',
+  hidden: 'Prop-valued Lean axioms with no card (TL104): Lean takes them as given (in the Vocabulary column)',
+};
+
+export function AlsoAssumedLine() {
+  const nodes = useBoard((s) => boardView(s).nodes);
+  const order = useBoard((s) => boardView(s).order);
+  const vocabulary = useBoard((s) => boardView(s).vocabulary);
+  const vocab = useBoard((s) => boardView(s).vocab);
+  const subject = useBoard((s) => s.subject);
+  // RV-6 (1d fixer): in the Proposed view, a hidden result counts as on the Current board until the review reveals it.
+  const hidden = useBoard((s) => proposedOverlay(s)?.hidden);
+  const current = useBoard((s) => s.nodes);
+  const actions = useBoardActions();
+  const [open, setOpen] = useState<{ kind: AssumedKind; anchor: HTMLElement } | null>(null);
+  const assumed = useMemo(
+    () => alsoAssumed({ nodes, order, vocabulary }, hidden && hidden.size > 0 ? { hidden, current } : undefined),
+    [nodes, order, vocabulary, hidden, current],
+  );
+  const parts = alsoAssumedParts(assumed);
+  if (parts.length === 0) return null;
+
+  const choose = (kind: AssumedKind, key: string) => {
+    setOpen(null);
+    if (kind === 'pending') actions.revealNode(key);
+    else actions.highlightVocab(key);
+  };
+  const label = (kind: AssumedKind, key: string) =>
+    kind === 'pending' ? (nodes[key]?.naturalName ?? key) : kind === 'existence' ? presuppositionLabel(key, subject, vocab) : displayName(key, subject, vocab);
+
+  return (
+    <div className="tl-col__assumed" data-testid="also-assumed">
+      <span className="tl-col__assumed-label">also assumed:</span>
+      {parts.map((part, i) => (
+        <Fragment key={part.kind}>
+          {i > 0 ? <span aria-hidden="true">,</span> : null}
+          <button
+            type="button"
+            className="tl-link"
+            data-assumed={part.kind}
+            aria-haspopup={part.count > 1 ? 'menu' : undefined}
+            aria-expanded={part.count > 1 ? open?.kind === part.kind : undefined}
+            title={TITLE[part.kind].replace(/`/g, '')}
+            onClick={(event) => {
+              const first = assumed[part.kind][0];
+              if (part.count === 1 && first !== undefined) choose(part.kind, first);
+              else setOpen(open?.kind === part.kind ? null : { kind: part.kind, anchor: event.currentTarget });
+            }}
+          >
+            {part.text}
+          </button>
+        </Fragment>
+      ))}
+      <Popover anchor={open?.anchor ?? null} open={open !== null} onClose={() => setOpen(null)} role="menu" label="Also assumed" testId="assumed-menu" className="tl-menu">
+        {open
+          ? assumed[open.kind].map((key) => (
+              <button key={key} type="button" role="menuitem" className="tl-menu__item" data-assumed-item={key} onClick={() => choose(open.kind, key)}>
+                <span className="tl-menu__text">{label(open.kind, key)}</span>
+              </button>
+            ))
+          : null}
+      </Popover>
+    </div>
+  );
+}
diff --git a/packages/webview/src/board/AxiomsColumn.tsx b/packages/webview/src/board/AxiomsColumn.tsx
new file mode 100644
index 0000000..10bbab7
--- /dev/null
+++ b/packages/webview/src/board/AxiomsColumn.tsx
@@ -0,0 +1,110 @@
+/**
+ * The AXIOMS column (spec v4 BD-1, BD-2; slice 1c): the axiom cards in the user's order, scrolling on its own, left of
+ * the PROPOSITIONS canvas. Re-order by dragging within the column (pragmatic-drag-and-drop) or Alt+↑/↓. Its header
+ * counts the axioms and, on a second line, what is assumed outside the column (pending claims, existence and hidden
+ * assumptions), each linked to its card or Vocabulary item. In the Proposed view, Claude's suggested premises ("Claude
+ * suggests") wait at the top of the column. The edge engine owns the "▲ / ▼ n linked" buttons in the header and footer.
+ *
+ * Spec v4 AR-7 (slice 1c2): while a proposition moved on the canvas is over the column (the store's `overAxioms`), the
+ * column is the active drop zone and states what the drop does ("Drop to move to axioms", with kindChangeImpact's
+ * impact); a release there runs "Move to axioms" (BoardInput). Several moved cards are refused: one at a time.
+ */
+import { dropTargetForElements } from '@atlaskit/pragmatic-drag-and-drop/adapter/element-adapter';
+import { combine } from '@atlaskit/pragmatic-drag-and-drop/utils/combine';
+import { autoScrollForElements } from '@atlaskit/pragmatic-drag-and-drop-auto-scroll/element';
+import { useCallback, useEffect, useRef } from 'react';
+import { COLUMN_TITLE, KIND_GLYPH } from '../labels';
+import { useBoard, useBoardStore } from '../state/context';
+import { boardView, editLock } from '../state/store';
+import { AlsoAssumedLine } from './AlsoAssumed';
+import { columnTargetData, isCardDragData } from './dnd';
+import { DropZone } from './DropZone';
+import { columnDropCue, SEVERAL_TO_AXIOMS } from './gestures';
+import { GhostCards } from './GhostCards';
+import { NodeCard } from './NodeCard';
+
+/** Elements the board needs from the column: the section (pointer handling), the scrolling list and the badge slots. */
+export interface AxiomsColumnRefs {
+  section: (element: HTMLElement | null) => void;
+  list: (element: HTMLDivElement | null) => void;
+  /** In the header: the engine puts "▲ n linked" here. */
+  up: (element: HTMLSpanElement | null) => void;
+  /** In the footer: the engine puts "▼ n linked" here. */
+  down: (element: HTMLSpanElement | null) => void;
+}
+
+const KIND = 'AXIOM';
+
+export function AxiomsColumn({ refs }: { refs: AxiomsColumnRefs }) {
+  const ids = useBoard((s) => boardView(s).order.AXIOM);
+  const dragFrom = useBoard((s) => s.drag?.from ?? null);
+  const dragId = useBoard((s) => s.drag?.id ?? null);
+  const active = useBoard((s) => s.dropKind === KIND);
+  /** Slice 1c2: propositions moved on the canvas are over the column. */
+  const moved = useBoard((s) => s.overAxioms);
+  /** A board without any card: the column points to the A|P box below. */
+  const firstStep = useBoard((s) => s.version !== null && Object.keys(boardView(s).nodes).length === 0);
+  const list = useRef<HTMLDivElement | null>(null);
+  const store = useBoardStore();
+
+  useEffect(() => {
+    const element = list.current;
+    if (!element) return;
+    return combine(
+      // Slice 1f (ES-9): no drop lands while an edit session (a run) is active.
+      dropTargetForElements({ element, getData: () => columnTargetData(KIND), canDrop: ({ source }) => isCardDragData(source.data) && editLock(store.getState()) === null }),
+      autoScrollForElements({ element, getAllowedAxis: () => 'vertical' }),
+    );
+  }, [store]);
+
+  const setList = useCallback(
+    (element: HTMLDivElement | null) => {
+      list.current = element;
+      refs.list(element);
+    },
+    [refs],
+  );
+
+  // During a drag: the column under the pointer is "active"; a drag from elsewhere makes it a labelled drop zone (D-17).
+  // A move from the canvas (slice 1c2) makes it the zone only while the pointer is over it; several moved cards are
+  // refused there, so the column shows the refusal, never the accepting cue (slice 1d carry-over).
+  const drop = columnDropCue({ moved, dragFrom, active, kind: KIND });
+  const changesKind = moved !== null || (drop !== undefined && dragFrom !== KIND);
+  const several = moved !== null && moved.count > 1;
+  const zoneId = moved?.id ?? dragId;
+  const empty = ids.length === 0;
+
+  return (
+    <section ref={refs.section} className="tl-col tl-axioms" data-kind={KIND} data-drop={drop} aria-labelledby="tl-col-title-AXIOM">
+      <header className="tl-col__header">
+        <span className="tl-glyph" data-kind={KIND} aria-hidden="true">
+          {KIND_GLYPH[KIND]}
+        </span>
+        <h2 className="tl-col__title" id="tl-col-title-AXIOM">
+          {COLUMN_TITLE[KIND]}
+        </h2>
+        <span className="tl-col__count">{ids.length}</span>
+        {changesKind ? <span className="tl-col__drop-label">{several ? SEVERAL_TO_AXIOMS.label : 'Drop to move to axioms'}</span> : null}
+        {/* Filled by the edge engine; React never renders children here. */}
+        <span ref={refs.up} className="tl-col__badge-slot" data-dir="up" />
+      </header>
+      <AlsoAssumedLine />
+      <div ref={setList} className="tl-col__list" data-kind={KIND} data-empty={empty || undefined} role="list" aria-label={COLUMN_TITLE[KIND]}>
+        {/* M2: Claude's suggested premises, translucent, first in the column: they wait for a decision (proposed view only). */}
+        <GhostCards />
+        {ids.map((id) => (
+          <NodeCard key={id} id={id} place="column" />
+        ))}
+        {empty ? (
+          <p className="tl-col__empty">
+            No axioms yet{firstStep ? <span className="tl-col__first-step">: type your first one in the box below</span> : null}
+          </p>
+        ) : null}
+      </div>
+      {changesKind && zoneId !== null ? <DropZone kind={KIND} id={zoneId} active={moved !== null || active} several={several} /> : null}
+      <footer className="tl-col__footer">
+        <span ref={refs.down} className="tl-col__badge-slot" data-dir="down" />
+      </footer>
+    </section>
+  );
+}
diff --git a/packages/webview/src/board/BoardInput.ts b/packages/webview/src/board/BoardInput.ts
new file mode 100644
index 0000000..bf31aef
--- /dev/null
+++ b/packages/webview/src/board/BoardInput.ts
@@ -0,0 +1,816 @@
+/**
+ * The board's pointer, wheel and keyboard handling for the canvas (spec v4 BD-3, CM-7, A21; slice 1c) and its arrow
+ * gestures (AR-1, AR-6, AR-7, CM-2; slice 1c2). Attached to the board element, an ancestor of both the cards and the
+ * arrow overlay, so a wheel or a press over an arrow reaches it too. Pointer events only (no new dependency);
+ * pragmatic-drag-and-drop keeps the AXIOMS column's re-order. The rules live in board/gestures.ts (pure, unit-tested).
+ *
+ * - Wheel over the canvas: zoom about the cursor (Ctrl+wheel, a trackpad pinch, zooms faster). Over the column: its
+ *   own scrolling.
+ * - Right button: a press on the canvas captures the pointer; moving CLICK_SLOP px or more pans (and the press is then
+ *   only a pan: no selection change, no menu, A21). A release before that opens the right-click menu at the pointer
+ *   for the card, arrow, mark or empty canvas under it (CM-7), on the canvas or in the column. The native context menu
+ *   is suppressed on the board, except over a text field or selected text (VS Code's Cut/Copy/Paste stay there).
+ * - Arrows (slice 1c2): each drawn arrow, and each arrow a proof uses without a declaration, has a wide transparent hit
+ *   path (the EdgeEngine's); so has each ∅ stub. Over the AXIOMS column the list lies above the overlay, so there the
+ *   arrow near the pointer is found by distance (`EdgeEngine.hitTestColumn`). Hovering one gives it the hover look; a
+ *   click selects a drawn arrow or a mark (Ctrl/Cmd adds; CM-2); an undeclared arrow (TL107) only has its right-click
+ *   menu ("Draw this arrow"); a mention (lean-ref) takes no pointer at all.
+ * - Left press on empty canvas (or on an arrow there): a click selects the arrow or mark, or on empty canvas clears the
+ *   selection (Ctrl/Cmd: keeps it); a drag draws the selection rectangle, which selects the canvas cards, drawn arrows
+ *   and marks wholly inside it (Ctrl/Cmd adds them).
+ * - Left drag on a proposition card moves it (with the other selected cards when it is selected); the release stores
+ *   the new positions, one Undo step (`moveCards`). Released over the AXIOMS column, one card runs "Move to axioms"
+ *   (its impact dialog, AR-7) instead of moving, and several are refused; while the cards are over the column, it says
+ *   what a drop does (the store's `overAxioms`). (An axiom dragged from the column onto the canvas is pragmatic-dnd's:
+ *   the canvas's drop zone refuses it, AR-6.)
+ * - Left drag from a card's handle (at its right edge, shown on hover) draws a rubber-band arrow that follows the
+ *   pointer across the column and the canvas, and follows scrolling, panning and zooming. Over a card, the hint next
+ *   to the pointer says what a release does (AR-6: the impact, when it is an axiom; AR-3: a cycle); a release there
+ *   calls `addArrows(target, [source])` (into an axiom, 1b's impact dialog first); elsewhere it cancels, and so does Esc.
+ * - Escape during a drag (a move, a draw, a rectangle) cancels it, and nothing else happens.
+ * - While an edit session is active (ES-9) drawing and moving are off (the handles are not there); selecting and the
+ *   menus stay. The Proposed view selects nothing and changes nothing (`gestureGateOf`).
+ * - Keyboard, with the canvas (or a card on it) focused: + / − zoom about the centre, 0 is Fit all; with the canvas
+ *   itself focused the arrow keys pan. A card focused from the keyboard (Tab) is brought into view.
+ */
+import { gestureGateOf, impactOf, type BoardStore } from '../state/store';
+import { isTextEntry } from '../model/format';
+import { NO_DRAG_SELECTOR } from './dragGuard';
+import type { CanvasView } from './canvas/CanvasView';
+import { PressTracker } from './canvas/gesture';
+import { KEY_PAN, wheelFactor, type Point } from './canvas/view';
+import type { EdgeEngine } from './EdgeEngine';
+import {
+  areaSelection,
+  canvasDropOutcome,
+  clickOutcome,
+  clipRect,
+  columnDropBefore,
+  drawHint,
+  drawRelease,
+  drawTarget,
+  hitThing,
+  rectBetween,
+  rubberBandPath,
+  type DrawHint,
+  type DrawTarget,
+  type Hit,
+} from './gestures';
+import type { MenuThing } from './menu';
+
+export interface MenuRequest {
+  /** Client coordinates of the pointer. */
+  x: number;
+  y: number;
+  thing: MenuThing;
+  /** Where the focus goes back when the menu closes. */
+  returnFocus: HTMLElement | null;
+}
+
+/** Slice 1c2: what a gesture draws while it lasts, in an overlay above both parts that never takes the pointer. */
+export interface BoardDraft {
+  svg: SVGSVGElement;
+  /** The selection rectangle. */
+  area: SVGRectElement;
+  /** The rubber-band arrow. */
+  arrow: SVGPathElement;
+  /** The words next to the pointer while an arrow is drawn. */
+  hint: HTMLElement;
+}
+
+export interface BoardInputOptions {
+  board: HTMLElement;
+  /** The AXIOMS column (header, list and footer). */
+  column: HTMLElement;
+  /** The column's scrolling list (a press on its scrollbar is never a click on an arrow). */
+  list: HTMLElement;
+  viewport: HTMLElement;
+  canvas: CanvasView;
+  store: BoardStore;
+  engine: EdgeEngine;
+  openMenu: (request: MenuRequest) => void;
+  draft: BoardDraft;
+}
+
+/** A card slot on the canvas (PropositionCanvas renders one per proposition). */
+export const SLOT_SELECTOR = '[data-slot-id]';
+
+/** Sets a slot's position (canvas coordinates) through the CSSOM, touching it only when it changed. */
+export function placeSlot(slot: HTMLElement, x: number, y: number): void {
+  const px = `${Math.round(x * 100) / 100}px`;
+  const py = `${Math.round(y * 100) / 100}px`;
+  if (slot.style.getPropertyValue('--tl-x') !== px) slot.style.setProperty('--tl-x', px);
+  if (slot.style.getPropertyValue('--tl-y') !== py) slot.style.setProperty('--tl-y', py);
+}
+
+/** Whether the pointer is over a text field or over selected text (where VS Code's own menu stays, CM-7). */
+export function textContextAt(target: EventTarget | null, x: number, y: number): boolean {
+  if (isTextEntry(target)) return true;
+  const selection = document.getSelection();
+  if (!selection || selection.isCollapsed || selection.rangeCount === 0) return false;
+  for (let i = 0; i < selection.rangeCount; i++) {
+    for (const r of selection.getRangeAt(i).getClientRects()) if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return true;
+  }
+  return false;
+}
+
+interface RightPress {
+  kind: 'right';
+  pointerId: number;
+  tracker: PressTracker;
+  /** The press started on the canvas: a drag pans. */
+  pan: boolean;
+  thing: MenuThing | null;
+  returnFocus: HTMLElement | null;
+}
+
+interface MovePress {
+  kind: 'move';
+  pointerId: number;
+  tracker: PressTracker;
+  /** The cards that move, with where they were. */
+  cards: Array<{ id: string; slot: HTMLElement; from: Point }>;
+  /** The card pressed (its focus is given back after the move). */
+  id: string;
+  /** The pointer is over the AXIOMS column (AR-7: a release there is "Move to axioms"). */
+  overColumn: boolean;
+}
+
+interface DrawPress {
+  kind: 'draw';
+  pointerId: number;
+  tracker: PressTracker;
+  /** The card the arrow starts from, and its element. */
+  source: string;
+  sourceCard: HTMLElement;
+  /** The pointer (client coordinates), kept to redraw after a pan, a zoom or a scroll. */
+  at: Point;
+  /** Where the rubber band starts (board space); the last one is kept while the source is out of view. */
+  from: Point | null;
+  /** What a release here does, and the card it is about (marked `data-draw-target`). */
+  target: DrawTarget;
+  over: HTMLElement | null;
+}
+
+interface AreaPress {
+  kind: 'area';
+  pointerId: number;
+  tracker: PressTracker;
+  /** Ctrl/Cmd at the press: the selection grows instead of being replaced. */
+  additive: boolean;
+  /** What the press began on: an arrow or a mark (a click selects it), or nothing (a click clears the selection). */
+  hit: Hit | null;
+  /** A drag draws the selection rectangle (a press on the canvas); in the column a press only clicks an arrow. */
+  rectangle: boolean;
+  /** A menu was open at the press: a click on empty canvas only closes it (CM-2), it does not clear the selection. */
+  closes: boolean;
+}
+
+type Press = RightPress | MovePress | DrawPress | AreaPress;
+
+export function attachBoardInput(o: BoardInputOptions): () => void {
+  const { board, column, list, viewport, canvas, store, engine, draft } = o;
+  let press: Press | null = null;
+  let suppressClick = false;
+  /** The last input was a key (Tab): a card that gets the focus is brought into view. */
+  let fromKeyboard = false;
+  /** When the right button last went down or up: a `contextmenu` event soon after comes from the mouse. */
+  let lastRightButton = -Infinity;
+  /** The draw hint's words now (they are rebuilt only when they change). */
+  let hintKey = '';
+  /**
+   * A popover (a menu) was open when the current press began. Read in the capture phase, before the popover's own
+   * listener closes it (and React may remove it before the board's listener runs).
+   */
+  let popoverAtPress = false;
+
+  const gate = () => gestureGateOf(store.getState());
+
+  const inViewport = (x: number, y: number) => {
+    const r = viewport.getBoundingClientRect();
+    return x >= r.left && x < r.right && y >= r.top && y < r.bottom;
+  };
+
+  const inColumn = (x: number, y: number) => {
+    const r = column.getBoundingClientRect();
+    return x >= r.left && x < r.right && y >= r.top && y < r.bottom;
+  };
+
+  /** Controls drawn over the canvas (its toolbar, the "n linked" badges): never a pan, a move or a menu. */
+  const onControl = (target: Element) => target.closest('.tl-canvas__tools, .tl-badge, .tl-canvas__badge-slot') !== null;
+
+  /** A card, or a suggestion of Claude's in the column (they take the pointer themselves; no arrow is found under them). */
+  const onItem = (target: Element) => target.closest('[data-node-id], [data-ghost-id]') !== null;
+
+  /** A press on the column list's own scrollbar. */
+  const onScrollbar = (target: Element, x: number) => {
+    if (target !== list) return false;
+    const r = list.getBoundingClientRect();
+    return x >= r.left + list.clientLeft + list.clientWidth;
+  };
+
+  /**
+   * The arrow or ∅ stub under the pointer: its hit path on the canvas; over the column's background, the arrow nearest
+   * the pointer (the list lies above the overlay there). Null over a card, a control or nothing.
+   */
+  const hitAt = (target: Element, x: number, y: number): Hit | null => {
+    const mark = target.closest<SVGElement>('[data-mark-id]');
+    if (mark?.dataset.markId && board.contains(mark)) return { kind: 'mark', id: mark.dataset.markId };
+    const path = target.closest<SVGPathElement>('path[data-hit-edge]');
+    if (path) {
+      const { hitEdge, source, target: into, hit } = path.dataset;
+      if (hitEdge && source && into && (hit === 'drawn' || hit === 'undeclared')) return { kind: 'arrow', id: hitEdge, source, target: into, role: hit };
+      return null;
+    }
+    if (!column.contains(target) || onItem(target) || target.closest(NO_DRAG_SELECTOR) || onScrollbar(target, x)) return null;
+    const found = engine.hitTestColumn(engine.toBoard(x, y));
+    return found ? { kind: 'arrow', id: found.id, source: found.source, target: found.target, role: found.role } : null;
+  };
+
+  /** The card, drawn arrow, mark or empty canvas under the pointer, or null (the column's background, a control). */
+  const thingAt = (target: Element, x: number, y: number): { thing: MenuThing; focus: HTMLElement | null } | null => {
+    if (onControl(target)) return null;
+    const card = target.closest<HTMLElement>('[data-node-id]');
