+    const blocks = [...a.blocks].sort().map((card) => {
+      const block = i.current.nodes.get(card)?.block;
+      return { card, fields: block ? [...fieldEntries(block)].sort(([x], [y]) => (x < y ? -1 : 1)) : [] };
