+    }
+    for (const n of provided) mentions.delete(n);
+    const arrows = [...new Map(a.arrows.map((x) => [`${x.source}>${x.target}`, x])).values()].sort((x, y) =>
+      `${x.source}>${x.target}` < `${y.source}>${y.target}` ? -1 : 1,
+    );
