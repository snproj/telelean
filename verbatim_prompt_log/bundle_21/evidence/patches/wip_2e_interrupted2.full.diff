+    const rest = ['four', 'five', 'six', 'seven'].map((n) => def(n)).join('\n');
+    const three: Texts = { ...BASE, [EXTRA]: `${def('zero')}\n\n${def('one', '  ')}\n${def('two', ' ')}\n${def('three')}\n\n${rest}\n` };
