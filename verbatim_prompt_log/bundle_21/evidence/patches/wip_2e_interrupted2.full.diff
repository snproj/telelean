+function strip(graph: TlGraph): unknown {
+  return {
+    ...graph,
+    nodes: graph.nodes.map((n) => {
+      const { loc: _loc, ...rest } = n;
+      void _loc;
+      const { codeLoc: _codeLoc, ...lean } = n.lean;
